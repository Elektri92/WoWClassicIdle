@* Instance decoration behind the combat frames, replaces the outdoor silhouettes (css/dungeon-scenery.css) *@
@switch (Theme)
{
    case "wailing":
        <img class="ds-layer ds-cave" src="images/dungeons/wailing-cave.svg" alt="" />
        <img class="ds-layer ds-floor wc-floor" src="images/dungeons/wailing-floor.svg" alt="" />
        <img class="wc-mushrooms left" src="images/dungeons/wailing-mushrooms-left.svg" alt="" />
        <img class="wc-mushrooms right" src="images/dungeons/wailing-mushrooms-right.svg" alt="" />
        <span class="wc-spore" style="--x:12%;--d:0s;--t:9s"></span>
        <span class="wc-spore" style="--x:29%;--d:-5s;--t:12s"></span>
        <span class="wc-spore" style="--x:46%;--d:-2s;--t:10s"></span>
        <span class="wc-spore" style="--x:58%;--d:-8s;--t:13s"></span>
        <span class="wc-spore" style="--x:73%;--d:-4s;--t:9s"></span>
        <span class="wc-spore" style="--x:90%;--d:-7s;--t:11s"></span>
        <img class="wc-vine" src="images/dungeons/wailing-vine-a.svg" alt="" style="--x:1%;--h:88%;--d:-1s;--t:8s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-c.svg" alt="" style="--x:8%;--h:42%;--d:-4s;--t:6s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-b.svg" alt="" style="--x:17%;--h:60%;--d:-6s;--t:9s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-c.svg" alt="" style="--x:31%;--h:34%;--d:-2s;--t:7s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-b.svg" alt="" style="--x:42%;--h:52%;--d:-5s;--t:8s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-a.svg" alt="" style="--x:51%;--h:74%;--d:-3s;--t:10s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-c.svg" alt="" style="--x:62%;--h:38%;--d:-7s;--t:6s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-b.svg" alt="" style="--x:74%;--h:64%;--d:-1s;--t:9s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-c.svg" alt="" style="--x:85%;--h:46%;--d:-4s;--t:7s" />
        <img class="wc-vine" src="images/dungeons/wailing-vine-a.svg" alt="" style="--x:92%;--h:92%;--d:-6s;--t:11s" />
        <img class="ds-layer wc-ceiling" src="images/dungeons/wailing-ceiling.svg" alt="" />
        break;

    case "deadmines":
        <img class="ds-layer ds-cave" src="images/dungeons/deadmines-cave.svg" alt="" />
        <span class="dm-water"></span>
        <img class="dm-ship" src="images/dungeons/deadmines-ship.svg" alt="" />
        <img class="ds-layer ds-floor dm-dock" src="images/dungeons/deadmines-dock.svg" alt="" />
        <img class="dm-prop dm-cargo" src="images/dungeons/deadmines-cargo.svg" alt="" />
        <img class="dm-prop dm-chest" src="images/dungeons/deadmines-chest.svg" alt="" />
        <img class="dm-prop dm-cannon" src="images/dungeons/deadmines-cannon.svg" alt="" />
        <img class="dm-post left" src="images/dungeons/deadmines-post.svg" alt="" />
        <img class="dm-post right" src="images/dungeons/deadmines-post.svg" alt="" />
        <img class="ds-layer dm-beam" src="images/dungeons/deadmines-beam.svg" alt="" />
        <img class="dm-banner" src="images/dungeons/deadmines-banner.svg" alt="" />
        <span class="dm-lantern" style="--x:64%;--d:0s"><span class="dm-lantern-glow"></span><img src="images/dungeons/deadmines-lantern.svg" alt="" /></span>
        <span class="dm-lantern" style="--x:84%;--d:-1.3s"><span class="dm-lantern-glow"></span><img src="images/dungeons/deadmines-lantern.svg" alt="" /></span>
        break;

    case "shadowfang":
        <img class="ds-layer ds-cave" src="images/dungeons/shadowfang-hall.svg" alt="" />
        <img class="sk-window" src="images/dungeons/shadowfang-window.svg" alt="" style="--x:14%" />
        <img class="sk-window" src="images/dungeons/shadowfang-window.svg" alt="" style="--x:66%" />
        <span class="sk-moonbeam" style="--x:14%;--d:0s"></span>
        <span class="sk-moonbeam" style="--x:66%;--d:-4s"></span>
        <img class="ds-layer ds-floor sk-floor" src="images/dungeons/shadowfang-floor.svg" alt="" />
        <span class="sk-mist" style="--d:0s;--t:26s"></span>
        <span class="sk-mist far" style="--d:-13s;--t:34s"></span>
        <img class="sk-banner" src="images/dungeons/shadowfang-banner.svg" alt="" style="--x:3%;--d:0s" />
        <img class="sk-banner" src="images/dungeons/shadowfang-banner.svg" alt="" style="--x:88%;--d:-3s" />
        <img class="sk-cage" src="images/dungeons/shadowfang-cage.svg" alt="" style="--x:44%;--d:0s" />
        <img class="sk-cage" src="images/dungeons/shadowfang-cage.svg" alt="" style="--x:82%;--d:-2.6s" />
        <span class="sk-sconce" style="--x:30%;--d:0s"><span class="sk-sconce-glow"></span><img src="images/dungeons/shadowfang-sconce.svg" alt="" /></span>
        <span class="sk-sconce" style="--x:54%;--d:-1.4s"><span class="sk-sconce-glow"></span><img src="images/dungeons/shadowfang-sconce.svg" alt="" /></span>
        break;

    case "blackfathom":
        <img class="ds-layer ds-cave" src="images/dungeons/blackfathom-ruins.svg" alt="" />
        <span class="bf-caustics"></span>
        <img class="ds-layer ds-floor bf-floor" src="images/dungeons/blackfathom-floor.svg" alt="" />
        <img class="bf-pillar left" src="images/dungeons/blackfathom-pillar.svg" alt="" />
        <img class="bf-pillar right" src="images/dungeons/blackfathom-pillar.svg" alt="" />
        <img class="bf-kelp" src="images/dungeons/blackfathom-kelp-a.svg" alt="" style="--x:6%;--h:52%;--d:0s;--t:7s" />
        <img class="bf-kelp" src="images/dungeons/blackfathom-kelp-b.svg" alt="" style="--x:36%;--h:30%;--d:-3s;--t:6s" />
        <img class="bf-kelp" src="images/dungeons/blackfathom-kelp-b.svg" alt="" style="--x:58%;--h:26%;--d:-5s;--t:8s" />
        <img class="bf-kelp" src="images/dungeons/blackfathom-kelp-a.svg" alt="" style="--x:84%;--h:48%;--d:-2s;--t:9s" />
        <span class="bf-brazier" style="--x:28%;--d:0s"><span class="bf-brazier-glow"></span><img src="images/dungeons/blackfathom-brazier.svg" alt="" /></span>
        <span class="bf-brazier" style="--x:74%;--d:-1.5s"><span class="bf-brazier-glow"></span><img src="images/dungeons/blackfathom-brazier.svg" alt="" /></span>
        <span class="bf-bubble" style="--x:9%;--d:0s;--t:7s"></span>
        <span class="bf-bubble" style="--x:23%;--d:-3s;--t:9s"></span>
        <span class="bf-bubble" style="--x:41%;--d:-6s;--t:8s"></span>
        <span class="bf-bubble" style="--x:62%;--d:-1s;--t:10s"></span>
        <span class="bf-bubble" style="--x:79%;--d:-4s;--t:7s"></span>
        <span class="bf-bubble" style="--x:93%;--d:-7s;--t:9s"></span>
        break;

    case "razorfen":
        <img class="ds-layer ds-cave" src="images/dungeons/razorfen-cave.svg" alt="" />
        <img class="ds-layer ds-floor rk-floor" src="images/dungeons/razorfen-floor.svg" alt="" />
        <img class="rk-thorns left" src="images/dungeons/razorfen-thorns-left.svg" alt="" />
        <img class="rk-thorns right" src="images/dungeons/razorfen-thorns-right.svg" alt="" />
        <img class="rk-prop rk-bones" src="images/dungeons/razorfen-bones.svg" alt="" />
        <img class="rk-prop rk-totem" src="images/dungeons/razorfen-totem.svg" alt="" />
        <span class="rk-brazier" style="--x:30%;--d:0s"><span class="rk-fire-glow"></span><img src="images/dungeons/razorfen-brazier.svg" alt="" /></span>
        <span class="rk-brazier" style="--x:88%;--d:-1.7s"><span class="rk-fire-glow"></span><img src="images/dungeons/razorfen-brazier.svg" alt="" /></span>
        <span class="rk-ember" style="--x:31%;--d:0s;--t:5s"></span>
        <span class="rk-ember" style="--x:32%;--d:-2.4s;--t:6s"></span>
        <span class="rk-ember" style="--x:89%;--d:-1s;--t:5.5s"></span>
        <span class="rk-ember" style="--x:90%;--d:-3.6s;--t:6.5s"></span>
        <span class="rk-dust" style="--x:14%;--d:0s;--t:14s"></span>
        <span class="rk-dust" style="--x:47%;--d:-6s;--t:17s"></span>
        <span class="rk-dust" style="--x:71%;--d:-11s;--t:15s"></span>
        <img class="ds-layer rk-ceiling" src="images/dungeons/razorfen-ceiling.svg" alt="" />
        break;

    case "scarlet":
        <img class="ds-layer ds-cave" src="images/dungeons/scarlet-hall.svg" alt="" />
        <img class="sm-window" src="images/dungeons/scarlet-window.svg" alt="" style="--x:12%" />
        <img class="sm-window" src="images/dungeons/scarlet-window.svg" alt="" style="--x:38%" />
        <img class="sm-rose" src="images/dungeons/scarlet-rose.svg" alt="" />
        <span class="sm-ray" style="--x:12%;--d:0s"></span>
        <span class="sm-ray" style="--x:38%;--d:-3s"></span>
        <span class="sm-ray wide" style="--x:66%;--d:-5s"></span>
        <img class="ds-layer ds-floor sm-floor" src="images/dungeons/scarlet-floor.svg" alt="" />
        <img class="sm-pillar left" src="images/dungeons/scarlet-pillar.svg" alt="" />
        <img class="sm-pillar right" src="images/dungeons/scarlet-pillar.svg" alt="" />
        <img class="sm-banner" src="images/dungeons/scarlet-banner.svg" alt="" style="--x:3%;--d:0s" />
        <img class="sm-banner" src="images/dungeons/scarlet-banner.svg" alt="" style="--x:85%;--d:-2.5s" />
        <span class="sm-candles" style="--x:2%;--d:0s"><span class="sm-candle-glow"></span><img src="images/dungeons/scarlet-candelabra.svg" alt="" /></span>
        <span class="sm-candles" style="--x:62%;--d:-1.1s"><span class="sm-candle-glow"></span><img src="images/dungeons/scarlet-candelabra.svg" alt="" /></span>
        <span class="sm-candles" style="--x:91%;--d:-2.2s"><span class="sm-candle-glow"></span><img src="images/dungeons/scarlet-candelabra.svg" alt="" /></span>
        break;
}

@code {
    /// <summary>Dungeon zone theme (CombatZone.Theme); a theme without a case keeps only the gradient.</summary>
    [Parameter, EditorRequired] public string Theme { get; set; } = "";
}
