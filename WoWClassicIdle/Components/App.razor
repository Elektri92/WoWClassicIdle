@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Globale Interaktivität ohne Vorrendern: Seitenwechsel laufen komplett im bestehenden Circuit.
    // Mit Render-Mode je Seite wurde jede Seite erst vorgerendert eingefügt und Millisekunden später
    // interaktiv ersetzt – die Einblend-Animationen starteten doppelt und flackerten (v. a. WebKitGTK).
    // Seiten mit [ExcludeFromInteractiveRouting] (Error) bleiben statisch.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
