<script src="@Assets["js/spellfx/spells.js"]"></script>
<script src="@Assets["js/spellfx/swings.js"]"></script>
<script src="@Assets["js/spellfx/auras.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext HttpContext { get; set; } = default!;

    // Global interactivity without prerendering: page navigation runs entirely inside the existing circuit.
    // With a per-page render mode every page was first inserted prerendered and replaced interactively
    // milliseconds later – the fade-in animations started twice and flickered (especially on WebKitGTK).
    // Pages with [ExcludeFromInteractiveRouting] (Error) stay static.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}
