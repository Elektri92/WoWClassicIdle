@using Models
@inject IdleGameEngine Engine

@* Tooltip section of a combat zone: the profession bonuses dropping there and which ones are found *@
@{ var bonuses = ProfessionBonusRegistry.ForZone(Zone).ToList(); }
<span class="zt-section">Profession bonuses (@bonuses.Count(Engine.OwnsProfessionBonus)/@bonuses.Count)</span>
@foreach (var bonus in bonuses)
{
    bool found = Engine.OwnsProfessionBonus(bonus);
    <span class="zt-obj @(found ? "done" : "")">
        <img src="@bonus.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
        <span style="color: @ItemQualityColors.Hex(bonus.Quality)">@Professions.Get(bonus.Profession).Name: @bonus.Name</span>
        <span class="zt-obj-count">@(found ? "✓" : "–")</span>
    </span>
}

@code {
    [Parameter, EditorRequired] public CombatZone Zone { get; set; } = null!;
}
