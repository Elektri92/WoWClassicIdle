@using Models
@using Services
@inject IAchievementService _achievements
@implements IDisposable

@if (_toasts.Count > 0)
{
    <div class="achievement-toast-container">
        @foreach (var t in SnapshotToasts())
        {
            <div @key="t.Id" class="achievement-toast" @onclick="() => Dismiss(t.Id)">
                <div class="toast-header-line">Achievement Earned!</div>
                <div class="toast-body">
                    <img class="toast-icon" src="@t.Definition.IconUrl" alt=""
                         onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2256%22 height=%2256%22><rect fill=%22%23333%22 width=%2256%22 height=%2256%22 rx=%226%22/></svg>'" />
                    <div class="toast-text">
                        <span class="toast-title">@t.Definition.Title</span>
                        <span class="toast-desc">@t.Definition.Description</span>
                        <span class="toast-points">@t.Definition.Points Achievement Points</span>
                    </div>
                </div>
            </div>
        }
    </div>
}

<style>
    .achievement-toast-container {
        position: fixed;
        top: 80px;
        right: 20px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        gap: 10px;
        pointer-events: none;
    }

    .achievement-toast {
        pointer-events: all;
        width: 320px;
        background: linear-gradient(180deg, #2c1f0a 0%, #1a1205 50%, #0e0b07 100%);
        border: 2px solid #c5a55a;
        border-radius: 6px;
        box-shadow:
            0 0 0 1px #8a7444,
            0 0 20px rgba(197, 165, 90, 0.5),
            0 6px 24px rgba(0, 0, 0, 0.8);
        cursor: pointer;
        animation: toastSlideIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        overflow: hidden;
    }

    .achievement-toast::before {
        content: '';
        display: block;
        height: 3px;
        background: linear-gradient(90deg, transparent, #ffd100, #c5a55a, #ffd100, transparent);
    }

    .toast-header-line {
        font-family: 'Cinzel', serif;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: #ffd100;
        text-shadow: 0 0 8px rgba(255, 209, 0, 0.6);
        text-align: center;
        padding: 6px 12px 4px;
        border-bottom: 1px solid #5a4a28;
    }

    .toast-body {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 10px 14px 12px;
    }

    .toast-icon {
        width: 52px;
        height: 52px;
        border-radius: 5px;
        border: 2px solid #c5a55a;
        box-shadow: 0 0 8px rgba(197, 165, 90, 0.4), inset 0 0 0 1px #8a7444;
        flex-shrink: 0;
    }

    .toast-text {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .toast-title {
        font-family: 'Cinzel', serif;
        font-size: 0.95rem;
        font-weight: 700;
        color: #fff;
        text-shadow: 0 1px 3px #000;
        line-height: 1.2;
    }

    .toast-desc {
        font-size: 0.78rem;
        color: #c9b88c;
        line-height: 1.3;
    }

    .toast-points {
        font-size: 0.72rem;
        font-weight: 700;
        color: #ffd100;
        text-shadow: 0 1px 2px #000;
        margin-top: 2px;
    }

    @@keyframes toastSlideIn {
        from { visibility: visible;
            opacity: 0;
            transform: translateX(60px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateX(0) scale(1);
        }
    }
</style>

@code {
    private record ToastEntry(int Id, AchievementDefinition Definition, DateTime Created);

    private readonly List<ToastEntry> _toasts = new();
    private int _nextId;
    private static readonly TimeSpan ToastLifetime = TimeSpan.FromSeconds(8);
    private System.Timers.Timer? _cleanupTimer;

    protected override void OnInitialized()
    {
        _achievements.AchievementEarned += OnAchievementEarned;
        _cleanupTimer = new System.Timers.Timer(1000) { AutoReset = true };
        _cleanupTimer.Elapsed += (_, _) => CleanupExpired();
        _cleanupTimer.Start();
    }

    private void OnAchievementEarned(AchievementDefinition def)
    {
        lock (_toasts)
            _toasts.Add(new ToastEntry(Interlocked.Increment(ref _nextId), def, DateTime.UtcNow));

        _ = InvokeAsync(StateHasChanged);
    }

    private void Dismiss(int id)
    {
        lock (_toasts) _toasts.RemoveAll(t => t.Id == id);
    }

    private void CleanupExpired()
    {
        var cutoff = DateTime.UtcNow - ToastLifetime;
        bool changed;
        lock (_toasts)
        {
            int before = _toasts.Count;
            _toasts.RemoveAll(t => t.Created < cutoff);
            changed = _toasts.Count != before;
        }
        if (changed)
            _ = InvokeAsync(StateHasChanged);
    }

    private ToastEntry[] SnapshotToasts()
    {
        lock (_toasts) return _toasts.ToArray();
    }

    public void Dispose()
    {
        _achievements.AchievementEarned -= OnAchievementEarned;
        _cleanupTimer?.Stop();
        _cleanupTimer?.Dispose();
    }
}
