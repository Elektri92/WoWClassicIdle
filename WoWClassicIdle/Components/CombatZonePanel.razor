@using Models
@inject IdleGameEngine Engine
@implements IDisposable

@* Combat zones in /idle: banner of the current zone + tile map of all zones (gradient per zone, css/combat-zones.css).
   The first pick per character is active immediately, afterwards the character travels – on hover each tile shows the travel time. *@
@{
    var current = Engine.CurrentCombatZone;
    bool needsZone = Engine.NeedsCombatZone;
    int level = Engine.Player.Level;
}
<div class="czone-panel">
    @if (!needsZone && current is not null)
    {
        <div class="czone-banner zone-theme-@current.Theme">
            <div class="czone-banner-text">
                <span class="czone-banner-label">@(Engine.IsTraveling ? "Leaving" : "Fighting in")</span>
                <span class="czone-banner-name">@current.Name</span>
                <span class="czone-level @LevelClass(current, level)">Lv @current.LevelRange</span>
                @if (XpHint(current, level) is { } hint)
                {
                    <span class="czone-xp-hint">@hint</span>
                }
            </div>
            @* Only what is still open: completed objectives and found drops disappear *@
            @if (!current.IsDungeon && !Engine.IsZoneMastered(current) && !Engine.IsZoneOutgrown(current))
            {
                <WowTooltip Title="@ObjectivesTitle(current)" TitleColor="#ffd100" Body="ObjectivesBody(current)">
                    <div class="czone-objectives">
                        @foreach (var objective in ZoneObjectiveRegistry.For(current).Where(o => !Engine.IsObjectiveDone(o)))
                        {
                            <span class="czone-objective">
                                <img src="@objective.ImageUrl" alt="" onerror="this.style.visibility='hidden'" />
                                @Engine.ObjectiveProgress(objective)/@objective.Required
                            </span>
                        }
                    </div>
                </WowTooltip>
            }
            @if (ProfessionBonusRegistry.ForZone(current).Where(b => !Engine.OwnsProfessionBonus(b)).ToList() is { Count: > 0 } missingBonuses)
            {
                <WowTooltip>
                    <ChildContent>
                        <div class="czone-bonuses">
                            @foreach (var bonus in missingBonuses)
                            {
                                <img src="@bonus.IconUrl" alt=""
                                     style="border-color: @ItemQualityColors.Hex(bonus.Quality)" onerror="this.style.visibility='hidden'" />
                            }
                        </div>
                    </ChildContent>
                    <Body>
                        <ZoneBonusList Zone="current" />
                    </Body>
                </WowTooltip>
            }
            <div class="czone-banner-mobs">
                @foreach (var mob in current.Mobs)
                {
                    <WowTooltip Title="@mob.Name" Body="MobTooltip(mob, current)">
                        <img src="@mob.ImageUrl" alt="@mob.Name" onerror="this.style.visibility='hidden'" />
                    </WowTooltip>
                }
            </div>
            <button class="wow-btn primary czone-toggle @(Open && !_closing ? "active" : "")" @onclick="ToggleMap">
                🗺 @(Open && !_closing ? "Hide map" : "Change zone")
            </button>
        </div>
    }

    @if (needsZone || Open)
    {
        @* Map unfolds when opened and fades out when closed (css/combat-zones.css, czone-mapview) *@
        <div class="czone-mapview @(_closing ? "closing" : "")">
        @* Short legend instead of prose: rules as chips + meaning of the level colors *@
        <div class="czone-legend">
            <span class="czone-legend-title">@(needsZone ? "Choose your hunting grounds" : "Choose a new zone")</span>
            <span class="czone-chip">⚔ Enemies near your level</span>
            <span class="czone-chip">@(needsZone ? "⚡ First pick is instant" : "🧭 Travel takes time – no fighting")</span>
            <span class="czone-chip">🦅 Flight points unlock account-wide</span>
            <span class="czone-legend-levels">
                <span class="czone-level lvl-yellow">Full XP</span>
                <span class="czone-level lvl-green">Reduced</span>
                <span class="czone-level lvl-gray">Outgrown</span>
                <span class="czone-level lvl-red">Locked</span>
                <span class="czone-legend-done"><span class="czone-done static">✓</span> Finished</span>
            </span>
        </div>

        @* World map: Kalimdor left, Eastern Kingdoms right – like on the WoW map *@
        <div class="czone-map">
        @foreach (var continent in Continents)
        {
            <section class="czone-continent-frame continent-@continent.Key">
            <div class="czone-sheen" aria-hidden="true"></div>
            <header class="czone-continent-header">
                <img src="@continent.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
                <div>
                    <div class="czone-continent-title">@continent.Title</div>
                    <div class="czone-continent-sub">
                        @(continent.Subtitle ?? $"{continent.Zones.Count(z => CombatZoneRegistry.CanEnter(z, level))} / {continent.Zones.Count} zones open")
                    </div>
                </div>
            </header>
            @{ int tileIndex = 0; }
            @foreach (var band in continent.Bands)
            {
            <div class="czone-band">
            @if (band.Title.Length > 0)
            {
                <div class="czone-band-title">@band.Title</div>
            }
            @* Outgrown zones shrink to small, faded labels – only their profession drops still matter *@
            <div class="czone-grid">
                @foreach (var zone in band.Zones.Where(z => !z.IsOutgrownAt(level)))
                {
                    int delayIndex = tileIndex++; // staggered fade-in of the tiles
                    bool isHere = zone.Id == current?.Id && !needsZone;
                    bool isTarget = zone.Id == Engine.Travel?.TargetZoneId;
                    bool locked = !CombatZoneRegistry.CanEnter(zone, level);
                    var blocker = Engine.CombatZoneBlocker(zone);
                    var route = needsZone || isHere || locked ? null : RouteTo(zone);
                    <WowTooltip Contents="true" Title="@zone.Name" TitleColor="#ffd100" Body="ZoneTooltip(zone, level, blocker, route, needsZone)">
                    <div class="czone-tile zone-theme-@zone.Theme @TileClasses(zone, isHere, isTarget, locked, blocker)"
                         style="--i: @delayIndex" @onclick="() => Select(zone)">
                        @if (Engine.IsZoneFinished(zone))
                        {
                            <span class="czone-done" aria-label="Zone finished">✓</span>
                        }
                        <div class="czone-tile-head">
                            <span class="czone-tile-name">@zone.Name</span>
                            <span class="czone-level @LevelClass(zone, level)">@zone.LevelRange</span>
                        </div>
                        <div class="czone-tile-row">
                            <div class="czone-tile-mobs">
                                @foreach (var mob in zone.Dungeon?.Bosses ?? zone.Mobs)
                                {
                                    <img src="@mob.ImageUrl" alt="@mob.Name" onerror="this.style.visibility='hidden'" />
                                }
                            </div>
                            @if (!locked)
                            {
                                <div class="czone-tile-badges">
                                    @if (Engine.IsFlightPointKnown(zone))
                                    {
                                        <span class="czone-badge flight" aria-label="Flight point known">🦅</span>
                                    }
                                    @if (zone.IsDungeon)
                                    {
                                        <span class="czone-badge dungeon">🗝 @Engine.DungeonRunsLeft/@DungeonRules.RunsPerWindow</span>
                                        <span class="czone-badge">🏆 @Engine.DungeonClears(zone)</span>
                                    }
                                    else
                                    {
                                        @if (!Engine.IsZoneDiscovered(zone))
                                        {
                                            <span class="czone-badge new" aria-label="Undiscovered">✦</span>
                                        }
                                        @if (!Engine.IsZoneMastered(zone))
                                        {
                                            <span class="czone-badge">📜 @Engine.CompletedObjectives(zone)/@ZoneObjectiveRegistry.For(zone).Count</span>
                                        }
                                        @BonusBadge(zone)
                                    }
                                </div>
                            }
                        </div>

                        @if (isHere)
                        {
                            <div class="czone-status here">📍 You are here</div>
                        }
                        else if (isTarget)
                        {
                            <div class="czone-status traveling">🧭 Traveling here…</div>
                        }
                        else if (locked)
                        {
                            <div class="czone-status locked">🔒 Requires level @zone.MinLevel</div>
                        }
                        else if (Engine.DungeonLockoutBlocker(zone) is { } lockout)
                        {
                            <div class="czone-status locked">🔒 @lockout</div>
                        }

                        @if (!locked && !isHere && !isTarget)
                        {
                            @* Appears on hover (CSS) *@
                            <div class="czone-travel">
                                @if (route is null)
                                {
                                    <span>⚔ No travel needed</span>
                                }
                                else
                                {
                                    <span class="czone-travel-time">🕒 @ZoneTravel.FormatDuration(route.Seconds)</span>
                                    <span class="czone-travel-legs">
                                        @foreach (var leg in route.Legs)
                                        {
                                            <span class="czone-travel-leg">@ModeEmoji(leg.Mode)</span>
                                        }
                                    </span>
                                }
                            </div>
                        }
                    </div>
                    </WowTooltip>
                }
            </div>
            @if (band.Zones.Where(z => z.IsOutgrownAt(level)).ToList() is { Count: > 0 } outgrown)
            {
                <div class="czone-outgrown">
                    @foreach (var zone in outgrown)
                    {
                        bool isHere = zone.Id == current?.Id && !needsZone;
                        bool isTarget = zone.Id == Engine.Travel?.TargetZoneId;
                        var blocker = Engine.CombatZoneBlocker(zone);
                        var route = needsZone || isHere ? null : RouteTo(zone);
                        <WowTooltip Contents="true" Title="@zone.Name" TitleColor="#ffd100" Body="ZoneTooltip(zone, level, blocker, route, needsZone)">
                        <div class="czone-tile outgrown zone-theme-@zone.Theme @TileClasses(zone, isHere, isTarget, false, blocker)"
                             @onclick="() => Select(zone)">
                            @if (Engine.IsZoneFinished(zone))
                            {
                                <span class="czone-done" aria-label="Zone finished">✓</span>
                            }
                            <span class="czone-tile-name">@(isHere ? "📍 " : isTarget ? "🧭 " : "")@zone.Name</span>
                            <span class="czone-level @LevelClass(zone, level)">@zone.LevelRange</span>
                            @BonusBadge(zone)
                        </div>
                        </WowTooltip>
                    }
                </div>
            }
            </div>
            }
            </section>
        }
        </div>
        </div>
    }

    @if (_partyDialogZone is { } dialogZone && Engine.ActiveCharacter is { } dialogSlot)
    {
        <DungeonPartyDialog Zone="dialogZone" Slot="dialogSlot"
                            OnConfirm="setup => EnterDungeon(dialogZone, setup)"
                            OnCancel="() => _partyDialogZone = null" />
    }
</div>

@code {
    /// <summary>Zone map open (two-way binding so /idle can hide combat and meter).</summary>
    [Parameter] public bool Open { get; set; }
    [Parameter] public EventCallback<bool> OpenChanged { get; set; }

    private Task SetOpen(bool open)
    {
        Open = open;
        return OpenChanged.InvokeAsync(open);
    }

    // Duration of the close animation – must match czone-map-close in combat-zones.css
    private const int CloseAnimationMs = 320;
    private bool _closing;

    private Task ToggleMap() => Open && !_closing ? CloseAnimated() : SetOpen(true);

    /// <summary>Plays the fade-out animation first, then closes the map.</summary>
    private async Task CloseAnimated()
    {
        if (_closing) return;
        _closing = true;
        StateHasChanged();
        await Task.Delay(CloseAnimationMs);
        _closing = false;
        await SetOpen(false);
    }
    private string _signature = "";
    private readonly Dictionary<string, TravelRoute> _routes = new();

    private record LevelBand(string Title, IReadOnlyList<CombatZone> Zones);

    private record Continent(string Key, string Title, string IconUrl, IReadOnlyList<CombatZone> Zones, string? Subtitle = null)
    {
        // Dungeon columns are a single list without level bands
        public IReadOnlyList<LevelBand> Bands { get; } = Subtitle is null ? BandsOf(Zones) : [new LevelBand("", Zones)];
    }

    // Tens of the entry level decide the band; the exact range stays on the tile
    private static IReadOnlyList<LevelBand> BandsOf(IEnumerable<CombatZone> zones) =>
        zones.GroupBy(z => z.MinLevel / 10)
            .OrderBy(g => g.Key)
            .Select(g => new LevelBand($"Level {Math.Max(1, g.Key * 10)}–{g.Key * 10 + 10}", g.ToList()))
            .ToList();

    private const string DungeonIconUrl = "https://wow.zamimg.com/images/wow/icons/large/inv_misc_key_03.jpg";

    // Kalimdor left, Eastern Kingdoms right (like on the world map); Teldrassil belongs to Kalimdor.
    // The dungeons of each continent stand on its outer side.
    private static readonly Continent[] Continents =
    [
        new("dungeons-kalimdor", "Dungeons", DungeonIconUrl,
            CombatZoneRegistry.Dungeons.Where(z => z.Landmass != Landmass.EasternKingdoms).ToList(), "Kalimdor"),
        new("kalimdor", "Kalimdor", "https://wow.zamimg.com/images/wow/icons/large/inv_misc_map_01.jpg",
            CombatZoneRegistry.All.Where(z => z.Landmass != Landmass.EasternKingdoms).ToList()),
        new("eastern-kingdoms", "Eastern Kingdoms", "https://wow.zamimg.com/images/wow/icons/large/inv_misc_map02.jpg",
            CombatZoneRegistry.All.Where(z => z.Landmass == Landmass.EasternKingdoms).ToList()),
        new("dungeons-eastern-kingdoms", "Dungeons", DungeonIconUrl,
            CombatZoneRegistry.Dungeons.Where(z => z.Landmass == Landmass.EasternKingdoms).ToList(), "Eastern Kingdoms"),
    ];

    protected override void OnInitialized()
    {
        _signature = Signature();
        Engine.TickUpdated += OnTick;
    }

    // Only re-render when character, zone, travel or level change (TickUpdated fires 10× per second)
    private string Signature() =>
        $"{Engine.ActiveCharacter?.Id}|{Engine.ActiveCharacter?.CombatZoneId}|{Engine.Travel?.TargetZoneId}|{Engine.Player.Level}"
        + $"|{Engine.ActiveCharacter?.DiscoveredZoneIds.Count}|{Engine.FlightPointCount}|{Engine.ActiveCharacter?.ZoneObjectiveProgress.Values.Sum()}"
        + $"|{Engine.OwnedProfessionBonusCount}"
        + $"|{Engine.DungeonRunsLeft}|{(int?)Engine.DungeonLockoutRemaining?.TotalMinutes}";

    private void OnTick()
    {
        var signature = Signature();
        if (signature == _signature) return;
        _signature = signature;
        _ = InvokeAsync(() =>
        {
            _routes.Clear(); // Start zone/level changed → recalculate travel times
            StateHasChanged();
        });
    }

    private TravelRoute? RouteTo(CombatZone zone)
    {
        if (_routes.TryGetValue(zone.Id, out var cached)) return cached;
        var route = Engine.RouteTo(zone);
        if (route is not null) _routes[zone.Id] = route;
        return route;
    }

    private CombatZone? _partyDialogZone;

    private async Task EnterDungeon(CombatZone zone, DungeonPartySetup setup)
    {
        _partyDialogZone = null;
        Engine.SetDungeonParty(setup);
        if (Engine.SelectCombatZone(zone.Id))
            await (Open ? CloseAnimated() : SetOpen(false));
    }

    private async Task Select(CombatZone zone)
    {
        if (_closing) return;
        // Dungeons ask for the group first; the journey starts after the confirmation
        if (zone.IsDungeon && Engine.CombatZoneBlocker(zone) is null)
        {
            _partyDialogZone = zone;
            return;
        }
        // First pick (needsZone): map disappears immediately, combat fades in on its own
        if (Engine.SelectCombatZone(zone.Id))
            await (Open ? CloseAnimated() : SetOpen(false));
    }

    /// <summary>Level badge like the quest colors in WoW: red = locked, yellow = full XP, green = reduced, grey = no XP.</summary>
    private static string LevelClass(CombatZone zone, int level) =>
        level < zone.MinLevel                   ? "lvl-red"
        : level - zone.MaxLevel <= 2            ? "lvl-yellow"
        : level < zone.NoXpLevel                ? "lvl-green"
        : "lvl-gray";

    private static string TileClasses(CombatZone zone, bool isHere, bool isTarget, bool locked, string? blocker) =>
        string.Join(' ', new[]
        {
            isHere ? "current" : "", isTarget ? "target" : "", locked ? "locked" : "", blocker is null ? "selectable" : "",
        }.Where(c => c.Length > 0));

    // Profession drops still missing in the zone (hidden once all are found)
    private RenderFragment BonusBadge(CombatZone zone) => __builder =>
    {
        var bonuses = ProfessionBonusRegistry.ForZone(zone).ToList();
        int found = bonuses.Count(Engine.OwnsProfessionBonus);
        if (found < bonuses.Count)
        {
            <span class="czone-badge">🎁 @found/@bonuses.Count</span>
        }
    };

    private static string? XpHint(CombatZone zone, int level) =>
        level >= zone.NoXpLevel        ? "No XP – enemies are too low"
        : level - zone.MaxLevel >= 3   ? "Reduced XP – enemies are low level"
        : null;

    // WoW tooltip of a zone tile: level, continent, enemies, status and travel route
    private RenderFragment ZoneTooltip(CombatZone zone, int level, string? blocker, TravelRoute? route, bool needsZone) => @<text>
        <span class="zt-line @LevelClass(zone, level)">Level @zone.LevelRange</span>
        <span class="zt-sub">@(zone.Landmass == Landmass.EasternKingdoms ? "Eastern Kingdoms" : "Kalimdor")</span>
        <span class="zt-flavor">"@zone.Description"</span>
        <span class="zt-section">Enemies</span>
        @foreach (var mob in zone.Mobs)
        {
            <span class="zt-mob">
                <img src="@mob.ImageUrl" alt="" onerror="this.style.visibility='hidden'" />
                <span>@mob.Name</span>
                <span class="zt-mob-type">@mob.Archetype.Type</span>
            </span>
        }
        @if (!zone.IsOutgrownAt(level) && XpHint(zone, level) is { } hint)
        {
            <span class="zt-warn">@hint</span>
        }
        @if (zone.Dungeon is { } dungeon)
        {
            <span class="zt-section">Bosses</span>
            @foreach (var boss in dungeon.Bosses)
            {
                <span class="zt-mob">
                    <img src="@boss.ImageUrl" alt="" onerror="this.style.visibility='hidden'" />
                    <span>@boss.Name</span>
                </span>
            }
            <span class="zt-good">Every boss drops one green or blue item</span>
            <span class="zt-sub">Build a group of 1 tank, 1 healer and 3 DPS – your companions cast their spells on their own and you share one health bar</span>
            <span class="zt-sub">@DungeonRules.RunsPerWindow runs per @((int)DungeonRules.LockoutWindow.TotalHours) hours per character (@Engine.DungeonRunsLeft left) · @DungeonRules.MaxWipes wipes end a run</span>
            @if (!Engine.IsFlightPointKnown(zone))
            {
                <span class="zt-sub">Reach it once to unlock its flight point for your account</span>
            }
        }
        else if (zone.IsOutgrownAt(level))
        {
            <span class="zt-sub">Outgrown – no discovery XP or objectives, only profession drops remain</span>
        }
        else if (level >= zone.MinLevel)
        {
            @if (!Engine.IsZoneDiscovered(zone))
            {
                <span class="zt-good">✦ Undiscovered – first visit: +@Engine.DiscoveryXpFor(zone) XP</span>
                @if (!Engine.IsFlightPointKnown(zone))
                {
                    <span class="zt-sub">Discover it to unlock its flight point for your account</span>
                }
            }
            @if (!Engine.IsZoneMastered(zone))
            {
                <span class="zt-section">@ObjectivesTitle(zone)</span>
                @ObjectivesBody(zone)
            }
        }
        <ZoneBonusList Zone="zone" />
        @if (route is { Legs.Count: > 0 })
        {
            @* One line: total time + chain of legs (mode icon + stop); details per leg on the travel scene *@
            <span class="zt-section">Travel <b>@ZoneTravel.FormatDuration(route.Seconds)</b></span>
            <span class="zt-route">
                @foreach (var leg in route.Legs)
                {
                    <span class="zt-route-leg" title="@ZoneTravel.ModeLabel(leg.Mode, Engine.GroundTravel) · @ZoneTravel.FormatDuration(leg.Seconds)">@ModeEmoji(leg.Mode) @leg.To</span>
                }
            </span>
        }
        @if (blocker is not null)
        {
            <span class="zt-error">@blocker</span>
        }
        else if (needsZone)
        {
            <span class="zt-hint">Click to start fighting here</span>
        }
        else
        {
            <span class="zt-hint">@(zone.IsDungeon ? "Click to build your group" : "Click to travel here")</span>
        }
    </text>;

    private string ObjectivesTitle(CombatZone zone) =>
        $"Zone objectives ({Engine.CompletedObjectives(zone)}/{ZoneObjectiveRegistry.For(zone).Count})";

    // Open objectives with progress + reward per objective and for the mastery
    private RenderFragment ObjectivesBody(CombatZone zone) => @<text>
        @foreach (var objective in ZoneObjectiveRegistry.For(zone).Where(o => !Engine.IsObjectiveDone(o)))
        {
            <span class="zt-obj">
                <img src="@objective.ImageUrl" alt="" onerror="this.style.visibility='hidden'" />
                <span>@objective.Label</span>
                <span class="zt-obj-count">@Engine.ObjectiveProgress(objective)/@objective.Required</span>
            </span>
        }
        <span class="zt-sub">Each: +@ZoneObjectiveRegistry.ObjectiveXp(zone, Engine.Player.Level) XP, @Money.Format(ZoneObjectiveRegistry.ObjectiveCopper(zone, Engine.Player.Level))</span>
        <span class="zt-sub">All done: guaranteed green or blue item</span>
    </text>;

    private static RenderFragment MobTooltip(ZoneMob mob, CombatZone zone) => @<text>
        <span class="zt-sub">@mob.Archetype.Type</span>
        <span class="zt-line lvl-yellow">Level @zone.LevelRange</span>
    </text>;

    public static string ModeEmoji(TravelMode mode) => mode switch
    {
        TravelMode.Flight   => "🦅",
        TravelMode.Ship     => "⛵",
        TravelMode.Zeppelin => "🎈",
        TravelMode.Mount    => "🐎",
        TravelMode.Form     => "🐾",
        _                   => "🥾",
    };

    public void Dispose() => Engine.TickUpdated -= OnTick;
}
