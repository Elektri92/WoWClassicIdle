@* Generic WoW tooltip for arbitrary content (zones, travel legs, enemies).
   Positioned via js/tooltip.js (position: fixed); styles are global in css/combat-zones.css,
   because the tooltip content comes from the calling component (scoped CSS doesn't apply there). *@
<span class="zt-host @(Contents ? "zt-contents" : "") @Class" onmouseenter="wowTooltip.show(this)" onmouseleave="wowTooltip.hide(this)">
    @ChildContent
    <span class="wow-tooltip zt-tooltip" role="tooltip">
        @if (!string.IsNullOrEmpty(Title))
        {
            <span class="zt-title" style="@(TitleColor is null ? null : $"color: {TitleColor}")">@Title</span>
        }
        @Body
    </span>
</span>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public RenderFragment? Body { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? TitleColor { get; set; }
    [Parameter] public string? Class { get; set; }
    /// <summary>Host without its own box (display: contents) – the child stays a direct grid/flex element.</summary>
    [Parameter] public bool Contents { get; set; }
}
