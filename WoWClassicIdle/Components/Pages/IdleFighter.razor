<style>
    .battlefield {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 1rem 0;
        padding-left: 94px;   /* Platz für Verbrauchsgüter-Spalte + Spell-Scroll links neben dem Spieler */
    }

    .unit-frame {
        flex: 1;
        min-width: 260px;
        max-width: 420px;
        background: linear-gradient(180deg, #2b2418 0%, #1a150d 100%);
        border: 2px solid #5a4a28;
        border-radius: 8px;
        padding: 10px;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #8a7444;
        position: relative;
        overflow: visible;
    }

    /* Azeroth-Karte sehr schwach hinter dem braunen Verlauf durchscheinen lassen */
    .player-frame {
        background:
            linear-gradient(180deg, rgba(43,36,24,.9) 0%, rgba(26,21,13,.93) 100%),
            url('images/azeroth-map.png') center / cover no-repeat,
            #1a150d;
    }

    .enemy-frame {
        background: linear-gradient(180deg, #2e1812 0%, #1a0d0a 100%);
        border-color: #6a2e22;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #9a4a34;
    }

    .rare-frame {
        border-color: #7aaabb !important;
        box-shadow: 0 0 22px rgba(120,180,210,.6), inset 0 0 0 1px #b8d0e0 !important;
    }

    .rare-name {
        color: #c8dce8 !important;
        text-shadow: 0 0 8px rgba(160,210,235,0.7) !important;
    }

    .rare-badge {
        font-family: 'Cinzel', serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #a8c4d4;
        background: rgba(120,180,210,.15);
        border: 1px solid #7aaabb;
        border-radius: 3px;
        padding: 1px 4px;
        text-shadow: 0 0 4px rgba(120,180,210,.55);
    }

    /* Silberner Portraitrand für Rare-Gegner */
    .rare-portrait-area .enemy-portrait {
        border-color: #7aaabb;
        box-shadow: 0 0 12px rgba(100,160,190,0.7);
    }

    /* Drachen-Rahmen (300 × 300 px Grafik, Portrait-Loch bei 114/138 mit r = 70, Level-Rund bei 169/190):
       auf 141 px skaliert (Faktor 0,47 → Loch r ≈ 33 = Portrait + Rand) und horizontal gespiegelt,
       damit Kopf und Flügel links aus dem Frame ragen. Loch-Mitte gespiegelt bei x = 186 → 87,6 px. */
    .rare-dragon-frame {
        position: absolute;
        left: -56px;
        top: -33px;
        width: 141px;
        height: 141px;
        max-width: none;
        transform: scaleX(-1);
        pointer-events: none;
        z-index: 3;
        filter: drop-shadow(0 2px 4px rgba(0,0,0,.8)) drop-shadow(0 0 6px rgba(160,200,225,.35));
    }

    /* Gegnerlevel im kleinen goldenen Rund des Rahmens (unten links nach dem Spiegeln) */
    .rare-level-badge {
        position: absolute;
        left: 6px;
        top: 56px;
        width: 22px;
        height: 22px;
        transform: translate(-50%, -50%);
        z-index: 4;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: radial-gradient(circle, #2a1f10 0%, #0e0b07 100%);
        color: #ffd100;
        font-family: var(--wow-font-title);
        font-size: .7rem;
        font-weight: 700;
        text-shadow: 0 1px 2px #000;
        pointer-events: none;
    }

    /* ── Floating Combat Text (WoW style) ── */
    .combat-text-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
    }

    .combat-text {
        position: absolute;
        transform: translateX(-50%);
        font-family: 'Arial Black', 'Impact', 'Segoe UI', sans-serif;
        font-weight: 900;
        font-size: 1.5rem;
        line-height: 1;
        white-space: nowrap;
        letter-spacing: .02em;
        -webkit-text-stroke: 1px #000;
        paint-order: stroke fill;
        text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 0 0 6px rgba(0,0,0,.8);
        animation: combatTextRise 1.5s ease-out forwards;
    }

    /* Auto attack on enemy: white */
    .ct-auto {
        color: #ffffff;
    }

    /* Ability on enemy: yellow, bigger, with "pop" */
    .ct-ability {
        color: #ffd100;
        font-size: 1.9rem;
        animation: combatTextPop 1.6s ease-out forwards;
    }

    /* Damage taken: red */
    .ct-taken {
        color: #ff2020;
    }

    /* Healing: green */
    .ct-heal {
        color: #20ff20;
        font-size: 1.7rem;
        animation: combatTextPop 1.6s ease-out forwards;
    }

    /* Kritischer Treffer: größer, mit goldenem Glühen */
    .ct-crit {
        font-size: 2.4rem;
        -webkit-text-stroke: 1.5px #000;
        text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000,
                     0 0 10px rgba(255,209,0,.9), 0 0 20px rgba(255,140,0,.6);
        animation: combatTextCrit 1.7s ease-out forwards;
    }

    @@keyframes combatTextCrit {
        0%   { transform: translate(-50%, 0) scale(.5); opacity: 0; }
        10%  { transform: translate(-50%, -6px) scale(1.9); opacity: 1; }
        28%  { transform: translate(-50%, -12px) scale(1.1); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(-50%, -70px) scale(1); opacity: 0; }
    }

    /* Start bei opacity 0, damit verzögerte Zahlen (animation-delay) bis zum Einschlag unsichtbar bleiben */
    @@keyframes combatTextRise {
        0%   { transform: translate(-50%, 0) scale(1.4); opacity: 0; }
        6%   { transform: translate(-50%, 0) scale(1.15); opacity: 1; }
        15%  { transform: translate(-50%, -6px) scale(1); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(-50%, -55px) scale(.9); opacity: 0; }
    }

    @@keyframes combatTextPop {
        0%   { transform: translate(-50%, 0) scale(.4); opacity: 0; }
        10%  { transform: translate(-50%, -4px) scale(1.6); opacity: 1; }
        25%  { transform: translate(-50%, -8px) scale(1); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(-50%, -60px) scale(.95); opacity: 0; }
    }

    .frame-header {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .portrait-area {
        position: relative;
        width: 64px;
        height: 64px;
        flex-shrink: 0;
    }

    .race-portrait {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        object-fit: cover;
        background: #0e0b07;
        box-shadow: 0 0 8px rgba(0,0,0,.8);
    }

    .enemy-portrait {
        border-color: #b33a2a;
    }

    .class-badge {
        position: absolute;
        bottom: -4px;
        right: -4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        background: #0e0b07;
        object-fit: contain;
    }

    /* Totenkopf-Icon beim Tod des Spielers */
    .death-skull {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 2px solid #888;
        object-fit: cover;
        background: #0e0b07;
        box-shadow: 0 0 8px rgba(0,0,0,.8);
        filter: grayscale(30%);
        animation: skull-pulse 2s ease-in-out infinite;
    }

    @@keyframes skull-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.65; }
    }

    .frame-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .name-line {
        display: flex;
        align-items: baseline;
        gap: 8px;
        white-space: nowrap;
    }

    .char-name {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 1rem;
        color: #ffd100;
        text-shadow: 0 1px 2px #000;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .enemy-name {
        color: #ff6b5b;
    }

    .spirit-healer-name {
        color: #9fd8ff;
    }

    .spirit-healer-portrait {
        filter: drop-shadow(0 0 6px #7fc8ff);
    }

    .spirit-fill {
        height: 100%;
        background: linear-gradient(180deg, #bfe6ff 0%, #4a8fc0 100%);
        transition: width .4s ease;
    }

    .level {
        font-size: .8rem;
        color: #9a8a64;
    }

    .bar-row,
    .xp-row {
        width: 100%;
    }

    .hp-bar, .mana-bar, .xp-bar {
        position: relative;
        height: 20px;
        background: #0e0b07;
        border-radius: 3px;
        overflow: hidden;
        border: 1px solid #5a4a28;
        box-shadow: inset 0 0 4px #000;
    }

    .hp-fill, .mana-fill, .xp-fill {
        height: 100%;
        transition: width .4s ease;
    }

    .hp-fill {
        background: linear-gradient(180deg, #3fbf3f 0%, #1e7a1e 100%);
    }

    /* Schild (Absorb) auf dem Spieler – blau, hinter bzw. über den HP */
    .shield-fill {
        position: absolute;
        top: 0;
        bottom: 0;
        background: linear-gradient(180deg, rgba(120, 200, 255, .85) 0%, rgba(40, 110, 220, .85) 100%);
        box-shadow: inset 0 0 0 1px rgba(190, 230, 255, .6);
        transition: left .4s ease, width .4s ease;
    }

    .shield-text {
        color: #9fd8ff;
    }

    /* ── Pet-Leiste ── */
    .pet-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
    }

    .pet-icon {
        width: 22px;
        height: 22px;
        border: 1px solid #5a4a28;
        border-radius: 3px;
    }

    .hp-bar.pet-hp {
        flex: 1;
        height: 14px;
    }

    /* ── Cast bar / GCD ── */
    .cast-row {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-top: 8px;
    }

    .cast-bar {
        position: relative;
        height: 18px;
        background: #0e0b07;
        border: 1px solid #5a4a28;
        border-radius: 3px;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-right: 6px;
        font-size: .72rem;
    }

    .cast-bar.idle {
        opacity: .45;
        justify-content: center;
    }

    .cast-fill {
        position: absolute;
        inset: 0 auto 0 0;
        background: linear-gradient(180deg, #ffd34a 0%, #c98a10 100%);
        transition: width .1s linear;
    }

    .cast-icon {
        position: relative;
        width: 16px;
        height: 16px;
    }

    .cast-name,
    .cast-time {
        position: relative;
        color: #fff;
        text-shadow: 0 1px 2px #000;
    }

    .cast-name {
        flex: 1;
    }

    .cast-idle-text {
        flex: 0;
        color: #9a8a64;
    }

    .cast-time {
        font-variant-numeric: tabular-nums;
    }

    .gcd-bar {
        height: 4px;
        background: #0e0b07;
        border-radius: 2px;
        overflow: hidden;
    }

    .gcd-fill {
        height: 100%;
        background: #c5a55a;
    }

    .gcd-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .ability-slot.filled.casting {
        border-color: #ffd34a;
        box-shadow: 0 0 10px rgba(255, 211, 74, .8);
    }

    /* ── Gegner-Swing-Timer: schmale Leiste unter dem Lebensbalken ── */
    .enemy-swing {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        font-size: .68rem;
    }

    .enemy-swing-icon {
        width: 18px;
        height: 18px;
        border: 1px solid #6a2e22;
        border-radius: 3px;
        box-shadow: 0 0 3px rgba(0, 0, 0, .8);
    }

    .enemy-swing-track {
        position: relative;
        flex: 1;
        height: 8px;
        background: #120806;
        border: 1px solid #4a1e16;
        border-radius: 4px;
        overflow: hidden;
        box-shadow: inset 0 1px 2px rgba(0, 0, 0, .8);
    }

    .enemy-swing-fill {
        position: absolute;
        inset: 0 auto 0 0;
        background: linear-gradient(180deg, #ff9a3a 0%, #c2410f 55%, #7a1e08 100%);
        transition: width .1s linear;
    }

    /* Funke an der Spitze der Füllung */
    .enemy-swing-tick {
        position: absolute;
        top: -1px;
        bottom: -1px;
        width: 3px;
        margin-left: -2px;
        background: #ffe6a0;
        box-shadow: 0 0 6px 2px rgba(255, 170, 60, .8);
        transition: left .1s linear;
    }

    .enemy-swing-time {
        min-width: 42px;
        color: #e8b49a;
        text-align: right;
        font-variant-numeric: tabular-nums;
        text-shadow: 0 1px 2px #000;
    }

    /* Kurz vor dem Treffer: Leiste glüht rot */
    .enemy-swing.imminent .enemy-swing-track {
        border-color: #ff5a2a;
        animation: enemySwingWarn .35s ease-in-out infinite alternate;
    }
    .enemy-swing.imminent .enemy-swing-time { color: #ff7a4a; font-weight: 700; }

    @@keyframes enemySwingWarn {
        from { box-shadow: inset 0 1px 2px rgba(0, 0, 0, .8), 0 0 2px rgba(255, 80, 30, .3); }
        to   { box-shadow: inset 0 1px 2px rgba(0, 0, 0, .8), 0 0 8px rgba(255, 80, 30, .9); }
    }

    /* Betäubt: eingefroren, kühles Blau */
    .enemy-swing.stunned .enemy-swing-fill { background: linear-gradient(180deg, #8fc8ff 0%, #3a6aa8 100%); }
    .enemy-swing.stunned .enemy-swing-tick { display: none; }
    .enemy-swing.stunned .enemy-swing-time { color: #8fc8ff; }

    .rare-frame .enemy-swing-icon { border-color: #7aaabb; }

    .enemy-hp .hp-fill {
        background: linear-gradient(180deg, #e03a2a 0%, #8b1a1a 100%);
    }

    .mana-bar {
        height: 16px;
    }

    .mana-fill {
