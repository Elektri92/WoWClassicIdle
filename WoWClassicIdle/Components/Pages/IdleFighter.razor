<style>
    .battlefield {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 1rem 0;
    }

    .unit-frame {
        flex: 1;
        min-width: 260px;
        max-width: 420px;
        background: linear-gradient(180deg, #2b2418 0%, #1a150d 100%);
        border: 2px solid #5a4a28;
        border-radius: 8px;
        padding: 10px;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #8a7444;
        position: relative;
        overflow: visible;
    }

    .enemy-frame {
        background: linear-gradient(180deg, #2e1812 0%, #1a0d0a 100%);
        border-color: #6a2e22;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #9a4a34;
    }

    .rare-frame {
        border-color: #c8a000 !important;
        box-shadow: 0 0 18px rgba(200,160,0,.55), inset 0 0 0 1px #e8c840 !important;
    }

    .rare-name {
        color: #e8c840 !important;
        text-shadow: 0 0 8px rgba(232, 200, 64, 0.6) !important;
    }

    .rare-badge {
        font-family: 'Cinzel', serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #c8a000;
        background: rgba(200,160,0,.15);
        border: 1px solid #c8a000;
        border-radius: 3px;
        padding: 1px 4px;
        text-shadow: 0 0 4px rgba(200,160,0,.5);
    }

    /* ── Floating Combat Text (WoW style) ── */
    .combat-text-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
    }

    .combat-text {
        position: absolute;
        transform: translateX(-50%);
        font-family: 'Arial Black', 'Impact', 'Segoe UI', sans-serif;
        font-weight: 900;
        font-size: 1.5rem;
        line-height: 1;
        white-space: nowrap;
        letter-spacing: .02em;
        -webkit-text-stroke: 1px #000;
        paint-order: stroke fill;
        text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 0 0 6px rgba(0,0,0,.8);
        animation: combatTextRise 1.5s ease-out forwards;
    }

    /* Auto attack on enemy: white */
    .ct-auto {
        color: #ffffff;
    }

    /* Ability on enemy: yellow, bigger, with "pop" */
    .ct-ability {
        color: #ffd100;
        font-size: 1.9rem;
        animation: combatTextPop 1.6s ease-out forwards;
    }

    /* Damage taken: red */
    .ct-taken {
        color: #ff2020;
    }

    /* Healing: green */
    .ct-heal {
        color: #20ff20;
        font-size: 1.7rem;
        animation: combatTextPop 1.6s ease-out forwards;
    }

    /* Kritischer Treffer: größer, mit goldenem Glühen */
    .ct-crit {
        font-size: 2.4rem;
