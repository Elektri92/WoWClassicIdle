@page "/idle"
@rendermode InteractiveServer
@using Models
@using Services
@inject IdleGameEngine _engine
@inject IAbilityLoadoutService _loadoutService
@inject IJSRuntime _js
@implements IAsyncDisposable

<PageTitle>Idle Fighter</PageTitle>

<div class="wow-page narrow idle-page">
<h2>Idle Fighter</h2>
<p class="wow-hint">Your character fights on its own – watch the battle, the damage meter and the action log.</p>

<div class="battlefield">
    <!-- ═══════════════════════════════════════════ -->
    <!--  PLAYER FRAME  (links)                     -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="unit-frame player-frame">
        <!-- ═══ CONSUMABLES: Spalte links neben dem Spieler, füllt von oben nach unten ═══ -->
        <div class="consumable-dock">
            <ConsumableBar />
        </div>
        <!-- Zuletzt ausgelöste Spells: Icon fliegt links neben dem Charakter von unten nach oben -->
        <div class="spell-scroll" aria-hidden="true">
            @foreach (var s in SnapshotSpellFloats())
            {
                <img @key="s.Id" class="spell-scroll-icon" src="@s.Ability.IconUrl" alt=""
                     onerror="this.style.visibility='hidden'" />
            }
        </div>
        <div class="combat-text-overlay">
            @foreach (var f in SnapshotFloats(_playerFloats))
            {
                <span @key="f.Id" class="combat-text @FloatCssClass(f)"
                      style="left: calc(50% + @(f.XOffset)px); top: @(f.YOffset)px;">@FloatText(f)</span>
            }
        </div>
        <div class="frame-header">
            <div class="portrait-area">
                @if (_engine.IsAtSpiritHealer)
                {
                    <!-- Totenkopf-Icon solange der Spieler tot ist -->
                    <img class="death-skull"
                         src="https://wow.zamimg.com/images/wow/icons/large/inv_misc_bone_skull_01.jpg"
                         alt="Dead" title="You are dead" />
                }
                else
                {
                    <img class="race-portrait"
                         src="@(Costumes.PortraitUrl(_engine.Player.Costume) ?? _engine.Player.FormPortraitUrl ?? IconUrls.RaceIconUrl(_engine.Player.Race, _engine.Gender))"
                         title="@(_engine.Player.Costume != Costume.None ? Costumes.Name(_engine.Player.Costume) : null)"
                         alt="" onerror="this.style.display='none'" />
                    <img class="class-badge"
                         src="@IconUrls.ClassIconUrl(_engine.Player.ActiveClass)"
                         alt="" onerror="this.style.display='none'" />
                }
            </div>
            <div class="frame-info">
                <div class="name-line">
                    <span class="char-name">@_engine.Player.Name</span>
                    <span class="level">Lv. @_engine.Player.Stats.Level</span>
                </div>
                <div class="bar-row">
                    @{
                        int playerHpPct = CalcPct(_engine.Player.CurrentHp, _engine.Player.Stats.MaxHp);
                        int shield      = _engine.Player.Buffs.TotalShield;
                        int shieldPct   = shield > 0 ? Math.Max(1, CalcPct(shield, _engine.Player.Stats.MaxHp)) : 0;
                        // Schild hängt hinter den HP; passt er nicht mehr rein, wird er rechtsbündig über die HP gelegt
                        int shieldLeft  = Math.Min(playerHpPct, 100 - shieldPct);
                    }
                    <div class="hp-bar">
                        <div class="hp-fill" style="width: @(playerHpPct)%"></div>
                        @if (shieldPct > 0)
                        {
                            <div class="shield-fill" style="left: @(shieldLeft)%; width: @(shieldPct)%"></div>
                        }
                        <span class="bar-text">
                            @_engine.Player.CurrentHp / @_engine.Player.Stats.MaxHp
                            @if (shield > 0)
                            {
                                <span class="shield-text">&nbsp;(+@shield)</span>
                            }
                        </span>
                    </div>
                </div>
                <div class="bar-row">
                    @{ int effectiveMaxMana = _engine.Player.Stats.MaxMana + _engine.Player.Buffs.BonusMaxMana; }
                    <div class="mana-bar mana-bar-@(_engine.Player.Resource.ToString().ToLowerInvariant())">
                        <div class="mana-fill"
                             style="width: @(CalcPct(_engine.Player.CurrentMana, effectiveMaxMana))%"></div>
                        <span class="bar-text">@_engine.Player.CurrentMana / @effectiveMaxMana</span>
                    </div>
                </div>
                <div class="xp-row">
                    <div class="xp-bar">
                        @if (_engine.Player.XpToNextLevel == 0)
                        {
                            <div class="xp-fill" style="width: 100%"></div>
                            <span class="bar-text">Max Level</span>
                        }
                        else
                        {
                            <div class="xp-fill"
                                 style="width: @(CalcPct(_engine.Player.Xp, _engine.Player.XpToNextLevel))%"></div>
                            <span class="bar-text">@_engine.Player.Xp / @_engine.Player.XpToNextLevel</span>
                        }
                    </div>
                </div>
            </div>
        </div>

            <!-- ═══ PET (Hunter-Pet / Warlock-Dämon) ═══ -->
            @if (_engine.Pet is { } pet)
            {
                <div class="pet-row">
                    <img class="pet-icon" src="@pet.Definition.IconUrl" alt="@pet.Definition.Name" onerror="this.style.visibility='hidden'" />
                    <div class="hp-bar pet-hp">
                        <div class="hp-fill" style="width: @(CalcPct(pet.CurrentHp, pet.MaxHp))%"></div>
                        <span class="bar-text">@pet.Definition.Name · @pet.CurrentHp / @pet.MaxHp</span>
                    </div>
                </div>
            }

            <!-- ═══ ACTIVE BUFFS ═══ -->
            @{ var buffs = _engine.Player.Buffs.Snapshot(); }
            @if (buffs.Count > 0)
            {
                <div class="buff-bar">
                    @foreach (var buff in buffs)
                    {
                        <AbilityTooltip @key="buff.Source.Id" Ability="buff.Source" BuffRemaining="buff.Remaining">
                            <span class="buff-icon">
                                <img src="@buff.Source.IconUrl" alt="@buff.Source.Name" onerror="this.style.visibility='hidden'" />
                                @if (buff.Source.BuffDuration < 9999)
                                {
                                    <span class="buff-time @(buff.Remaining <= 5 ? "expiring" : "")">@FormatBuffTime(buff.Remaining)</span>
                                }
                            </span>
                        </AbilityTooltip>
                    }
                </div>
            }

            <!-- ═══ CAST BAR / GLOBAL COOLDOWN ═══ -->
            @{
                var casting = _engine.CurrentCast;
                double gcdRemaining = _engine.GcdRemaining;
            }
            <div class="cast-row">
                <div class="cast-bar @(casting is null ? "idle" : "active")">
                    @if (casting is not null)
                    {
                        <div class="cast-fill" style="width: @PctStyle(_engine.CastProgress)%"></div>
                        <img class="cast-icon" src="@casting.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
                        <span class="cast-name">@casting.Name</span>
                        <span class="cast-time">@((_engine.CastDuration - _engine.CastElapsed).ToString("0.0"))s</span>
                    }
                    else
                    {
                        <span class="cast-name cast-idle-text">—</span>
                    }
                </div>
                <div class="gcd-bar" title="Global Cooldown">
                    <div class="gcd-fill" style="width: @PctStyle(gcdRemaining / IdleGameEngine.GlobalCooldown)%"></div>
                </div>
            </div>

            <!-- ═══ EQUIPPED ABILITIES ═══ -->
            <div class="ability-bar">
                <!-- Auto-Attack: Swing-Timer füllt sich von unten, pausiert während eines Mana-Casts -->
                @{ bool swingHeld = _engine.IsSwingHeld; }
                <WeaponTooltip Weapon="_engine.Player.EquippedWeapon">
                    <span class="ability-slot filled auto-attack-slot @(swingHeld ? "held" : "")"
                          title="@(swingHeld ? "Auto Attack – waiting for spell" : "Auto Attack")">
                        <img src="@(_engine.Player.EquippedWeapon?.IconUrl ?? AutoAttackFallbackIcon)" alt="Auto Attack"
                             onerror="this.style.visibility='hidden'" />
                        <span class="swing-fill" style="height: @PctStyle(_engine.SwingProgress)%"></span>
                        @if (swingHeld)
                        {
                            <span class="swing-held-mark">❚❚</span>
                        }
                    </span>
                </WeaponTooltip>
                <span class="ability-bar-divider"></span>
                @for (int i = 0; i < ClassAbilityRegistry.MaxSlotsPerClass; i++)
                {
                    var equipped = i < _engine.Player.EquippedAbilities.Count
                        ? _engine.Player.EquippedAbilities[i]
                        : null;

                    @if (equipped != null)
                    {
                        double remaining = _engine.Player.Cooldowns.GetRemaining(equipped.Id);
                        bool onCooldown = remaining > 0;
                        bool isCasting  = casting?.Id == equipped.Id;
                        // GCD betrifft nur aktiv gewirkte Fähigkeiten (keine Passiven / On-Next-Swing)
                        bool onGcd = !onCooldown && gcdRemaining > 0 && !equipped.IsPassive && !equipped.ReplacesAutoAttack;
                        <AbilityTooltip Ability="_engine.Player.GetEffectiveAbility(equipped)" PlayerLevel="_engine.Player.Level">
                            <span class="ability-slot filled @(onCooldown ? "on-cooldown" : "ready") @(isCasting ? "casting" : "")">
                                <img src="@equipped.IconUrl" alt="@equipped.Name"
                                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22><rect fill=%22%23333%22 width=%2232%22 height=%2232%22 rx=%224%22/></svg>'" />
                                @if (onCooldown)
                                {
                                    <span class="cooldown-overlay">
                                        <span class="cooldown-text">@remaining.ToString("0.#")</span>
                                    </span>
                                }
                                else if (onGcd)
                                {
                                    <span class="gcd-overlay"
                                          style="background: conic-gradient(rgba(0,0,0,.6) @PctStyle(gcdRemaining / IdleGameEngine.GlobalCooldown)%, transparent 0);"></span>
                                }
                            </span>
                        </AbilityTooltip>
                    }
                    else
                    {
                        <span class="ability-slot empty"></span>
                    }
                }
            </div>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  VS INDICATOR                               -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="vs-divider">
        <span>⚔️</span>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ENEMY FRAME  (rechts)                      -->
    <!-- ═══════════════════════════════════════════ -->
        <div class="unit-frame enemy-frame @(_engine.CurrentEnemy?.IsRare == true ? "rare-frame" : "")">
            <div class="combat-text-overlay">
                @foreach (var f in SnapshotFloats(_enemyFloats))
                {
                    <span @key="f.Id" class="combat-text @FloatCssClass(f)"
                          style="left: calc(50% + @(f.XOffset)px); top: @(f.YOffset)px;">@FloatText(f)</span>
                }
            </div>
            <div class="frame-header">
                <div class="portrait-area @(_engine.CurrentEnemy?.IsRare == true ? "rare-portrait-area" : "")">
                    @if (_engine.IsAtSpiritHealer)
                    {
                        <img class="race-portrait enemy-portrait spirit-healer-portrait"
                             src="@SpiritHealerIconUrl"
                             alt="Spirit Healer"
                             onerror="this.src='images/enemy_placeholder.png'" />
                    }
                    else if (_engine.CurrentEnemy is { IsAlive: true } en && !string.IsNullOrEmpty(en.ImageUrl))
                    {
                        <img class="race-portrait enemy-portrait"
                             src="@en.ImageUrl"
                             alt="@en.Name"
                             onerror="this.src='images/enemy_placeholder.png'" />
                    }
                    else
                    {
                        <img class="race-portrait enemy-portrait"
                             src="images/enemy_placeholder.png"
                             alt=""
                             onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2264%22 height=%2264%22><rect fill=%22%23333%22 width=%2264%22 height=%2264%22 rx=%228%22/><text x=%2250%25%22 y=%2255%25%22 text-anchor=%22middle%22 font-size=%2228%22>👹</text></svg>'" />
                    }
                    @if (!_engine.IsAtSpiritHealer && _engine.CurrentEnemy?.IsRare == true)
                    {
                        <!-- Silberner Drachen-Ring (WoW-Classic-Stil für Rare-Gegner) -->
                        <svg class="rare-dragon-ring" xmlns="http://www.w3.org/2000/svg" viewBox="-12 -16 88 96" aria-hidden="true">
                            <!-- Dreifacher Silberring -->
                            <circle cx="32" cy="32" r="37" fill="none" stroke="#7a8e9e" stroke-width="2.5"/>
                            <circle cx="32" cy="32" r="34" fill="none" stroke="#c4d4e0" stroke-width="2"/>
                            <circle cx="32" cy="32" r="30" fill="none" stroke="#4e6070" stroke-width="1"/>
                            <!-- Glanzstreifen oben am Ring -->
                            <path d="M 5 8 A 30 30 0 0 1 59 8" fill="none" stroke="#e4eff8" stroke-width="1.5" opacity="0.55"/>
                            <!-- Linker Flügel -->
                            <path d="M -8 44 C -16 28 -11 6 3 14 C -3 22 -2 34 1 42 Z" fill="#8a9eae" stroke="#b8ccd8" stroke-width="1"/>
                            <path d="M -7 40 C -12 28 -8 14 3 16" fill="none" stroke="#d4e4ee" stroke-width="0.9" opacity="0.7"/>
                            <path d="M -5 34 C -8 24 -4 14 3 16" fill="none" stroke="#d4e4ee" stroke-width="0.7" opacity="0.45"/>
                            <!-- Rechter Flügel -->
                            <path d="M 72 44 C 80 28 75 6 61 14 C 67 22 66 34 63 42 Z" fill="#8a9eae" stroke="#b8ccd8" stroke-width="1"/>
                            <path d="M 71 40 C 76 28 72 14 61 16" fill="none" stroke="#d4e4ee" stroke-width="0.9" opacity="0.7"/>
                            <path d="M 69 34 C 72 24 68 14 61 16" fill="none" stroke="#d4e4ee" stroke-width="0.7" opacity="0.45"/>
                            <!-- Drachenkopf / Krone oben -->
                            <path d="M 24 2 L 27 -5 L 32 -3 L 37 -5 L 40 2 L 36 4 L 28 4 Z" fill="#8a9eae" stroke="#b8ccd8" stroke-width="0.9"/>
                            <!-- Linkes Horn -->
                            <path d="M 26 -4 L 22 -14 L 29 -6 Z" fill="#8a9eae" stroke="#b0c4d0" stroke-width="0.7"/>
                            <!-- Rechtes Horn -->
                            <path d="M 38 -4 L 42 -14 L 35 -6 Z" fill="#8a9eae" stroke="#b0c4d0" stroke-width="0.7"/>
                            <!-- Untere Klauen -->
                            <path d="M 22 67 L 16 75 L 26 71 L 24 68 Z" fill="#8a9eae" stroke="#b0c4d0" stroke-width="0.7"/>
                            <path d="M 30 68 L 29 76 L 35 76 L 34 68 Z" fill="#8a9eae" stroke="#b0c4d0" stroke-width="0.7"/>
                            <path d="M 42 67 L 48 75 L 38 71 L 40 68 Z" fill="#8a9eae" stroke="#b0c4d0" stroke-width="0.7"/>
                        </svg>
                    }
                </div>
            <div class="frame-info">
                @{ var enemyDebuffs = _engine.CurrentEnemy?.Debuffs.Snapshot() ?? new List<ActiveDebuff>(); }
                @if (_engine.IsAtSpiritHealer)
                {
                    <div class="name-line">
                        <span class="char-name spirit-healer-name">Spirit Healer</span>
                    </div>
                    <div class="bar-row">
                        <div class="hp-bar spirit-bar">
                            <div class="spirit-fill"
                                 style="width: @(CalcPct((int)((_engine.RespawnDuration - _engine.RespawnRemaining) * 10), (int)(_engine.RespawnDuration * 10)))%"></div>
                            <span class="bar-text">Resurrecting in @Math.Ceiling(_engine.RespawnRemaining)s</span>
                        </div>
                    </div>
                }
                else if (_engine.CurrentEnemy is { IsAlive: true } enemy)
                {
                    <div class="name-line">
                        <span class="char-name enemy-name @(enemy.IsRare ? "rare-name" : "")">@enemy.Name</span>
                        <span class="level">Lv. @enemy.Stats.Level</span>
                        @if (enemy.IsRare)
                        {
                            <span class="rare-badge">RARE</span>
                        }
                    </div>
                    <div class="bar-row">
                        <div class="hp-bar enemy-hp">
                            <div class="hp-fill"
                                 style="width: @(CalcPct(enemy.CurrentHp, enemy.Stats.MaxHp))%"></div>
                            <span class="bar-text">@enemy.CurrentHp / @enemy.Stats.MaxHp</span>
                        </div>
                    </div>
                    @if (enemyDebuffs.Count > 0)
                    {
                        <div class="buff-bar debuff-bar">
                            @foreach (var debuff in enemyDebuffs)
                            {
                                <AbilityTooltip @key="debuff.Source.Id" Ability="debuff.Source" BuffRemaining="debuff.Remaining">
                                    <span class="buff-icon debuff-icon">
                                        <img src="@debuff.Source.IconUrl" alt="@debuff.Source.Name" onerror="this.style.visibility='hidden'" />
                                        <span class="buff-time @(debuff.Remaining <= 5 ? "expiring" : "")">@FormatBuffTime(debuff.Remaining)</span>
                                    </span>
                                </AbilityTooltip>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="name-line">
                        <span class="char-name enemy-name">Spawning…</span>
                    </div>
                    <div class="bar-row">
                        <div class="hp-bar enemy-hp">
                            <div class="hp-fill" style="width: 0%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@{ var notifications = SnapshotNotifications(); }
@if (notifications.Length > 0)
{
    <div class="ability-notifications">
        @foreach (var n in notifications)
        {
            <div @key="n.Id" class="ability-notification" @onclick="() => EquipAndDismiss(n)">
                <img src="@n.Ability.IconUrl" alt="@n.Ability.Name" class="notif-icon"
                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22><rect fill=%22%23333%22 width=%2232%22 height=%2232%22 rx=%224%22/></svg>'" />
                <div class="notif-text">
                    <span class="notif-title">New Ability Unlocked!</span>
                    <span class="notif-name">
                        @n.Ability.Name
                        @if (_multiRankNames.Contains(n.Ability.Name))
                        {
                            <span class="rank-badge">R@(n.Ability.Rank)</span>
                        }
                    </span>
                </div>
                <span class="notif-close">×</span>
            </div>
        }
    </div>
}

@{ var meter = _engine.Meter.GetSnapshot(); }
<div class="combat-panel">
    <!-- ═══ DAMAGE METER ═══ -->
    <div class="meter-box">
        <div class="meter-header">
            <span class="meter-title">📊 Damage Meter</span>
            <button class="wow-btn small" @onclick="ResetMeter" title="Reset meter">⟲ Reset</button>
        </div>
        <div class="meter-summary">
            <span>DMG <b>@FormatNumber(meter.TotalDamage)</b></span>
            <span>DPS <b>@meter.Dps.ToString("0.0")</b></span>
            <span>Heal <b class="heal-text">@FormatNumber(meter.TotalHealing)</b></span>
            <span>HPS <b class="heal-text">@meter.Hps.ToString("0.0")</b></span>
            <span>⏱ <b>@FormatElapsed(meter.CombatSeconds)</b></span>
        </div>
        @if (meter.Rows.Count == 0)
        {
            <div class="meter-empty">— no combat data yet —</div>
        }
        else
        {
            var topTotal = Math.Max(1, meter.Rows.Max(r => r.Total));
            <div class="meter-rows">
                @foreach (var row in meter.Rows)
                {
                    var kindTotal = row.Kind == CombatActionKind.Heal ? meter.TotalHealing : meter.TotalDamage;
                    var share = kindTotal > 0 ? row.Total * 100.0 / kindTotal : 0;
                    bool isAutoAttack = row.Name == CombatMeter.AutoAttackName;
                    var rowRaw     = isAutoAttack ? null : ClassAbilityRegistry.FindByName(_engine.Player.ActiveClass, row.Name);
                    var rowAbility = rowRaw is null ? null : _engine.Player.GetEffectiveAbility(rowRaw);
                    var rowContent = new RenderFragment(b => {
                        b.OpenElement(0, "div");
                        b.AddAttribute(1, "class", $"meter-row {(row.Kind == CombatActionKind.Heal ? "meter-heal" : "meter-dmg")}");
                        if (!isAutoAttack && rowAbility is null)
                            b.AddAttribute(2, "title", $"{row.Name}: {row.Count} {(row.Name == CombatMeter.SpiritRegenName ? "ticks" : "casts")}, max {row.Max}, avg {(row.Count > 0 ? row.Total / row.Count : 0)}");
                        b.OpenElement(3, "div");
                        b.AddAttribute(4, "class", "meter-fill");
                        b.AddAttribute(5, "style", $"width: {(row.Total * 100.0 / topTotal).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%");
                        b.CloseElement();
                        b.OpenElement(6, "img");
                        b.AddAttribute(7, "class", "meter-icon");
                        b.AddAttribute(8, "src", row.IconUrl);
                        b.AddAttribute(9, "alt", "");
                        b.AddAttribute(10, "onerror", "this.style.visibility='hidden'");
                        b.CloseElement();
                        b.OpenElement(11, "span");
                        b.AddAttribute(12, "class", "meter-name");
                        b.AddContent(13, row.Name);
                        b.CloseElement();
                        b.OpenElement(14, "span");
                        b.AddAttribute(15, "class", "meter-value");
                        b.AddMarkupContent(16, $"{FormatNumber(row.Total)} <small>({share.ToString("0.0")}%)</small>");
                        b.CloseElement();
                        b.CloseElement();
                    });
                    @if (isAutoAttack)
                    {
                        <WeaponTooltip Weapon="_engine.Player.EquippedWeapon" Class="tt-block">
                            @rowContent
                        </WeaponTooltip>
                    }
                    else
                    {
                        <AbilityTooltip Ability="rowAbility" Class="tt-block">
                            @rowContent
                        </AbilityTooltip>
                    }
                }
            </div>
        }
    </div>

    <!-- ═══ ACTION HISTORY ═══ -->
    <div class="meter-box">
        <div class="meter-header">
            <span class="meter-title">📜 Action History</span>
        </div>
        @if (meter.History.Count == 0)
        {
            <div class="meter-empty">— no actions yet —</div>
        }
        else
        {
            <div class="history-list">
                @foreach (var action in meter.History)
                {
                    bool isHeal = action.Kind == CombatActionKind.Heal;
                    <AbilityTooltip @key="action.Id" Ability="ClassAbilityRegistry.FindByName(_engine.Player.ActiveClass, action.Name) is {} histAbility ? _engine.Player.GetEffectiveAbility(histAbility) : null" Class="tt-block">
                        <div class="history-row">
                            <span class="history-time">@FormatElapsed(action.GameTime)</span>
                            <img class="meter-icon" src="@action.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
                            <span class="history-name">@action.Name</span>
                            <span class="history-amount @(isHeal ? "heal-text" : "dmg-text")">
                                @(isHeal ? $"+{action.Amount} HP" : $"{action.Amount} DMG")
                            </span>
                        </div>
                    </AbilityTooltip>
                }
            </div>
        }
    </div>
</div>

    @if (BuildInfo.IsDebug)
    {
        <!-- Platzhalter, damit das fixierte Debug-Panel keinen Inhalt verdeckt -->
        <div class="debug-panel-spacer"></div>
        <div class="wow-card debug-panel">
            <h4 class="debug-title">Debug Info <span class="wow-badge">DEBUG</span></h4>
            <div class="debug-status-row">
                <span>Build: <b>DEBUG</b></span>
                <span>Engine: <b>@(_running ? "🟢 Running" : "🔴 Paused")</b></span>
                <span>⏱ Game-Time: <b>@FormatElapsed(_gameElapsedSeconds)</b></span>
                <span>⚡ Speed: <b>@_speedMultiplier.ToString("0.#")×</b></span>
                <span>Last: @_engine.LastLog</span>
            </div>

            <div class="debug-speed-row">
                <span class="debug-speed-label">Speed:</span>
                @foreach (var s in new[] { 0.25, 0.5, 1.0, 2.0, 5.0, 10.0, 100, 200, 500, 1000, 5000 })
                {
                    <button class="wow-tab @(_speedMultiplier == s ? "active" : "")"
                            @onclick="() => SetSpeed(s)">
                        @s.ToString("0.#")×
                    </button>
                }
            </div>
            <div class="debug-level-row">
                <span class="debug-speed-label">Level:</span>
                <input type="number" min="1" max="60" @bind="_debugTargetLevel" class="debug-level-input" />
                <button class="wow-btn small" @onclick="SetDebugLevel">Set</button>
                <span class="wow-muted">Current: <b>@_engine.Player.Level</b></span>
            </div>
            <div class="debug-level-row">
                <span class="debug-speed-label">Quick:</span>
                @foreach (var lvl in new[] { 1, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60 })
                {
                    <button class="wow-tab @(_engine.Player.Level == lvl ? "active" : "")"
                            @onclick="() => { _debugTargetLevel = lvl; SetDebugLevel(); }">
                        @lvl
                    </button>
                }
            </div>
            @* *@
            @* <div class="debug-columns"> *@
            @*     <!-- ═══ PLAYER STATS ═══ --> *@
            @*     <div class="debug-col"> *@
            @*         <div class="debug-col-header player-header">🧝 Player</div> *@
            @*         <div class="debug-stats-list"> *@
            @*             <span>Name: <b>@_engine.Player.Name</b></span> *@
            @*             <span>Class: <b>@_engine.Player.ActiveClass</b></span> *@
            @*             <span>Race: <b>@_engine.Player.Race</b></span> *@
            @*             <span>Level: <b>@_engine.Player.Stats.Level</b></span> *@
            @*             <span>HP: <b>@_engine.Player.CurrentHp / @_engine.Player.Stats.MaxHp</b></span> *@
            @*             <span>Mana: <b>@_engine.Player.CurrentMana / @_engine.Player.Stats.MaxMana</b></span> *@
            @*             <span>Attack Power: <b>@_engine.Player.Stats.AttackPower</b></span> *@
            @*             <span>Weapon: <b>@_engine.Player.Stats.WeaponMinDamage–@_engine.Player.Stats.WeaponMaxDamage @@ @_engine.Player.Stats.Speed.ToString("0.0#")s</b></span> *@
            @*             <span>Defense: <b>@_engine.Player.Stats.Defense</b></span> *@
            @*             <span>Speed: <b>@_engine.Player.Stats.Speed</b></span> *@
            @*             <span>Strength: <b>@_engine.Player.Stats.Primary.Strength</b></span> *@
            @*             <span>Agility: <b>@_engine.Player.Stats.Primary.Agility</b></span> *@
            @*             <span>Stamina: <b>@_engine.Player.Stats.Primary.Stamina</b></span> *@
            @*             <span>Intelligence: <b>@_engine.Player.Stats.Primary.Intelligence</b></span> *@
            @*             <span>Spirit: <b>@_engine.Player.Stats.Primary.Spirit</b></span> *@
            @*             $1$ <span>Crit Chance: <b>@_engine.Player.Stats.CriticalChance</b>%</span> #1# *@
            @*             $1$ <span>Crit Damage: <b>@_engine.Player.Stats.CriticalDamage</b>%</span> #1# *@
            @*             <span>XP: <b>@_engine.Player.Xp / @_engine.Player.XpToNextLevel</b></span> *@
            @*             <span>Kills: <b>@_engine.TotalKills</b></span> *@
            @*         </div> *@
            @*     </div> *@
            @* *@
            @*     <!-- ═══ ENEMY STATS ═══ --> *@
            @*     <div class="debug-col"> *@
            @*         <div class="debug-col-header enemy-header">👹 Enemy</div> *@
            @*         @if (_engine.IsAtSpiritHealer) *@
            @*         { *@
            @*             <div class="debug-stats-list"> *@
            @*                 <span>Spirit Healer — respawn in <b>@_engine.RespawnRemaining.ToString("0.0")s</b></span> *@
            @*             </div> *@
            @*         } *@
            @*         else if (_engine.CurrentEnemy is { IsAlive: true } dbgEnemy) *@
            @*         { *@
            @*             <div class="debug-stats-list"> *@
            @*                 <span>Name: <b>@dbgEnemy.Name</b></span> *@
            @*                 <span>Level: <b>@dbgEnemy.Stats.Level</b></span> *@
            @*                 <span>HP: <b>@dbgEnemy.CurrentHp / @dbgEnemy.Stats.MaxHp</b></span> *@
            @*                 $1$ <span>Mana: <b>@dbgEnemy.CurrentMana / @dbgEnemy.Stats.MaxMana</b></span> #1# *@
            @*                 <span>Attack: <b>@dbgEnemy.Stats.Attack</b></span> *@
            @*                 <span>Defense: <b>@dbgEnemy.Stats.Defense</b></span> *@
            @*                 <span>Speed: <b>@dbgEnemy.Stats.Speed</b></span> *@
            @*                 $1$ <span>Crit Chance: <b>@dbgEnemy.Stats.CriticalChance</b>%</span> #1# *@
            @*                 $1$ <span>Crit Damage: <b>@dbgEnemy.Stats.CriticalDamage</b>%</span> #1# *@
            @*                 <span>Image: <b>@(string.IsNullOrEmpty(dbgEnemy.ImageUrl) ? "placeholder" : "custom")</b></span> *@
            @*             </div> *@
            @*         } *@
            @*         else *@
            @*         { *@
            @*             <div class="debug-stats-list"> *@
            @*                 <span class="debug-empty">— no active enemy —</span> *@
            @*             </div> *@
            @*         } *@
            @*     </div> *@
            @* </div> *@
        </div>
    }
</div>

<style>
    .battlefield {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 1rem 0;
        padding-left: 94px;   /* Platz für Verbrauchsgüter-Spalte + Spell-Scroll links neben dem Spieler */
    }

    .unit-frame {
        flex: 1;
        min-width: 260px;
        max-width: 420px;
        background: linear-gradient(180deg, #2b2418 0%, #1a150d 100%);
        border: 2px solid #5a4a28;
        border-radius: 8px;
        padding: 10px;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #8a7444;
        position: relative;
        overflow: visible;
    }

    .enemy-frame {
        background: linear-gradient(180deg, #2e1812 0%, #1a0d0a 100%);
        border-color: #6a2e22;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #9a4a34;
    }

    .rare-frame {
        border-color: #7aaabb !important;
        box-shadow: 0 0 22px rgba(120,180,210,.6), inset 0 0 0 1px #b8d0e0 !important;
    }

    .rare-name {
        color: #c8dce8 !important;
        text-shadow: 0 0 8px rgba(160,210,235,0.7) !important;
    }

    .rare-badge {
        font-family: 'Cinzel', serif;
        font-size: 0.6rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        color: #a8c4d4;
        background: rgba(120,180,210,.15);
        border: 1px solid #7aaabb;
        border-radius: 3px;
        padding: 1px 4px;
        text-shadow: 0 0 4px rgba(120,180,210,.55);
    }

    /* Silberner Portraitrand für Rare-Gegner */
    .rare-portrait-area .enemy-portrait {
        border-color: #7aaabb;
        box-shadow: 0 0 12px rgba(100,160,190,0.7);
    }

    /* SVG Drachen-Ring: absolut über dem Portrait positioniert */
    .rare-dragon-ring {
        position: absolute;
        left: -12px;
        top: -16px;
        width: 88px;
        height: 96px;
        pointer-events: none;
        z-index: 3;
        filter: drop-shadow(0 0 4px rgba(140,190,220,.55));
    }

    /* ── Floating Combat Text (WoW style) ── */
    .combat-text-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
        z-index: 10;
    }

    .combat-text {
        position: absolute;
        transform: translateX(-50%);
        font-family: 'Arial Black', 'Impact', 'Segoe UI', sans-serif;
        font-weight: 900;
        font-size: 1.5rem;
        line-height: 1;
        white-space: nowrap;
        letter-spacing: .02em;
        -webkit-text-stroke: 1px #000;
        paint-order: stroke fill;
        text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 0 0 6px rgba(0,0,0,.8);
        animation: combatTextRise 1.5s ease-out forwards;
    }

    /* Auto attack on enemy: white */
    .ct-auto {
        color: #ffffff;
    }

    /* Ability on enemy: yellow, bigger, with "pop" */
    .ct-ability {
        color: #ffd100;
        font-size: 1.9rem;
        animation: combatTextPop 1.6s ease-out forwards;
    }

    /* Damage taken: red */
    .ct-taken {
        color: #ff2020;
    }

    /* Healing: green */
    .ct-heal {
        color: #20ff20;
        font-size: 1.7rem;
        animation: combatTextPop 1.6s ease-out forwards;
    }

    /* Kritischer Treffer: größer, mit goldenem Glühen */
    .ct-crit {
        font-size: 2.4rem;
        -webkit-text-stroke: 1.5px #000;
        text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000,
                     0 0 10px rgba(255,209,0,.9), 0 0 20px rgba(255,140,0,.6);
        animation: combatTextCrit 1.7s ease-out forwards;
    }

    @@keyframes combatTextCrit {
        0%   { transform: translate(-50%, 0) scale(.5); opacity: 0; }
        10%  { transform: translate(-50%, -6px) scale(1.9); opacity: 1; }
        28%  { transform: translate(-50%, -12px) scale(1.1); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(-50%, -70px) scale(1); opacity: 0; }
    }

    @@keyframes combatTextRise {
        0%   { transform: translate(-50%, 0) scale(1.15); opacity: 1; }
        15%  { transform: translate(-50%, -6px) scale(1); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(-50%, -55px) scale(.9); opacity: 0; }
    }

    @@keyframes combatTextPop {
        0%   { transform: translate(-50%, 0) scale(.4); opacity: 0; }
        10%  { transform: translate(-50%, -4px) scale(1.6); opacity: 1; }
        25%  { transform: translate(-50%, -8px) scale(1); opacity: 1; }
        70%  { opacity: 1; }
        100% { transform: translate(-50%, -60px) scale(.95); opacity: 0; }
    }

    .frame-header {
        display: flex;
        gap: 10px;
        align-items: flex-start;
    }

    .portrait-area {
        position: relative;
        width: 64px;
        height: 64px;
        flex-shrink: 0;
    }

    .race-portrait {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        object-fit: cover;
        background: #0e0b07;
        box-shadow: 0 0 8px rgba(0,0,0,.8);
    }

    .enemy-portrait {
        border-color: #b33a2a;
    }

    .class-badge {
        position: absolute;
        bottom: -4px;
        right: -4px;
        width: 24px;
        height: 24px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        background: #0e0b07;
        object-fit: contain;
    }

    /* Totenkopf-Icon beim Tod des Spielers */
    .death-skull {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        border: 2px solid #888;
        object-fit: cover;
        background: #0e0b07;
        box-shadow: 0 0 8px rgba(0,0,0,.8);
        filter: grayscale(30%);
        animation: skull-pulse 2s ease-in-out infinite;
    }

    @@keyframes skull-pulse {
        0%, 100% { opacity: 1; }
        50%       { opacity: 0.65; }
    }

    .frame-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .name-line {
        display: flex;
        align-items: baseline;
        gap: 8px;
        white-space: nowrap;
    }

    .char-name {
        font-family: 'Cinzel', serif;
        font-weight: 700;
        font-size: 1rem;
        color: #ffd100;
        text-shadow: 0 1px 2px #000;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .enemy-name {
        color: #ff6b5b;
    }

    .spirit-healer-name {
        color: #9fd8ff;
    }

    .spirit-healer-portrait {
        filter: drop-shadow(0 0 6px #7fc8ff);
    }

    .spirit-fill {
        height: 100%;
        background: linear-gradient(180deg, #bfe6ff 0%, #4a8fc0 100%);
        transition: width .4s ease;
    }

    .level {
        font-size: .8rem;
        color: #9a8a64;
    }

    .bar-row,
    .xp-row {
        width: 100%;
    }

    .hp-bar, .mana-bar, .xp-bar {
        position: relative;
        height: 20px;
        background: #0e0b07;
        border-radius: 3px;
        overflow: hidden;
        border: 1px solid #5a4a28;
        box-shadow: inset 0 0 4px #000;
    }

    .hp-fill, .mana-fill, .xp-fill {
        height: 100%;
        transition: width .4s ease;
    }

    .hp-fill {
        background: linear-gradient(180deg, #3fbf3f 0%, #1e7a1e 100%);
    }

    /* Schild (Absorb) auf dem Spieler – blau, hinter bzw. über den HP */
    .shield-fill {
        position: absolute;
        top: 0;
        bottom: 0;
        background: linear-gradient(180deg, rgba(120, 200, 255, .85) 0%, rgba(40, 110, 220, .85) 100%);
        box-shadow: inset 0 0 0 1px rgba(190, 230, 255, .6);
        transition: left .4s ease, width .4s ease;
    }

    .shield-text {
        color: #9fd8ff;
    }

    /* ── Pet-Leiste ── */
    .pet-row {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-top: 8px;
    }

    .pet-icon {
        width: 22px;
        height: 22px;
        border: 1px solid #5a4a28;
        border-radius: 3px;
    }

    .hp-bar.pet-hp {
        flex: 1;
        height: 14px;
    }

    /* ── Cast bar / GCD ── */
    .cast-row {
        display: flex;
        flex-direction: column;
        gap: 3px;
        margin-top: 8px;
    }

    .cast-bar {
        position: relative;
        height: 18px;
        background: #0e0b07;
        border: 1px solid #5a4a28;
        border-radius: 3px;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-right: 6px;
        font-size: .72rem;
    }

    .cast-bar.idle {
        opacity: .45;
        justify-content: center;
    }

    .cast-fill {
        position: absolute;
        inset: 0 auto 0 0;
        background: linear-gradient(180deg, #ffd34a 0%, #c98a10 100%);
        transition: width .1s linear;
    }

    .cast-icon {
        position: relative;
        width: 16px;
        height: 16px;
    }

    .cast-name,
    .cast-time {
        position: relative;
        color: #fff;
        text-shadow: 0 1px 2px #000;
    }

    .cast-name {
        flex: 1;
    }

    .cast-idle-text {
        flex: 0;
        color: #9a8a64;
    }

    .cast-time {
        font-variant-numeric: tabular-nums;
    }

    .gcd-bar {
        height: 4px;
        background: #0e0b07;
        border-radius: 2px;
        overflow: hidden;
    }

    .gcd-fill {
        height: 100%;
        background: #c5a55a;
    }

    .gcd-overlay {
        position: absolute;
        inset: 0;
        pointer-events: none;
    }

    .ability-slot.filled.casting {
        border-color: #ffd34a;
        box-shadow: 0 0 10px rgba(255, 211, 74, .8);
    }

    .enemy-hp .hp-fill {
        background: linear-gradient(180deg, #e03a2a 0%, #8b1a1a 100%);
    }

    .mana-bar {
        height: 16px;
    }

    .mana-fill {
        background: linear-gradient(180deg, #3a7fe0 0%, #1a3f9a 100%);
    }

    .mana-bar-rage .mana-fill {
        background: linear-gradient(180deg, #e03a2a 0%, #8b1a1a 100%);
    }

    .mana-bar-energy .mana-fill {
        background: linear-gradient(180deg, #ffe14a 0%, #c99a10 100%);
    }

    .bar-text {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .75rem;
        font-weight: 600;
        color: #fff;
        text-shadow: 0 1px 2px #000;
        font-variant-numeric: tabular-nums;
    }

    .xp-bar {
        height: 14px;
    }

    /* Classic XP bar: purple */
    .xp-fill {
        background: linear-gradient(180deg, #a050e0 0%, #5a1f8a 100%);
    }

    .xp-bar .bar-text {
        font-size: .65rem;
    }

    .vs-divider {
        font-size: 1.6rem;
        flex-shrink: 0;
        filter: drop-shadow(0 0 6px rgba(197,165,90,.5));
    }

    /* ── Buff Bar ── */
    .buff-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 8px;
    }

    .buff-icon {
        display: flex;
        flex-direction: column;
        align-items: center;
        width: 30px;
    }

    .buff-icon img {
        width: 26px;
        height: 26px;
        border-radius: 3px;
        border: 1px solid #c5a55a;
        box-shadow: 0 0 4px rgba(0,0,0,.8);
    }

    .buff-time {
        font-size: .65rem;
        font-weight: 700;
        color: #ffd100;
        text-shadow: 0 1px 2px #000;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }

    .buff-time.expiring {
        color: #ff6b5b;
    }

    /* ── Debuff Bar (on enemy) ── */
    .debuff-bar {
        margin-top: 4px;
    }

    .debuff-icon img {
        border-color: #c03020;
        box-shadow: 0 0 4px rgba(200, 50, 50, .5);
    }

    /* ── Ability Bar ── */
    .ability-bar {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;
        gap: 6px;
        margin-top: 10px;
        padding-top: 8px;
        border-top: 1px solid #5a4a28;
    }

    /* ── Auto-Attack-Slot ── */
    .ability-bar-divider {
        width: 1px;
        align-self: stretch;
        background: #5a4a28;
        margin: 0 2px;
    }

    .swing-fill {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(0deg, rgba(255, 209, 0, .45) 0%, rgba(255, 209, 0, .15) 100%);
        border-top: 1px solid rgba(255, 230, 120, .9);
        pointer-events: none;
        transition: height .1s linear;
    }

    .auto-attack-slot.held img {
        opacity: .4;
        filter: grayscale(.9);
    }

    .auto-attack-slot.held .swing-fill {
        background: rgba(120, 120, 120, .35);
        border-top-color: #888;
    }

    .swing-held-mark {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: .7rem;
        color: #ffd100;
        text-shadow: 0 1px 3px #000;
        pointer-events: none;
    }

    /* ── Spell-Scroll: zuletzt ausgelöster Spell fliegt links neben dem Charakter nach oben ── */
    /* Verbrauchsgüter direkt links am Spieler-Frame, Spell-Scroll weiter außen */
    .consumable-dock {
        position: absolute;
        right: calc(100% + 6px);
        top: 0;
        bottom: 0;
        z-index: 6;
    }

    .spell-scroll {
        position: absolute;
        right: calc(100% + 48px);
        top: 0;
        bottom: 0;
        width: 44px;
        pointer-events: none;
        z-index: 5;
    }

    .spell-scroll-icon {
        position: absolute;
        left: 0;
        bottom: 0;
        width: 44px;
        height: 44px;
        border: 2px solid #c5a55a;
        border-radius: 6px;
        box-shadow: 0 0 10px rgba(255, 209, 0, .5), 0 2px 6px #000;
        animation: spellScrollUp 1.5s ease-out forwards;
    }

    @@keyframes spellScrollUp {
        0%   { transform: translateY(0) scale(.7); opacity: 0; }
        12%  { transform: translateY(-10%) scale(1.1); opacity: 1; }
        25%  { transform: translateY(-25%) scale(1); opacity: 1; }
        100% { transform: translateY(-260%); opacity: 0; }
    }

    .ability-slot {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 38px;
        height: 38px;
        border-radius: 4px;
        border: 2px solid #4a3d22;
        background: #0e0b07;
        box-shadow: inset 0 0 6px #000;
        overflow: hidden;
        position: relative;
    }

    .ability-slot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        transition: opacity .25s, filter .25s;
    }

    .ability-slot.filled {
        border-color: #8a7444;
    }

    .ability-slot.filled:hover {
        border-color: #ffd100;
        box-shadow: 0 0 8px rgba(255, 209, 0, .45);
    }

    .ability-slot.empty {
        border-style: dashed;
        background: transparent;
        box-shadow: none;
    }

    /* ── Cooldown state ── */
    .ability-slot.on-cooldown {
        border-color: #4a3d22;
    }

    .ability-slot.on-cooldown img {
        opacity: 0.35;
        filter: grayscale(0.9);
    }

    .cooldown-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        pointer-events: none;
    }

    .cooldown-text {
        font-size: 0.75rem;
        font-weight: 800;
        color: #ffd100;
        text-shadow: 0 1px 3px #000;
        font-variant-numeric: tabular-nums;
    }

    /* ── Ready glow ── */
    .ability-slot.ready {
        border-color: #c5a55a;
        box-shadow: 0 0 6px rgba(197, 165, 90, .45);
    }

    /* ── Damage Meter / Action History ── */
    .combat-panel {
        display: flex;
        gap: 12px;
        margin-bottom: 1rem;
    }

    .meter-box {
        flex: 1;
        min-width: 0;
        padding: 10px 12px;
        background: linear-gradient(180deg, #2b2418 0%, #1a150d 100%);
        border: 2px solid #5a4a28;
        border-radius: 8px;
        box-shadow: 0 4px 14px rgba(0,0,0,.5), inset 0 0 0 1px #8a7444;
        font-size: .8rem;
        color: #c9b88c;
    }

    .meter-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 6px;
