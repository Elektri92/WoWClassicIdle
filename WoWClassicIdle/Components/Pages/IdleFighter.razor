@page "/idle"
@rendermode InteractiveServer
@using Models
@using Services
@inject IdleGameEngine _engine
@inject IAbilityLoadoutService _loadoutService
@inject IJSRuntime _js
@implements IAsyncDisposable

<PageTitle>Idle Fighter</PageTitle>

<div class="wow-page narrow idle-page">
<h2>Idle Fighter</h2>
<p class="wow-hint">Your character fights on its own – watch the battle, the damage meter and the action log.</p>

<div class="battlefield">
    <!-- ═══════════════════════════════════════════ -->
    <!--  PLAYER FRAME  (links)                     -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="unit-frame player-frame">
        <div class="combat-text-overlay">
            @foreach (var f in SnapshotFloats(_playerFloats))
            {
                <span @key="f.Id" class="combat-text @FloatCssClass(f)"
                      style="left: calc(50% + @(f.XOffset)px); top: @(f.YOffset)px;">@FloatText(f)</span>
            }
        </div>
        <div class="frame-header">
            <div class="portrait-area">
                <img class="race-portrait"
                     src="@IconUrls.RaceIconUrl(_engine.Player.Race, _engine.Gender)"
                     alt="" onerror="this.style.display='none'" />
                <img class="class-badge"
                     src="@IconUrls.ClassIconUrl(_engine.Player.ActiveClass)"
                     alt="" onerror="this.style.display='none'" />
            </div>
            <div class="frame-info">
                <div class="name-line">
                    <span class="char-name">@_engine.Player.Name</span>
                    <span class="level">Lv. @_engine.Player.Stats.Level</span>
                </div>
                <div class="bar-row">
                    <div class="hp-bar">
                        <div class="hp-fill"
                             style="width: @(CalcPct(_engine.Player.CurrentHp, _engine.Player.Stats.MaxHp))%"></div>
                        <span class="bar-text">@_engine.Player.CurrentHp / @_engine.Player.Stats.MaxHp</span>
                    </div>
                </div>
                <div class="bar-row">
                    @{ int effectiveMaxMana = _engine.Player.Stats.MaxMana + _engine.Player.Buffs.BonusMaxMana; }
                    <div class="mana-bar mana-bar-@(_engine.Player.ActiveClass.ToString().ToLowerInvariant())">
                        <div class="mana-fill"
                             style="width: @(CalcPct(_engine.Player.CurrentMana, effectiveMaxMana))%"></div>
                        <span class="bar-text">@_engine.Player.CurrentMana / @effectiveMaxMana</span>
                    </div>
                </div>
                <div class="xp-row">
                    <div class="xp-bar">
                        <div class="xp-fill"
                             style="width: @(CalcPct(_engine.Player.Xp, _engine.Player.XpToNextLevel))%"></div>
                        <span class="bar-text">@_engine.Player.Xp / @_engine.Player.XpToNextLevel</span>
                    </div>
                </div>
            </div>
        </div>

            <!-- ═══ ACTIVE BUFFS ═══ -->
            @{ var buffs = _engine.Player.Buffs.Snapshot(); }
            @if (buffs.Count > 0)
            {
                <div class="buff-bar">
                    @foreach (var buff in buffs)
                    {
                        <AbilityTooltip @key="buff.Source.Id" Ability="buff.Source" BuffRemaining="buff.Remaining">
                            <span class="buff-icon">
                                <img src="@buff.Source.IconUrl" alt="@buff.Source.Name" onerror="this.style.visibility='hidden'" />
                                <span class="buff-time @(buff.Remaining <= 5 ? "expiring" : "")">@FormatBuffTime(buff.Remaining)</span>
                            </span>
                        </AbilityTooltip>
                    }
                </div>
            }

            <!-- ═══ EQUIPPED ABILITIES ═══ -->
            <div class="ability-bar">
                @for (int i = 0; i < ClassAbilityRegistry.MaxSlotsPerClass; i++)
                {
                    var equipped = i < _engine.Player.EquippedAbilities.Count
                        ? _engine.Player.EquippedAbilities[i]
                        : null;

                    @if (equipped != null)
                    {
                        double remaining = _engine.Player.Cooldowns.GetRemaining(equipped.Id);
                        bool onCooldown = remaining > 0;
                        <AbilityTooltip Ability="_engine.Player.GetEffectiveAbility(equipped)" PlayerLevel="_engine.Player.Level">
                            <span class="ability-slot filled @(onCooldown ? "on-cooldown" : "ready")">
                                <img src="@equipped.IconUrl" alt="@equipped.Name"
                                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22><rect fill=%22%23333%22 width=%2232%22 height=%2232%22 rx=%224%22/></svg>'" />
                                @if (onCooldown)
                                {
                                    <span class="cooldown-overlay">
                                        <span class="cooldown-text">@remaining.ToString("0.#")</span>
                                    </span>
                                }
                            </span>
                        </AbilityTooltip>
                    }
                    else
                    {
                        <span class="ability-slot empty"></span>
                    }
                }
            </div>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  VS INDICATOR                               -->
    <!-- ═══════════════════════════════════════════ -->
    <div class="vs-divider">
        <span>⚔️</span>
    </div>

    <!-- ═══════════════════════════════════════════ -->
    <!--  ENEMY FRAME  (rechts)                      -->
    <!-- ═══════════════════════════════════════════ -->
        <div class="unit-frame enemy-frame @(_engine.CurrentEnemy?.IsRare == true ? "rare-frame" : "")">
            <div class="combat-text-overlay">
                @foreach (var f in SnapshotFloats(_enemyFloats))
                {
                    <span @key="f.Id" class="combat-text @FloatCssClass(f)"
                          style="left: calc(50% + @(f.XOffset)px); top: @(f.YOffset)px;">@FloatText(f)</span>
                }
            </div>
            <div class="frame-header">
                <div class="portrait-area">
                    @if (_engine.IsAtSpiritHealer)
                    {
                        <img class="race-portrait enemy-portrait spirit-healer-portrait"
                             src="@SpiritHealerIconUrl"
                             alt="Spirit Healer"
                             onerror="this.src='images/enemy_placeholder.png'" />
                    }
                    else if (_engine.CurrentEnemy is { IsAlive: true } en && !string.IsNullOrEmpty(en.ImageUrl))
                    {
                        <img class="race-portrait enemy-portrait"
                             src="@en.ImageUrl"
                             alt="@en.Name"
                             onerror="this.src='images/enemy_placeholder.png'" />
                    }
                    else
                    {
                        <img class="race-portrait enemy-portrait"
                             src="images/enemy_placeholder.png"
                             alt=""
                             onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2264%22 height=%2264%22><rect fill=%22%23333%22 width=%2264%22 height=%2264%22 rx=%228%22/><text x=%2250%25%22 y=%2255%25%22 text-anchor=%22middle%22 font-size=%2228%22>👹</text></svg>'" />
                    }
                </div>
            <div class="frame-info">
                @{ var enemyDebuffs = _engine.CurrentEnemy?.Debuffs.Snapshot() ?? new List<ActiveDebuff>(); }
                @if (_engine.IsAtSpiritHealer)
                {
                    <div class="name-line">
                        <span class="char-name spirit-healer-name">Spirit Healer</span>
                    </div>
                    <div class="bar-row">
                        <div class="hp-bar spirit-bar">
                            <div class="spirit-fill"
                                 style="width: @(CalcPct((int)((_engine.RespawnDuration - _engine.RespawnRemaining) * 10), (int)(_engine.RespawnDuration * 10)))%"></div>
                            <span class="bar-text">Resurrecting in @Math.Ceiling(_engine.RespawnRemaining)s</span>
                        </div>
                    </div>
                }
                else if (_engine.CurrentEnemy is { IsAlive: true } enemy)
                {
                    <div class="name-line">
                        <span class="char-name enemy-name @(enemy.IsRare ? "rare-name" : "")">@enemy.Name</span>
                        <span class="level">Lv. @enemy.Stats.Level</span>
                        @if (enemy.IsRare)
                        {
                            <span class="rare-badge">RARE</span>
                        }
                    </div>
                    <div class="bar-row">
                        <div class="hp-bar enemy-hp">
                            <div class="hp-fill"
                                 style="width: @(CalcPct(enemy.CurrentHp, enemy.Stats.MaxHp))%"></div>
                            <span class="bar-text">@enemy.CurrentHp / @enemy.Stats.MaxHp</span>
                        </div>
                    </div>
                    @if (enemyDebuffs.Count > 0)
                    {
                        <div class="buff-bar debuff-bar">
                            @foreach (var debuff in enemyDebuffs)
                            {
                                <AbilityTooltip @key="debuff.Source.Id" Ability="debuff.Source" BuffRemaining="debuff.Remaining">
                                    <span class="buff-icon debuff-icon">
                                        <img src="@debuff.Source.IconUrl" alt="@debuff.Source.Name" onerror="this.style.visibility='hidden'" />
                                        <span class="buff-time @(debuff.Remaining <= 5 ? "expiring" : "")">@FormatBuffTime(debuff.Remaining)</span>
                                    </span>
                                </AbilityTooltip>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="name-line">
                        <span class="char-name enemy-name">Spawning…</span>
                    </div>
                    <div class="bar-row">
                        <div class="hp-bar enemy-hp">
                            <div class="hp-fill" style="width: 0%"></div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@{ var notifications = SnapshotNotifications(); }
@if (notifications.Length > 0)
{
    <div class="ability-notifications">
        @foreach (var n in notifications)
        {
            <div @key="n.Id" class="ability-notification" @onclick="() => EquipAndDismiss(n)">
                <img src="@n.Ability.IconUrl" alt="@n.Ability.Name" class="notif-icon"
                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2232%22 height=%2232%22><rect fill=%22%23333%22 width=%2232%22 height=%2232%22 rx=%224%22/></svg>'" />
                <div class="notif-text">
                    <span class="notif-title">New Ability Unlocked!</span>
                    <span class="notif-name">
                        @n.Ability.Name
                        @if (_multiRankNames.Contains(n.Ability.Name))
                        {
                            <span class="rank-badge">R@(n.Ability.Rank)</span>
                        }
                    </span>
                </div>
                <span class="notif-close">×</span>
            </div>
        }
    </div>
}

@{ var meter = _engine.Meter.GetSnapshot(); }
<div class="combat-panel">
    <!-- ═══ DAMAGE METER ═══ -->
    <div class="meter-box">
        <div class="meter-header">
            <span class="meter-title">📊 Damage Meter</span>
            <button class="wow-btn small" @onclick="ResetMeter" title="Reset meter">⟲ Reset</button>
        </div>
        <div class="meter-summary">
            <span>DMG <b>@FormatNumber(meter.TotalDamage)</b></span>
            <span>DPS <b>@meter.Dps.ToString("0.0")</b></span>
            <span>Heal <b class="heal-text">@FormatNumber(meter.TotalHealing)</b></span>
            <span>HPS <b class="heal-text">@meter.Hps.ToString("0.0")</b></span>
            <span>⏱ <b>@FormatElapsed(meter.CombatSeconds)</b></span>
        </div>
        @if (meter.Rows.Count == 0)
        {
            <div class="meter-empty">— no combat data yet —</div>
        }
        else
        {
            var topTotal = Math.Max(1, meter.Rows.Max(r => r.Total));
            <div class="meter-rows">
                @foreach (var row in meter.Rows)
                {
                    var kindTotal = row.Kind == CombatActionKind.Heal ? meter.TotalHealing : meter.TotalDamage;
                    var share = kindTotal > 0 ? row.Total * 100.0 / kindTotal : 0;
                    bool isAutoAttack = row.Name == CombatMeter.AutoAttackName;
                    var rowRaw     = isAutoAttack ? null : ClassAbilityRegistry.FindByName(_engine.Player.ActiveClass, row.Name);
                    var rowAbility = rowRaw is null ? null : _engine.Player.GetEffectiveAbility(rowRaw);
                    var rowContent = new RenderFragment(b => {
                        b.OpenElement(0, "div");
                        b.AddAttribute(1, "class", $"meter-row {(row.Kind == CombatActionKind.Heal ? "meter-heal" : "meter-dmg")}");
                        if (!isAutoAttack && rowAbility is null)
                            b.AddAttribute(2, "title", $"{row.Name}: {row.Count} casts, max {row.Max}, avg {(row.Count > 0 ? row.Total / row.Count : 0)}");
                        b.OpenElement(3, "div");
                        b.AddAttribute(4, "class", "meter-fill");
                        b.AddAttribute(5, "style", $"width: {(row.Total * 100.0 / topTotal).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}%");
                        b.CloseElement();
                        b.OpenElement(6, "img");
                        b.AddAttribute(7, "class", "meter-icon");
                        b.AddAttribute(8, "src", row.IconUrl);
                        b.AddAttribute(9, "alt", "");
                        b.AddAttribute(10, "onerror", "this.style.visibility='hidden'");
                        b.CloseElement();
                        b.OpenElement(11, "span");
                        b.AddAttribute(12, "class", "meter-name");
                        b.AddContent(13, row.Name);
                        b.CloseElement();
                        b.OpenElement(14, "span");
                        b.AddAttribute(15, "class", "meter-value");
                        b.AddMarkupContent(16, $"{FormatNumber(row.Total)} <small>({share.ToString("0.0")}%)</small>");
                        b.CloseElement();
                        b.CloseElement();
                    });
                    @if (isAutoAttack)
                    {
                        <WeaponTooltip Weapon="_engine.Player.EquippedWeapon" Class="tt-block">
                            @rowContent
                        </WeaponTooltip>
                    }
                    else
                    {
                        <AbilityTooltip Ability="rowAbility" Class="tt-block">
                            @rowContent
                        </AbilityTooltip>
                    }
                }
            </div>
        }
    </div>

    <!-- ═══ ACTION HISTORY ═══ -->
    <div class="meter-box">
        <div class="meter-header">
            <span class="meter-title">📜 Action History</span>
        </div>
        @if (meter.History.Count == 0)
        {
            <div class="meter-empty">— no actions yet —</div>
        }
        else
        {
            <div class="history-list">
                @foreach (var action in meter.History)
                {
                    bool isHeal = action.Kind == CombatActionKind.Heal;
                    <AbilityTooltip @key="action.Id" Ability="ClassAbilityRegistry.FindByName(_engine.Player.ActiveClass, action.Name) is {} histAbility ? _engine.Player.GetEffectiveAbility(histAbility) : null" Class="tt-block">
                        <div class="history-row">
                            <span class="history-time">@FormatElapsed(action.GameTime)</span>
                            <img class="meter-icon" src="@action.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
                            <span class="history-name">@action.Name</span>
                            <span class="history-amount @(isHeal ? "heal-text" : "dmg-text")">
                                @(isHeal ? $"+{action.Amount} HP" : $"{action.Amount} DMG")
                            </span>
                        </div>
                    </AbilityTooltip>
                }
            </div>
        }
    </div>
</div>

    @if (BuildInfo.IsDebug)
