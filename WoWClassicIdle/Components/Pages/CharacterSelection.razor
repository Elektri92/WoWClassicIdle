@page "/character"
@using Models
@inject IdleGameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Character Selection</PageTitle>

@* Styles: wwwroot/css/character-select.css – gleicher Look wie die Unit-Frames und Kampf-Hintergründe in /idle *@
<div class="wow-page narrow character-selection">
    <h2 class="cs-title">Character Selection</h2>
    <p class="wow-hint cs-hint">@(showCreation ? "Name your new hero and pick race, gender and class." : "Choose a hero to continue the fight, or create a new one.")</p>

    @* ── Existing characters (ausgeblendet, solange die Erstellung offen ist) ── *@
    @if (Engine.CharacterRoster.Count > 0 && !showCreation)
    {
        @* Fraktionen nebeneinander: Alliance links, Horde rechts – jeweils auf ihrem Banner *@
        <div class="cs-factions">
        @foreach (var side in new[] { Faction.Alliance, Faction.Horde })
        {
            var sideSlots = Engine.CharacterRoster.Where(s => s.Faction == side).ToList();
            string sideCss = side == Faction.Alliance ? "alliance" : "horde";
            int index = 0;

            <div class="cs-faction-col @sideCss" style="--col: @(side == Faction.Alliance ? 0 : 1)">
                <h3 class="cs-faction-title @(sideCss)-color">
                    <img src="@IconUrls.FactionIconUrl(side)" alt="" aria-hidden="true" onerror="this.remove()" />
                    @side
                </h3>
                <div class="cs-bannered @sideCss">
            @if (sideSlots.Count == 0)
            {
                <div class="cs-banner-empty">No @side heroes yet</div>
            }
            @foreach (var slot in sideSlots)
            {
                bool isActive = slot.Id == Engine.ActiveCharacter?.Id;
                bool isPicked = slot.Id == PickedSlot?.Id;
                var zone = CombatZoneRegistry.Get(slot.CombatZoneId);
                string theme = zone?.Theme ?? StartZone(slot.Race)?.Theme ?? "grassland";
                int xpPct = slot.Player.XpToNextLevel > 0
                    ? Math.Clamp(slot.Player.Xp * 100 / slot.Player.XpToNextLevel, 0, 100)
                    : 100;

                <div @key="slot.Id"
                     class="cs-card @(slot.Faction == Faction.Alliance ? "alliance-card" : "horde-card") @(isActive ? "active-card" : "") @(isPicked ? "picked-card" : "") @(CombatZoneRegistry.IsNightTheme(theme) ? "night" : "day")"
                     style="--i: @(index++)"
                     title="Double-click to play"
                     @onclick="() => PickCharacter(slot)"
                     @ondblclick="() => PlayCharacter(slot)">
                    <div class="cs-scenery" aria-hidden="true">
                        <div class="cs-sky zone-theme-@theme"></div>
                        <div class="battle-mountains zone-theme-@theme"></div>
                        <div class="battle-hills zone-theme-@theme"></div>
                    </div>
                    <div class="cs-sheen" aria-hidden="true"></div>
                    @* Volkswappen als Wasserzeichen rechts auf der Karte *@
                    <img class="cs-card-crest" src="@IconUrls.RaceCrestUrl(slot.Race)" alt="" aria-hidden="true" onerror="this.remove()" />

                    <div class="cs-frame">
                        <div class="portrait-area">
                            <img class="race-portrait" src="@IconUrls.RaceIconUrl(slot.Race, slot.Gender)" alt="@slot.Race" onerror="this.style.display='none'" />
                            <img class="class-badge" src="@IconUrls.ClassIconUrl(slot.Class)" alt="@slot.Class" onerror="this.style.display='none'" />
                            @if (slot.Player.ProfessionState.Primary is { } primary)
                            {
                                <img class="profession-badge"
                                     src="@primary.Definition.IconUrl"
                                     alt="@primary.Definition.Name"
                                     title="@($"{primary.Definition.Name} ({primary.Skill}/{primary.SkillCap})")"
                                     onerror="this.remove()" />
                            }
                        </div>
                        <div class="cs-frame-info">
                            <div class="cs-name-line">
                                <span class="char-name">@IdleGameEngine.CharacterName(slot)</span>
                                <span class="cs-level">Lv. @slot.Player.Level</span>
                                @if (isActive)
                                {
                                    <span class="cs-active-badge">Active</span>
                                }
                            </div>
                            <div class="cs-xp-bar" title="@($"{slot.Player.Xp} / {slot.Player.XpToNextLevel} XP")">
                                <div class="cs-xp-fill" style="width: @(xpPct)%"></div>
                                <span class="cs-bar-text">@xpPct% XP</span>
                            </div>
                            <div class="char-card-sub">
                                @if (!string.IsNullOrWhiteSpace(slot.Name))
                                {
                                    <span class="char-race">@slot.Race</span>
                                    <span class="char-class class-@slot.Class.ToString().ToLowerInvariant()">@slot.Class</span>
                                    <span>&nbsp;·&nbsp;</span>
                                }
                                @slot.Gender &nbsp;·&nbsp;
                                @if (slot.Travel is { } travel)
                                {
                                    <span class="cs-zone traveling">Traveling to @(CombatZoneRegistry.Get(travel.TargetZoneId)?.Name)</span>
                                }
                                else
                                {
                                    <span class="cs-zone">@(zone?.Name ?? "No zone chosen")</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
                </div>
            </div>
        }
        </div>

        @* Aktionen für den per Klick gewählten Charakter; @key spielt beim Wechsel die Einblendung neu ab *@
        @if (PickedSlot is { } picked)
        {
            <div @key="picked.Id" class="cs-pick-bar @(picked.Faction == Faction.Alliance ? "alliance" : "horde") race-@picked.Race.ToString().ToLowerInvariant()">
                <img class="cs-pick-crest" src="@IconUrls.RaceCrestUrl(picked.Race)" alt="" aria-hidden="true" onerror="this.remove()" />
                <div class="cs-pick-info">
                    <span class="cs-pick-name">@IdleGameEngine.CharacterName(picked)</span>
                    <span class="cs-pick-sub">
                        Level @picked.Player.Level @picked.Race
                        <span class="class-@picked.Class.ToString().ToLowerInvariant()">@picked.Class</span>
                    </span>
                </div>
                <div class="cs-pick-actions">
                    <button class="wow-btn cs-pick-edit" @onclick="() => EditCharacter(picked)">Edit</button>
                    <button class="wow-btn primary cs-pick-play" @onclick="() => PlayCharacter(picked)">Play</button>
                </div>
            </div>
        }

        <div class="new-char-toggle-row">
            <button class="wow-btn primary new-char-toggle" @onclick="ToggleCreation">
                <span>Create New Character</span>
            </button>
        </div>

        @if (BuildInfo.IsDebug)
        {
            <div class="debug-all-level-row">
                <span class="wow-badge">DEBUG</span>
                <span class="debug-all-level-label">Set all to level:</span>
                @foreach (var lvl in new[] { 1, 5, 10, 15, 20, 25, 30, 35, 40, 45, 50, 55, 60 })
                {
                    <button class="wow-tab @(Engine.CharacterRoster.All(s => s.Player.Level == lvl) ? "active" : "")"
                            @onclick="() => Engine.SetAllCharactersLevel(lvl)">
                        @lvl
                    </button>
                }
            </div>
        }
    }

    @* ── Creation form: Panels in den Wappenfarben der gewählten Rasse (Palette aus inventory-crest.css) ── *@
    @if (showCreation)
    {
        var faction = GetFactionForRace(selectedRace);
        string raceCss = selectedRace.ToString().ToLowerInvariant();

        <div class="cs-stage @(faction == Faction.Alliance ? "alliance" : "horde") race-@raceCss">
            @* @key: Bei jeder Rassenwahl neu erzeugt – der Schimmer läuft einmal über die Bühne *@
            <div @key="selectedRace" class="cs-pick-wave" aria-hidden="true"></div>

            <div class="unit-frame cs-panel cs-map" style="--i: 0">
                @* Hauptstadt der Fraktion; @key blendet beim Fraktionswechsel die neue Karte ein *@
                <div @key="faction" class="cs-map-layer capital-@(faction == Faction.Alliance ? "stormwind" : "orgrimmar")" aria-hidden="true"></div>
                <h4>Name</h4>
                <div class="cs-name-input-row">
                    <input type="text" class="cs-name-input @(nameError is not null ? "invalid" : "")"
                           placeholder="Enter a name"
                           maxlength="@CharacterNames.MaxLength"
                           autocomplete="off" spellcheck="false"
                           @bind="characterName" @bind:event="oninput" @bind:after="OnNameChanged"
                           @onkeydown="OnNameKeyDown" />
                </div>
                @if (nameError is not null)
                {
                    <div class="cs-name-error">@nameError</div>
                }
            </div>

            <div class="unit-frame cs-panel cs-map" style="--i: 1">
                <div class="cs-map-layer world" aria-hidden="true"></div>
                <h4>Race</h4>
                <div class="race-row">
                    @foreach (var (side, races) in new[] { (Faction.Alliance, AllianceRaces), (Faction.Horde, HordeRaces) })
                    {
                        string sideCss = side == Faction.Alliance ? "alliance" : "horde";
                        <div class="race-column @sideCss">
                            <h3 class="race-column-title @(sideCss)-title">
                                <img src="@IconUrls.FactionIconUrl(side)" alt="" aria-hidden="true" onerror="this.remove()" />
                                @side
                            </h3>
                            <div class="race-buttons cs-bannered @sideCss">
                                @foreach (var race in races)
                                {
                                    <button class="wow-btn wow-btn-icon @(selectedRace == race ? "active" : "")"
                                            @onclick="() => SetRace(race)">
                                        <img src="@IconUrls.RaceIconUrl(race, selectedGender)" alt="" onerror="this.remove()" />
                                        <span>@race</span>
                                        <img class="race-btn-crest" src="@IconUrls.RaceCrestUrl(race)" alt="" aria-hidden="true" onerror="this.remove()" />
                                        @if (selectedRace == race && quoteText is not null && !quoteFromClass)
                                        {
                                            <span @key="quoteKey" class="cs-quote">@quoteText</span>
                                        }
                                    </button>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="unit-frame cs-panel" style="--i: 2">
                <h4>Gender</h4>
                <div class="wow-button-group centered">
                    @foreach (var gender in new[] { Gender.Male, Gender.Female })
                    {
                        <button class="wow-btn wow-btn-icon @(selectedGender == gender ? "active" : "")"
                                @onclick="() => SetGender(gender)">
                            <img src="@IconUrls.RaceIconUrl(selectedRace, gender)" alt="" onerror="this.remove()" />
                            <span>@gender</span>
                        </button>
                    }
                </div>
            </div>

            <div class="unit-frame cs-panel" style="--i: 3">
                <h4>Class</h4>
                <div class="wow-button-group centered">
                    @foreach (CharacterClass cls in Enum.GetValues(typeof(CharacterClass)))
                    {
                        bool available = RaceClassInfo.GetAvailableClasses(selectedRace).Contains(cls);
                        <button class="wow-btn wow-btn-icon @(selectedClass == cls && available ? "active" : "") @(available ? "" : "disabled")"
                                disabled="@(!available)"
                                @onclick="() => SetClass(cls)">
                            <img src="@IconUrls.ClassIconUrl(cls)" alt="" onerror="this.remove()" />
                            <span class="class-@cls.ToString().ToLowerInvariant()">@cls</span>
                            @if (selectedClass == cls && quoteText is not null && quoteFromClass)
                            {
                                <span @key="quoteKey" class="cs-quote">@quoteText</span>
                            }
                        </button>
                    }
                </div>
            </div>

            @if (!string.IsNullOrEmpty(errorMsg))
            {
                <div class="wow-alert error cs-error">@errorMsg</div>
            }

            <div class="creation-confirm-row">
                @if (Engine.CharacterRoster.Count > 0)
                {
                    <button class="wow-btn primary cs-back-btn" @onclick="ToggleCreation">
                        <span>Back</span>
                    </button>
                }
                <button class="wow-btn primary confirm-btn" disabled="@(CharacterNames.Validate(characterName) is not null)"
                        title="@(CharacterNames.Validate(characterName) ?? "")"
                        @onclick="ConfirmAndPlay">
                    <img class="btn-icon" src="@IconUrls.ClassIconUrl(selectedClass)" alt="" aria-hidden="true" onerror="this.remove()" />
                    <span>Play as @PreviewName</span>
                </button>
            </div>
        </div>
    }
</div>

