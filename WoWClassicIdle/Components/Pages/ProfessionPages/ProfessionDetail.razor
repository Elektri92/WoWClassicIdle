@page "/professions/{Slug}"
@using Models
@inject IdleGameEngine Engine
@implements IDisposable

<PageTitle>@(_def?.Name ?? "Profession")</PageTitle>

@* Styles: wwwroot/css/professions.css – panels (.al-panel) from ability-loadout.css *@
<div class="wow-page narrow professions-page prof-detail-page">
    <a class="prof-back" href="professions">← Professions</a>

    <div class="prof-detail-layout">
    @* Quick select: all professions stacked, click jumps directly into the profession *@
    <nav class="prof-quick">
        @{ int quickIndex = 0; }
        @foreach (var group in new[] { Professions.All.Where(d => d.IsGathering), Professions.All.Where(d => !d.IsGathering) })
        {
            @foreach (var def in group)
            {
                var owner = def.IsPrimary ? Engine.ProfessionOwner(def.Profession) : null;
                <a class="prof-quick-item @(def == _def ? "current" : "")" href="professions/@def.Slug" style="--i: @(quickIndex++)"
                   title="@(owner is not null ? $"{def.Name} – {IdleGameEngine.CharacterName(owner)}" : def.Name)">
                    <img src="@def.IconUrl" alt="@def.Name" onerror="this.style.visibility='hidden'" />
                    @if (owner is not null)
                    {
                        <img class="prof-quick-owner" src="@IconUrls.ClassIconUrl(owner.Class)" alt="" onerror="this.remove()" />
                    }
                    @if (Engine.CanImproveBonuses(def.Profession))
                    {
                        <span class="prof-bonus-dot"></span>
                    }
                </a>
            }
            <div class="prof-quick-sep"></div>
        }
    </nav>

    <div class="prof-detail-main">

    @if (_def is null)
    {
        <div class="wow-alert error">Unknown profession.</div>
    }
    else if (!Engine.HasActiveCharacter || !Engine.ProfessionsUnlockedOnAccount)
    {
        <h2>@_def.Name</h2>
        <div class="wow-alert warning">Professions unlock at level @Professions.MinCharacterLevel.</div>
    }
    else
    {
        var progress = Engine.GetProfessionProgress(_def.Profession);
        var trainer = ProfessionTrainerRegistry.Get(_def.Profession);

        <div class="al-panel prof-header prof-bg-@_def.Slug prof-map-bg">
            @* Transparent map in the background: gathering professions a random zone, crafting professions the faction capital *@
            <div class="prof-map" aria-hidden="true"
                 style="background-image: url('@(_def.IsGathering ? _gatheringMap : IconUrls.CapitalMapUrl(Engine.Faction))')"></div>
            <div class="prof-sweep" aria-hidden="true"></div>
            <img class="prof-icon large" src="@_def.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
            <div class="prof-card-body">
                <div class="prof-title-row">
                    <div>
                        <h2>@_def.Name</h2>
                        <div class="prof-card-sub">@CategoryLabel(_def)</div>
                    </div>
                    <ProfessionBonusSlots @key="_def.Profession" Profession="_def.Profession" />
                </div>
                @if (progress is not null)
                {
                    <ProfessionSkillBar Progress="progress" />
                    @if (progress.IsCapped && progress.NextRank is { } nextRank)
                    {
                        <div class="prof-training-capped">Skill capped at @progress.SkillCap – visit @trainer.Name to train @nextRank.Name.</div>
                    }
                }
            </div>

            @* Profession trainer: click opens the trainer window, speech bubble like the merchant in the inventory *@
            <div class="trainer-npc-col">
                @if (_speech is not null)
                {
                    <div @key="_speechKey" class="inv-speech trainer-speech" role="status">
                        <span class="inv-speech-text">@_speech</span>
                    </div>
                }
                <button class="trainer-npc @(_trainerOpen ? "open" : "")" title="Talk to @trainer.Name"
                        @onclick="ToggleTrainer" @oncontextmenu="ToggleTrainer" @oncontextmenu:preventDefault>
                    <span @key="_speechKey" class="al-portrait trainer-npc-portrait @(_speechKey > 0 ? "talking" : "")">
                        <img class="al-race-portrait" src="@trainer.PortraitUrl" alt="@trainer.Name" onerror="this.style.display='none'" />
                        <img class="al-class-badge" src="@trainer.BadgeUrl" alt="" onerror="this.style.display='none'" />
                    </span>
                    <span class="trainer-npc-text">
                        <span class="inv-npc-name">@trainer.Name</span>
                        <span class="inv-npc-title">&lt;@trainer.Title&gt;</span>
                        <span class="inv-npc-greeting">@trainer.Greeting</span>
                        <span class="inv-npc-cta">@(_trainerOpen ? "Click to close" : "Click to train")</span>
                    </span>
                </button>
            </div>
        </div>

        @if (_trainerOpen)
        {
            <ProfessionTrainerWindow Definition="_def" Progress="progress" OnClose="CloseTrainer" OnSpeech="Say" />
        }

        @if (progress is null && !_def.IsPrimary)
        {
            <div class="al-panel">
                <p class="wow-hint">@_def.Name is learned automatically once a character reaches level @Professions.MinCharacterLevel.</p>
            </div>
        }
        else if (progress is null)
        {
            var blocker = Engine.ProfessionLearnBlocker(_def.Profession);
            <div class="al-panel">
                <p class="wow-hint">You have not learned @_def.Name yet. Talk to @trainer.Name to become an apprentice.</p>
                @if (blocker is not null)
                {
                    <div class="wow-alert warning">@blocker</div>
                }
            </div>
        }
        else
        {
            @if (_def.IsGathering)
            {
                <ProfessionGatheringPanel Profession="_def.Profession" Progress="progress" />
            }
            else
            {
                <ProfessionCraftingPanel Progress="progress" />
                @if (_def.Profession == Profession.Enchanting)
                {
                    <ProfessionDisenchantPanel Progress="progress" />
                }
            }

            @if (!_def.IsGathering)
            {
                <p class="wow-hint">
                    Skill-ups have a @Professions.FormatChance(Engine.ProfessionSkillUpChance(_def))% chance per run.
                    The chance rises by @Professions.FormatChance(Professions.SkillUpChancePerTenLevels)% per 10 levels across all your characters.
                    The crafting queue only runs while you are in the Professions menu.
                </p>
            }

            <ProfessionFloatingText Profession="_def.Profession" />
        }
    }
    </div>

    @if (_def is not null && Engine.HasActiveCharacter && Engine.ProfessionsUnlockedOnAccount)
    {
        <CraftingQueuePanel />
    }
    </div>
</div>

@code {
    [Parameter] public string Slug { get; set; } = "";

    private ProfessionDefinition? _def;
    private string _gatheringMap = "";

    protected override void OnInitialized() => Engine.ProfessionUpdated += OnProfessionUpdated;

    protected override void OnParametersSet()
    {
        var def = Professions.FromSlug(Slug);
        if (_def is not null && _def != def) ResetTrainer();
        // New random map only when the profession changes, not on every render
        if (_def != def) _gatheringMap = IconUrls.RandomGatheringMapUrl();
        _def = def;
        SwitchToOwner();
    }

    // Main profession belongs to another character → switch to it (combat is paused like in character selection)
    private void SwitchToOwner()
    {
        if (_def is not { IsPrimary: true } || Engine.ProfessionOwner(_def.Profession) is not { } owner) return;
        if (owner.Id == Engine.ActiveCharacter?.Id) return;
        if (Engine.IsGameRunning) Engine.Stop();
        Engine.SelectCharacterForProfessions(owner.Id);
    }

    private static string CategoryLabel(ProfessionDefinition def) =>
        (def.IsGathering ? "Gathering" : "Crafting") + (def.IsPrimary ? " · Primary Profession" : " · Shared by all characters");

    private void OnProfessionUpdated() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Engine.ProfessionUpdated -= OnProfessionUpdated;
}
