@using Models

@* Skill-Leiste eines Berufs: Skill / Cap der aktuellen Ausbildungsstufe. *@
<div class="wow-progress prof-skill-bar" title="@Progress.Rank.Name – skill cap @Progress.SkillCap">
    <div class="bar" style="width: @Percent.ToString(System.Globalization.CultureInfo.InvariantCulture)%"></div>
    <span>@Progress.Rank.Name · @Progress.Skill / @Progress.SkillCap</span>
</div>

@code {
    [Parameter, EditorRequired] public ProfessionProgress Progress { get; set; } = null!;

    private double Percent => 100.0 * Progress.Skill / Professions.MaxSkill;
}
