@using Models
@inject IdleGameEngine Engine

@* Crafting window like in WoW: recipe list on the left, details + Create on the right. Active slot, 3 s per craft. *@
<div class="al-panel">
    <h4>Active Slot</h4>

    @if (Recipes.Count == 0)
    {
        <p class="wow-hint">No recipes known yet. Visit your trainer to learn some.</p>
    }
    else
    {
        <div class="craft-filter">
            <input class="trainer-search" type="search" placeholder="Search recipes…" @bind="_search" @bind:event="oninput" />
            @if (RecipeClasses.Count > 0)
            {
                @* Class filter for armor recipes *@
                <button class="craft-filter-btn @(_classFilter is null ? "active" : "")" @onclick="() => _classFilter = null">All</button>
                @foreach (var cls in RecipeClasses)
                {
                    <button class="craft-filter-btn icon @(_classFilter == cls ? "active" : "")" title="@cls" @onclick="() => _classFilter = cls">
                        <img src="@IconUrls.ClassIconUrl(cls)" alt="@cls" onerror="this.style.visibility='hidden'" />
                    </button>
                }
            }
        </div>

        <div class="craft-window">
            <div class="wow-inset craft-list">
                @if (FilteredRecipes.Count == 0)
                {
                    <p class="wow-hint trainer-empty">No matching recipes.</p>
                }
                @{ bool grouped = FilteredRecipes.Select(r => r.RequiredSkill).Distinct().Count() > 1; }
                @foreach (var group in FilteredRecipes.GroupBy(r => r.RequiredSkill))
                {
                    bool groupLocked = Progress.Skill < group.Key;
                    bool collapsed = grouped && IsCollapsed(group.Key);
                    int groupCraftable = groupLocked ? 0 : group.Count(r => Engine.MaxCraftable(r) > 0);
                    @if (grouped)
                    {
                        @* Collapsible tier: locked tiers start collapsed *@
                        <div class="craft-list-group @(groupLocked ? "locked" : "")" @onclick="() => ToggleGroup(group.Key)">
                            <span class="craft-list-caret">@(collapsed ? "▸" : "▾")</span>
                            <span>Skill @group.Key</span>
                            <span class="craft-list-group-sub">Lv @ItemRequirements.LevelOf(group.First().Result)</span>
                            @if (groupLocked)
                            {
                                <span class="craft-list-group-sub">🔒</span>
                            }
                            else if (groupCraftable > 0)
                            {
                                <span class="craft-list-group-badge">@groupCraftable</span>
                            }
                        </div>
                    }
                    @if (!collapsed)
                    {
                        @foreach (var classGroup in group.GroupBy(r => ItemRequirements.ClassOf(r.Result)))
                        {
                            @* With "All" a class subheading so the sets can be told apart *@
                            @if (classGroup.Key is { } cls && _classFilter is null)
                            {
                                <div class="craft-list-class-head class-@cls.ToString().ToLowerInvariant()">
                                    <img src="@IconUrls.ClassIconUrl(cls)" alt="" onerror="this.remove()" />
                                    @cls
                                </div>
                            }
                            @foreach (var recipe in classGroup)
                            {
                                int craftable = Engine.MaxCraftable(recipe);
                                bool locked = Progress.Skill < recipe.RequiredSkill;
                                var item = recipe.Result;
                                RenderFragment entry = @<div class="craft-list-entry @(recipe.Id == _recipeId ? "selected" : "") @(craftable == 0 ? "empty" : "") @(locked ? "locked" : "")"
                                     style="--quality: @ItemQualityColors.Hex(item.Quality)"
                                     @onclick="() => SelectRecipe(recipe)">
                                    @if (!locked)
                                    {
                                        @* Orange = still gives skill points, grey = below the own skill range *@
                                        <span class="craft-skill-dot @(GivesSkillUp(recipe) ? "up" : "trivial")"></span>
                                    }
                                    <img class="craft-list-icon" src="@item.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
                                    <span class="craft-list-name">@item.Name</span>
                                    @if (craftable > 0 && !locked)
                                    {
                                        <span class="craft-count">@craftable</span>
                                    }
                                </div>;
                                string? hint = locked ? $"Requires {Progress.Definition.Name} ({recipe.RequiredSkill})" : null;

                                @* Item tooltip on hover (armor with comparison to the worn piece) *@
                                @if (item is ArmorItem armor)
                                {
                                    <ArmorTooltip Armor="armor" Class="tt-contents" Hint="@hint"
                                                  RequirementsMet="@Engine.Player.MeetsItemRequirements(armor)"
                                                  Compare="@Engine.Player.EquippedArmor.GetValueOrDefault(armor.Slot)">
                                        @entry
                                    </ArmorTooltip>
                                }
                                else
                                {
                                    <TradeItemTooltip Item="@(item as TradeItem)" Class="tt-contents" Hint="@hint"
                                                      Count="Engine.Player.Inventory.CountOf(item.Id)">
                                        @entry
                                    </TradeItemTooltip>
                                }
                            }
                        }
                    }
                }
            </div>

            @if (SelectedRecipe is { } selected)
            {
                int craftable = Engine.MaxCraftable(selected);
                bool skillOk = Progress.Skill >= selected.RequiredSkill;
                <div class="craft-detail">
                    @if (selected.Result is ArmorItem armor)
                    {
                        <ArmorTooltip Armor="armor" RequirementsMet="@Engine.Player.MeetsItemRequirements(armor)">
                            @ResultLabel(armor)
                        </ArmorTooltip>
                    }
                    else
                    {
                        <TradeItemTooltip Item="@(selected.Result as TradeItem)" Count="Engine.Player.Inventory.CountOf(selected.Result.Id)">
                            @ResultLabel(selected.Result)
                        </TradeItemTooltip>
                    }
                    @if (!skillOk)
                    {
                        <div class="craft-req">Requires @Progress.Definition.Name (@selected.RequiredSkill)</div>
                    }
                    else if (ProfessionRegistry.TrivialSkill(selected.Profession, selected.RequiredSkill) is { } trivial)
                    {
                        <div class="craft-skillup @(GivesSkillUp(selected) ? "up" : "trivial")">
                            @(GivesSkillUp(selected) ? $"Skill-ups until {Progress.Definition.Name} {trivial}" : "No skill-ups – recipe is below your skill range")
                        </div>
                    }

                    <div class="craft-reagents-label">Reagents:</div>
                    @foreach (var reagent in selected.Reagents)
                    {
                        int have = Engine.Player.Inventory.CountOf(reagent.Item.Id);
                        <TradeItemTooltip Item="reagent.Item" Count="have">
                            <div class="craft-reagent @(have < reagent.Count ? "missing" : "")">
                                <img src="@reagent.Item.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
                                <span>@reagent.Item.Name</span>
                                <span class="craft-have">@have / @reagent.Count</span>
                            </div>
                        </TradeItemTooltip>
                    }

                    <div class="wow-progress prof-run-bar">
                        <div class="bar" style="width: @RunPercent%"></div>
                        <span>@RunLabel</span>
                    </div>

                    <div class="prof-row">
                        @if (Run is not null)
                        {
                            <button class="wow-btn small" @onclick="Engine.StopActiveProfession">Stop</button>
                        }
                        else
                        {
                            <button class="wow-btn small primary" disabled="@(craftable == 0 || !skillOk)" @onclick="() => Create(1)">Create</button>
                            <button class="wow-btn small" disabled="@(craftable == 0 || !skillOk)" @onclick="() => Create(craftable)">Create All (@craftable)</button>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public ProfessionProgress Progress { get; set; } = null!;

    private string? _recipeId;
    private CharacterClass? _classFilter;

    // Manually expanded/collapsed tiers (skill → collapsed); without an entry: locked = collapsed
    private readonly Dictionary<int, bool> _collapsedOverride = new();

    private bool IsCollapsed(int skill) =>
        _collapsedOverride.TryGetValue(skill, out bool collapsed) ? collapsed : Progress.Skill < skill;

    private void ToggleGroup(int skill) => _collapsedOverride[skill] = !IsCollapsed(skill);
    private Profession? _filterInitFor;

    private string _search = "";

    // Only recipes learned from the trainer (crafting professions start with a basic recipe)
    private IReadOnlyList<Recipe> Recipes =>
        ProfessionRegistry.GetRecipes(Progress.Profession).Where(r => Progress.KnowsRecipe(r.Id)).ToList();

    /// <summary>Classes this profession crafts armor for (empty for consumables).</summary>
    private IReadOnlyList<CharacterClass> RecipeClasses =>
        Recipes.Select(r => ItemRequirements.ClassOf(r.Result)).OfType<CharacterClass>().Distinct().ToList();

    private IReadOnlyList<Recipe> FilteredRecipes =>
        Recipes.Where(r => _classFilter is null || ItemRequirements.ClassOf(r.Result) == _classFilter)
               .Where(r => string.IsNullOrWhiteSpace(_search) || r.Result.Name.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase))
               .OrderBy(r => r.RequiredSkill)
               .ToList();

    private static RenderFragment ResultLabel(Item item) => __builder =>
    {
        <div class="craft-result">
            <img src="@item.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
            <span style="color: @ItemQualityColors.Hex(item.Quality)">@item.Name</span>
        </div>
    };
    private bool GivesSkillUp(Recipe recipe) =>
        ProfessionRegistry.GivesSkillUp(recipe.Profession, recipe.RequiredSkill, Progress.Skill);

    private Recipe? SelectedRecipe =>Recipes.FirstOrDefault(r => r.Id == _recipeId);

    private ActiveProfessionRun? Run =>
        Engine.ActiveProfessionRun is { DisenchantQueue: null } run && run.Profession == Progress.Profession ? run : null;

    private string RunPercent => ((Run?.Progress ?? 0) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private string RunLabel => Run is { } run && ProfessionRegistry.GetRecipe(run.Target) is { } recipe
        ? $"Creating {recipe.Result.Name}… ({run.Remaining} left)"
        : "Idle";

    protected override void OnParametersSet()
    {
        // Preset the filter once per profession: own class if the profession crafts for it
        if (_filterInitFor != Progress.Profession)
        {
            _filterInitFor = Progress.Profession;
            _classFilter = RecipeClasses.Contains(Engine.PlayerClass) ? Engine.PlayerClass : null;
        }

        // Select the last chosen recipe again (crafting doesn't start automatically – it consumes materials)
        if (SelectedRecipe is null || SelectedRecipe.Profession != Progress.Profession)
        {
            var remembered = ProfessionRegistry.GetRecipe(Engine.GetLastProfessionTarget(Progress.Profession));
            _recipeId = Run?.Target ?? (remembered?.Profession == Progress.Profession && Progress.KnowsRecipe(remembered.Id) ? remembered.Id : Recipes.FirstOrDefault()?.Id);
        }
    }

    private void SelectRecipe(Recipe recipe)
    {
        _recipeId = recipe.Id;
        Engine.RememberProfessionTarget(Progress.Profession, recipe.Id);
    }

    private void Create(int count)
    {
        if (_recipeId is not null && count > 0)
            Engine.StartActiveProfession(Progress.Profession, _recipeId, count);
    }
}
