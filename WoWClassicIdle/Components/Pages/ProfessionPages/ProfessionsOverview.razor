@page "/professions"
@using Models
@rendermode InteractiveServer
@inject IdleGameEngine Engine
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>Professions</PageTitle>

@* Styles: wwwroot/css/professions.css – Kopf und Panels (.al-header, .al-panel) aus ability-loadout.css *@
<div class="wow-page professions-page @(BuildInfo.IsDebug ? "with-debug" : "")">
    <h2 class="prof-title">Professions</h2>

    @if (!Engine.HasActiveCharacter)
    {
        <div class="wow-alert info">Create a character first.</div>
    }
    else if (Engine.Player.Level < Professions.MinCharacterLevel)
    {
        <div class="wow-alert warning">Professions unlock at level @Professions.MinCharacterLevel.</div>
    }
    else
    {
        <p class="wow-hint prof-hint">
            Each character can learn one crafting profession – unlearning it resets its skill.
            Herbalism, Mining, Skinning and Fishing are shared by all characters and learned automatically at level @Professions.MinCharacterLevel.
        </p>

        @if (BuildInfo.IsDebug)
        {
            @* Debug-Werkzeuge: fest am linken Rand des Inhaltsbereichs, direkt neben der Navigation *@
            <aside class="al-panel prof-debug" style="--i: 0">
                <h4><span class="wow-badge">DEBUG</span></h4>
                <button class="wow-btn small" @onclick="DebugAssignAll">Assign all professions + passive slots (zone 1)</button>
                @if (_debugResult is not null)
                {
                    <span class="wow-muted prof-debug-result">@_debugResult</span>
                }
                <span class="prof-debug-label">Profession speed</span>
                <div class="prof-debug-buttons">
                    @foreach (var speed in new[] { 1, 5, 10, 50, 100, 500 })
                    {
                        <button class="wow-tab @(Engine.ProfessionSpeed == speed ? "active" : "")"
                                @onclick="() => Engine.DebugSetProfessionSpeed(speed)">@(speed)×</button>
                    }
                </div>
                <span class="prof-debug-label">Set all skills to</span>
                <div class="prof-debug-buttons">
                    @foreach (var skill in new[] { 75, 150, 225, 300 })
                    {
                        <button class="wow-tab" @onclick="() => Engine.DebugSetAllProfessionSkills(skill)">@skill</button>
                    }
                </div>
            </aside>
        }

        <div class="prof-layout">
        @* Linke Spalte: Charaktere – Klick wechselt den gespielten Charakter *@
        <aside class="al-panel prof-roster" style="--i: 0">
            <h4>Characters</h4>
            @{ int index = 0; }
            @foreach (var character in Engine.CharacterRoster)
            {
                @RosterEntry(character, index++)
            }
        </aside>

        <div class="prof-main">
        <ProfessionSearch />

        <div class="al-panel prof-map-bg" style="--i: 1">
            @* Zufällige Gebietskarte transparent im Hintergrund *@
            <div class="prof-map" aria-hidden="true" style="background-image: url('@_gatheringMap')"></div>
            <h4>Gathering</h4>
            <div class="prof-grid">
                @foreach (var (def, i) in Professions.All.Where(d => d.IsGathering).Select((d, i) => (d, i)))
                {
                    @Card(def, i)
                }
            </div>
        </div>

        <div class="al-panel prof-map-bg" style="--i: 2">
            @* Hauptstadt-Karte der Fraktion transparent im Hintergrund (wie im Inventar) *@
            <div class="prof-map" aria-hidden="true" style="background-image: url('@IconUrls.CapitalMapUrl(Engine.Faction)')"></div>
            <h4>Crafting</h4>
            <div class="prof-grid">
                @foreach (var (def, i) in Professions.All.Where(d => !d.IsGathering).Select((d, i) => (d, i)))
                {
                    @Card(def, i + 4)
                }
            </div>
        </div>
        </div>
        </div>
    }
</div>

@code {
    private Profession? _confirmUnlearn;
    // Einmal je Seitenaufruf gewählt, damit die Karte beim Neuzeichnen nicht wechselt
    private readonly string _gatheringMap = IconUrls.RandomGatheringMapUrl();
    private string? _debugResult;

    private void DebugAssignAll() => _debugResult = Engine.DebugAssignAllProfessions();

    private RenderFragment Card(ProfessionDefinition def, int index) => __builder =>
    {
        var progress = Engine.GetProfessionProgress(def.Profession);
        var blocker  = Engine.ProfessionLearnBlocker(def.Profession);
        var owner    = def.IsPrimary ? Engine.ProfessionOwner(def.Profession) : null;
        // Fortschritt immer anzeigen – auch wenn ein anderer Charakter den Hauptberuf erlernt hat
        var shown    = progress ?? owner?.Player.ProfessionState.Get(def.Profession);
        var workers  = Engine.PassiveAssignments
            .Where(a => a.Profession == def.Profession)
            .Select(a => Engine.GetCharacter(a.CharacterId))
            .OfType<CharacterSlot>()
            .ToList();
        bool hasAction = def.IsPrimary && (progress is not null || owner is null);
        <div class="prof-card prof-bg-@def.Slug @(shown is not null ? "learned" : "") @(hasAction ? "has-action" : "")" style="--i: @index" @onclick="() => Open(def)">
            <img class="prof-icon" src="@def.IconUrl" alt="" onerror="this.style.visibility='hidden'" />
            <div class="prof-card-body">
                <div class="prof-card-name">
                    @def.Name
                    @if (owner is not null)
                    {
                        @* Klassen-Icon des Charakters, der den Hauptberuf erlernt hat *@
                        <img class="prof-owner-icon" src="@IconUrls.ClassIconUrl(owner.Class)" alt=""
                             title="@($"{IdleGameEngine.CharacterName(owner)} (Lv. {owner.Player.Level})")"
                             onerror="this.remove()" />
                    }
                    @* Passive Sammler: Klassen-Icons direkt neben dem Namen *@
                    @foreach (var worker in workers)
                    {
                        <img class="prof-owner-icon prof-worker-icon" src="@IconUrls.ClassIconUrl(worker.Class)" alt=""
                             title="@($"Passive: {IdleGameEngine.CharacterName(worker)} (Lv. {worker.Player.Level})")"
                             onerror="this.remove()" />
                    }
                </div>
                @if (shown is not null)
                {
                    <ProfessionSkillBar Progress="shown" />
                }
                else
                {
                    <div class="prof-card-sub">@(blocker ?? "Not learned")</div>
                }
            </div>
            <div class="prof-card-actions" @onclick:stopPropagation="true">
                @if (!def.IsPrimary)
                {
                    @* Geteilte Berufe: automatisch gelernt, nicht verlernbar *@
                }
                else if (progress is null && owner is not null)
                {
                    @* Von einem anderen Charakter erlernt – verlernen nur als dieser Charakter *@
                }
                else if (progress is null)
                {
                    <button class="prof-mini-btn" disabled="@(blocker is not null)" @onclick="() => Learn(def.Profession)">Learn</button>
                }
                else if (_confirmUnlearn == def.Profession)
                {
                    <button class="prof-mini-btn danger" @onclick="() => Unlearn(def.Profession)">Confirm</button>
                    <button class="prof-mini-btn" @onclick="() => _confirmUnlearn = null">Cancel</button>
                }
                else
                {
                    <button class="prof-mini-btn danger" @onclick="() => _confirmUnlearn = def.Profession">Unlearn</button>
                }
            </div>
        </div>
    };

    // Schnellauswahl: rundes Volksporträt mit Klassen-Badge, Name, Level und Berufs-Icons
    private RenderFragment RosterEntry(CharacterSlot character, int index) => __builder =>
    {
        bool isActive = character.Id == Engine.ActiveCharacter?.Id;
        var primary = character.Player.ProfessionState.Primary;
        var passive = Engine.PassiveAssignmentOf(character.Id);
        <div class="roster-entry @(isActive ? "current" : "selectable")" style="--i: @index"
             title="@(isActive ? "Currently playing" : "Click to play this character")"
             @onclick="() => Play(character)">
            <div class="al-portrait roster-portrait">
                <img class="al-race-portrait" src="@IconUrls.RaceIconUrl(character.Race, character.Gender)" alt="@character.Race" onerror="this.style.visibility='hidden'" />
                <img class="al-class-badge" src="@IconUrls.ClassIconUrl(character.Class)" alt="@character.Class" onerror="this.style.display='none'" />
            </div>
            <div class="roster-entry-body">
                <span class="roster-entry-name class-@character.Class.ToString().ToLowerInvariant()">@IdleGameEngine.CharacterName(character)</span>
                <span class="wow-muted roster-entry-sub">
                    Lv. @character.Player.Level @character.Race @character.Class
                </span>
            </div>
            @* Berufe des Charakters: Herstellungsberuf + passiv ausgeübter Sammelberuf *@
            <div class="roster-entry-profs">
                @if (primary is not null)
                {
                    <img class="roster-prof" src="@primary.Definition.IconUrl" alt=""
                         title="@($"{primary.Definition.Name} {primary.Skill}/{primary.SkillCap}")"
                         onerror="this.remove()" />
                }
                @if (passive is not null)
                {
                    <img class="roster-prof passive" src="@Professions.Get(passive.Profession).IconUrl" alt=""
                         title="@PassiveLabel(passive)"
                         onerror="this.remove()" />
                }
            </div>
        </div>
    };

    private static string PassiveLabel(PassiveAssignment passive)
    {
        string zone = ProfessionRegistry.GetZone(passive.Profession, passive.Group)?.Name ?? passive.Group;
        return $"Passive: {Professions.Get(passive.Profession).Name} · {zone}";
    }

    // Lernbarer Hauptberuf und der Charakter hat noch keinen → direkt lernen statt die Unterseite zu öffnen
    private void Open(ProfessionDefinition def)
    {
        if (def.IsPrimary && Engine.ProfessionLearnBlocker(def.Profession) is null)
            Learn(def.Profession);
        else
            Nav.NavigateTo($"/professions/{def.Slug}");
    }

    // Wechselt den gespielten Charakter – wie in der Charakterauswahl wird der Kampf dabei angehalten
    private void Play(CharacterSlot character)
    {
        if (character.Id == Engine.ActiveCharacter?.Id) return;
        if (Engine.IsGameRunning) Engine.Stop();
        Engine.SelectCharacterForProfessions(character.Id);
        _confirmUnlearn = null;
    }

    private void Learn(Profession profession) => Engine.LearnProfession(profession);

    private void Unlearn(Profession profession)
    {
        Engine.UnlearnProfession(profession);
        _confirmUnlearn = null;
    }

    protected override void OnInitialized() => Engine.ProfessionUpdated += OnProfessionUpdated;

    // Status der Slots (Countdowns) laufend aktualisieren
    private void OnProfessionUpdated() => _ = InvokeAsync(StateHasChanged);

    public void Dispose() => Engine.ProfessionUpdated -= OnProfessionUpdated;
}
