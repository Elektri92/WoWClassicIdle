@page "/inventory"
@rendermode InteractiveServer
@using Models
@implements IDisposable
@inject IdleGameEngine _engine

<PageTitle>Inventory</PageTitle>

<div class="wow-page inventory-page">
    <h2>Inventory</h2>
    <p class="wow-hint">Your equipment and character stats.</p>

    <div class="inventory-layout">
    <div class="wow-card char-pane">
        <!-- ═══ HEADER ═══ -->
        <div class="pane-header">
            <div class="portrait-area">
                <img class="race-portrait"
                     src="@IconUrls.RaceIconUrl(_engine.Player.Race, _engine.Gender)"
                     alt="" onerror="this.style.display='none'" />
                <img class="class-badge"
                     src="@IconUrls.ClassIconUrl(_engine.Player.ActiveClass)"
                     alt="" onerror="this.style.display='none'" />
            </div>
            <div class="pane-title">
                <div class="pane-name">@(string.IsNullOrWhiteSpace(_engine.Player.Name) ? "Character" : _engine.Player.Name)</div>
                <div class="pane-subtitle">
                    Level @_engine.Player.Stats.Level @_engine.Player.Race
                    <span class="class-color class-@(_engine.Player.ActiveClass.ToString().ToLowerInvariant())">@_engine.Player.ActiveClass</span>
                </div>
                <div class="pane-faction">@_engine.Player.Faction</div>
            </div>
        </div>

        <!-- ═══ PAPERDOLL ═══ -->
        <div class="paperdoll">
            <div class="slot-column">
                @foreach (var slot in LeftSlots)
                {
                    var gear = EquippedIn(slot);
                    <ArmorTooltip Armor="gear" Class="tt-contents" Hint="@(gear is not null ? UnequipHint : null)">
                        <div class="equip-slot @SlotCss(gear)"
                             title="@SlotHint(slot, gear)"
                             style="--quality: @SlotQuality(gear)"
                             @ondragover:preventDefault="@CanDropArmor(slot)"
                             @ondrop="() => DropOnArmorSlot(slot.Armor)"
                             @oncontextmenu="() => UnequipArmorSlot(slot.Armor)"
                             @oncontextmenu:preventDefault="@(gear is not null)">
                            <img src="@SlotImage(slot, gear)" alt="@slot.Name" onerror="this.style.display='none'" />
                        </div>
                    </ArmorTooltip>
                }
            </div>

            <div class="model-area">
                <img class="model-portrait"
                     src="@IconUrls.RaceIconUrl(_engine.Player.Race, _engine.Gender)"
                     alt="" onerror="this.style.display='none'" />
            </div>

            <div class="slot-column">
                @foreach (var slot in RightSlots)
                {
                    var gear = EquippedIn(slot);
                    <ArmorTooltip Armor="gear" Class="tt-contents" Hint="@(gear is not null ? UnequipHint : null)">
                        <div class="equip-slot @SlotCss(gear)"
                             title="@SlotHint(slot, gear)"
                             style="--quality: @SlotQuality(gear)"
                             @ondragover:preventDefault="@CanDropArmor(slot)"
                             @ondrop="() => DropOnArmorSlot(slot.Armor)"
                             @oncontextmenu="() => UnequipArmorSlot(slot.Armor)"
                             @oncontextmenu:preventDefault="@(gear is not null)">
                            <img src="@SlotImage(slot, gear)" alt="@slot.Name" onerror="this.style.display='none'" />
                        </div>
                    </ArmorTooltip>
                }
            </div>
        </div>

        <div class="weapon-row">
            @if (_engine.Player.EquippedWeapon is { } equipped)
            {
                <WeaponTooltip Weapon="equipped" Hint="@UnequipHint">
                    <div class="equip-slot equipped-weapon"
                         style="--quality: @ItemQualityColors.Hex(equipped.Quality)"
                         @oncontextmenu="UnequipWeapon" @oncontextmenu:preventDefault
                         @ondragover:preventDefault @ondrop="DropOnWeaponSlot">
                        <img src="@equipped.IconUrl" alt="@equipped.Name" onerror="this.style.display='none'" />
                    </div>
                </WeaponTooltip>
            }
            else
            {
                <div class="equip-slot" title="@WeaponSlot.Name (drag weapon here)"
                     @ondragover:preventDefault @ondrop="DropOnWeaponSlot">
                    <img src="@SlotIconUrl(WeaponSlot.Icon)" alt="@WeaponSlot.Name" onerror="this.style.display='none'" />
                </div>
            }
        </div>

        <!-- ═══ STATS ═══ -->
        <div class="stats-area">
            <div class="wow-inset stat-box">
                <StatTooltip StatName="Strength" Description="@StrengthTooltip(_engine.Player.ActiveClass)" IsUseless="@IsStrengthUseless(_engine.Player.ActiveClass)">
                    <div class="wow-stat-row"><span>Strength:</span><span>@Primary.Strength</span></div>
                </StatTooltip>
                <StatTooltip StatName="Agility" Description="@AgilityTooltip(_engine.Player.ActiveClass)" IsUseless="@IsAgilityUseless(_engine.Player.ActiveClass)">
                    <div class="wow-stat-row"><span>Agility:</span><span>@Primary.Agility</span></div>
                </StatTooltip>
                <StatTooltip StatName="Stamina" Description="@StaminaTooltip()">
                    <div class="wow-stat-row"><span>Stamina:</span><span>@Primary.Stamina</span></div>
                </StatTooltip>
                <StatTooltip StatName="Intellect" Description="@IntellectTooltip(_engine.Player.ActiveClass)" IsUseless="@(!StatScaling.UsesMana(_engine.Player.ActiveClass))">
                    <div class="wow-stat-row"><span>Intellect:</span><span>@Primary.Intelligence</span></div>
                </StatTooltip>
                <StatTooltip StatName="Spirit" Description="@SpiritTooltip(_engine.Player.ActiveClass)" IsUseless="@(!StatScaling.UsesMana(_engine.Player.ActiveClass))">
                    <div class="wow-stat-row"><span>Spirit:</span><span>@Primary.Spirit</span></div>
                </StatTooltip>
            </div>
            <div class="wow-inset stat-box">
                <div class="wow-stat-row"><span>Health:</span><span>@_engine.Player.Stats.MaxHp</span></div>
                <div class="wow-stat-row"><span>@ResourceName:</span><span>@_engine.Player.Stats.MaxMana</span></div>
                @if (StatScaling.UsesMana(_engine.Player.ActiveClass))
                {
                    <div class="wow-stat-row"><span>Mana / 5s:</span><span>@_engine.Player.Stats.ManaRegenPer5</span></div>
                }
                <div class="wow-stat-row"><span>Weapon Dmg:</span><span>@_engine.Player.Stats.WeaponMinDamage–@_engine.Player.Stats.WeaponMaxDamage</span></div>
                <div class="wow-stat-row"><span>Attack Power:</span><span>@_engine.Player.Stats.AttackPower</span></div>
                <div class="wow-stat-row"><span>Armor:</span><span>@_engine.Player.Stats.Defense</span></div>
                <div class="wow-stat-row"><span>Speed:</span><span>@_engine.Player.Stats.Speed.ToString("0.0#")</span></div>
                <div class="wow-stat-row" title="Critical hits double damage, healing and shields">
                    <span>Crit Chance:</span><span>@FormatPercent(_engine.Player.Stats.CritChance)</span>
                </div>
                <div class="wow-stat-row" title="Speeds up auto-attacks and ability cooldowns">
                    <span>Attack Speed:</span><span>@FormatBonusPercent(_engine.Player.Stats.AttackSpeedBonus)</span>
                </div>
            </div>
        </div>

    </div>

    <div class="bags-column">
    <!-- Bag bar: Bag 4 … Bag 1, Backpack (right to left, like the original) -->
    <div class="bag-bar">
        @for (int i = Models.Inventory.BagSlotCount - 1; i >= 0; i--)
        {
            var bagIndex = i;
            var bag = _engine.Player.Inventory.Bags[bagIndex];
            if (bag is null)
            {
                var unlockLevel = Models.Inventory.BagUnlockLevels[bagIndex];
                var lockedTitle = _engine.Player.Level < unlockLevel
                    ? $"Bag Slot {bagIndex + 1}: Unlocks at level {unlockLevel}"
                    : $"Bag Slot {bagIndex + 1} (empty)";
                <div class="bar-slot empty bag-locked" title="@lockedTitle">
                    <img src="@EmptyBagSlotIconUrl" alt="" onerror="this.style.display='none'" />
                </div>
            }
            else
            {
                var nextGrowth = Models.Inventory.NextBagGrowthLevel(_engine.Player.Level);
                var bagTitle = bag.Source is null
                    ? $"{bag.Name} — {bag.FreeSlots}/{bag.SlotCount} free • Grows to {bag.SlotCount + 1} slots at level {nextGrowth}"
                    : $"{bag.Name} — {bag.FreeSlots}/{bag.SlotCount} free";
                <button class="bar-slot @(OpenContainers.Contains(bagIndex) ? "open" : "")"
                        title="@bagTitle"
                        @onclick="() => ToggleContainer(bagIndex)">
                    <img src="@bag.IconUrl" alt="@bag.Name" onerror="this.style.display='none'" />
                </button>
            }
        }
        @{ var backpack = _engine.Player.Inventory.Backpack; }
        <button class="bar-slot backpack @(OpenContainers.Contains(BackpackIndex) ? "open" : "")"
                title="Backpack (@_engine.Player.Inventory.FreeSlots/@_engine.Player.Inventory.TotalSlots free)"
                @onclick="() => ToggleContainer(BackpackIndex)">
            <img src="@backpack.IconUrl" alt="Backpack" onerror="this.style.display='none'" />
        </button>
    </div>

    <!-- ═══ BAGS ═══ -->
    <div class="bags-area">
        @foreach (var index in OpenContainers.Order())
        {
            var bag = ContainerAt(index);
            if (bag is null) continue;
            var containerIndex = index;

            <div class="bag-frame">
                <div class="bag-frame-header">
                    @{
                        var frameNextGrowth = Models.Inventory.NextBagGrowthLevel(_engine.Player.Level);
                        var framePortraitTitle = bag.Source is null
                            ? $"{bag.SlotCount} slots • Grows to {bag.SlotCount + 1} slots at level {frameNextGrowth}"
                            : $"{bag.SlotCount} slots";
                    }
                    <img class="bag-portrait" title="@framePortraitTitle" src="@bag.IconUrl" alt="" onerror="this.style.display='none'" />
                    <span class="bag-title">
                        @bag.Name
                        <span class="bag-slot-count">(@bag.SlotCount)</span>
                    </span>
                    <button class="bag-close" title="Close" @onclick="() => ToggleContainer(containerIndex)">×</button>
                </div>

                <div class="bag-grid">
                    @for (int pad = 0; pad < (4 - bag.SlotCount % 4) % 4; pad++)
                    {
                        <div class="bag-slot-pad"></div>
                    }
                    @for (int s = 0; s < bag.Slots.Count; s++)
                    {
                        var si    = s;
                        var stack = bag.Slots[s];
                        if (stack is null)
                        {
                            <div class="bag-slot empty"></div>
                        }
                        else
                        {
                            var weaponItem = stack.Item as WeaponItem;
                            var armorItem  = stack.Item as ArmorItem;
                            bool classLocked = weaponItem?.RequiredClass is { } req && req != _engine.Player.ActiveClass;
                            bool levelLocked = !_engine.Player.MeetsItemRequirements(stack.Item);
                            if (classLocked)
                            {
                                <div class="bag-slot empty"></div>
                            }
                            else
                            {
                            var slotCss = weaponItem is not null ? "bag-slot weapon-item"
                                        : armorItem  is not null ? "bag-slot armor-item"
                                        :                         "bag-slot sellable-item";
                            if (levelLocked)
                            {
                                slotCss += " level-locked";
                            }
                            string? bagHint = levelLocked ? null : EquipHint;
                            if (armorItem is not null)
                            {
                            <ArmorTooltip Armor="armorItem" Class="tt-contents" Hint="@bagHint" RequirementsMet="@(!levelLocked)">
                                <div class="@slotCss"
                                     style="--quality: @ItemQualityColors.Hex(stack.Item.Quality)"
                                     draggable="true"
                                     @ondragstart="() => StartDrag(containerIndex, si)"
                                     @ondragend="ClearDrag"
                                     @oncontextmenu="() => TryEquipItem(containerIndex, si)"
                                     @oncontextmenu:preventDefault>
                                    <img src="@stack.Item.IconUrl" alt="@stack.Item.Name" onerror="this.style.display='none'" />
                                    @if (stack.Count > 1)
                                    {
                                        <span class="stack-count">@stack.Count</span>
                                    }
                                </div>
                            </ArmorTooltip>
                            }
                            else
                            {
                            <WeaponTooltip Weapon="weaponItem" Class="tt-contents" Hint="@bagHint" RequirementsMet="@(!levelLocked)">
                                <div class="@slotCss"
                                     title="@(weaponItem is not null ? null : stack.Item.Name)"
                                     style="--quality: @ItemQualityColors.Hex(stack.Item.Quality)"
                                     draggable="true"
                                     @ondragstart="() => StartDrag(containerIndex, si)"
                                     @ondragend="ClearDrag"
                                     @oncontextmenu="() => TryEquipItem(containerIndex, si)"
                                     @oncontextmenu:preventDefault>
                                    <img src="@stack.Item.IconUrl" alt="@stack.Item.Name" onerror="this.style.display='none'" />
                                    @if (stack.Count > 1)
                                    {
                                        <span class="stack-count">@stack.Count</span>
                                    }
                                </div>
                            </WeaponTooltip>
                            }
                            } // end !classLocked
                        }
                    }
                </div>

                @if (index == BackpackIndex)
                {
                    var (gold, silver, copper) = Money.Split(_engine.Player.Copper);
                    <div class="bag-money">
                        <span class="money-frame" title="@Money.Format(_engine.Player.Copper)">
                            @if (gold > 0)
                            {
                                <span class="coin">@gold<img src="@Money.GoldIconUrl" alt="Gold" /></span>
                            }
                            @if (gold > 0 || silver > 0)
                            {
                                <span class="coin">@silver<img src="@Money.SilverIconUrl" alt="Silver" /></span>
                            }
                            <span class="coin">@copper<img src="@Money.CopperIconUrl" alt="Copper" /></span>
                        </span>
                    </div>
                }
            </div>
        }
    </div>
    <!-- ═══ GOBLIN HÄNDLER ═══ -->
    <div class="merchant-frame">
        <div class="merchant-header">
            <div class="merchant-portrait-area">
                <img class="merchant-portrait"
                     src="https://wow.zamimg.com/images/wow/icons/large/race_goblin_male.jpg"
                     alt="Goblin Merchant" onerror="this.style.display='none'" />
                <img class="merchant-class-badge"
                     src="https://wow.zamimg.com/images/wow/icons/large/inv_misc_head_goblin_01.jpg"
                     alt="" onerror="this.style.display='none'" />
            </div>
            <div class="merchant-title">
                <div class="merchant-name">Gibzig</div>
                <div class="merchant-subtitle">Goblin Merchant</div>
                <div class="merchant-greeting">"A deal's a deal, mon!"</div>
            </div>
        </div>
        <div class="merchant-sell-zone @(_dragSource.HasValue ? "drag-active" : "")"
             @ondragover:preventDefault @ondrop="DropOnMerchant">
            <img src="@Money.GoldIconUrl" alt="" class="sell-coin-icon" />
            <span class="sell-zone-label">Drag item here to sell</span>
        </div>
        @if (_lastSellMessage is not null)
        {
            <div class="merchant-sold-msg">@_lastSellMessage</div>
        }
    </div>
    </div>
    </div>
</div>

<style>
    .inventory-page { max-width: none; }

    /* ----- Layout: character left, bags right ----- */
    .inventory-layout {
        display: flex;
        flex-wrap: nowrap;
        align-items: flex-start;
        gap: 16px;
        margin-bottom: 2rem;
    }

    @@media (max-width: 800px) {
        .inventory-layout { flex-wrap: wrap; }
    }

    .char-pane {
        width: 360px;
        flex-shrink: 0;
        font-size: .9rem;
    }

    .bags-column {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-top: 1rem;
    }

    /* ----- Header ----- */
    .pane-header {
        display: flex;
        gap: 12px;
        align-items: center;
        padding-bottom: 10px;
        border-bottom: 1px solid #5a4a28;
    }

    .portrait-area {
        position: relative;
        width: 52px;
        height: 52px;
        flex-shrink: 0;
    }

    .race-portrait {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        object-fit: cover;
        background: #222;
    }

    .class-badge {
        position: absolute;
        bottom: -4px;
        right: -4px;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        background: #0e0b07;
        object-fit: contain;
    }

    .pane-title {
        flex: 1;
        text-align: center;
    }

    .pane-name {
        font-family: 'Cinzel', serif;
        font-size: 1.1rem;
        font-weight: 700;
        color: #ffd100;
        text-shadow: 0 1px 2px #000;
    }

    .pane-subtitle {
        font-size: .85rem;
        color: #fff;
    }

    .pane-faction {
        font-size: .8rem;
        color: #9a8a64;
    }

    /* ----- Paperdoll ----- */
    .paperdoll {
        display: flex;
        justify-content: space-between;
        gap: 6px;
        margin-top: 10px;
    }

    .slot-column {
        display: flex;
        flex-direction: column;
        gap: 3px;
    }

    .model-area {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(ellipse at center, #3a3022 0%, #120e08 75%);
        border: 1px solid #3d321c;
        border-radius: 4px;
    }

    .model-portrait {
        width: 96px;
        height: 96px;
        border-radius: 8px;
        opacity: .85;
        object-fit: cover;
        box-shadow: 0 0 24px rgba(0,0,0,.8);
    }

    .equip-slot {
        width: 34px;
        height: 34px;
        background: #0c0a06;
        border: 2px solid #4a3d22;
        border-radius: 4px;
        box-shadow: inset 0 0 6px #000;
        overflow: hidden;
    }

    .equip-slot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: .45;
        filter: grayscale(.6);
    }

    .equip-slot:hover {
        border-color: #c5a55a;
    }

    /* ── Ausgerüstete Rüstung im Paperdoll-Slot ── */
    .equip-slot.equipped-item {
        border-color: var(--quality, #c5a55a);
        cursor: context-menu;
    }

    .equip-slot.equipped-item img {
        opacity: 1;
        filter: none;
    }

    .equip-slot.equipped-item:hover {
        border-color: #ffd100;
        box-shadow: 0 0 6px rgba(255,209,0,.4);
    }

    .weapon-row {
        display: flex;
        justify-content: center;
        gap: 6px;
        margin-top: 8px;
    }

    /* ----- Stats ----- */
    .stats-area {
        display: flex;
        gap: 8px;
        margin-top: 12px;
    }

    .stat-box {
        flex: 1;
        padding: 4px 8px;
    }

    /* ----- Money (classic backpack money frame) ----- */
    .money-frame {
        display: flex;
        gap: 8px;
        padding: 1px 8px;
        background: #0c0a06;
        border: 1px solid #4a3d22;
        border-radius: 3px;
        box-shadow: inset 0 0 4px #000;
    }

    .coin {
        display: inline-flex;
        align-items: center;
        gap: 2px;
        color: #fff;
        font-variant-numeric: tabular-nums;
        text-shadow: 0 1px 2px #000;
    }

    .coin img {
        width: 13px;
        height: 13px;
    }

    /* ----- Bags (classic container frames) ----- */
    .bags-area {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 8px;
        margin-top: 10px;
    }

    .bag-frame {
        padding: 6px 8px 8px;
        background: linear-gradient(180deg, #2b2418 0%, #15110a 100%);
        border: 2px solid #8a7444;
        border-radius: 6px;
        box-shadow: 0 4px 14px rgba(0,0,0,.6), inset 0 0 0 1px #3d321c;
    }

    .bag-frame-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 6px;
    }

    .bag-portrait {
        width: 32px;
        height: 32px;
        margin: -14px 0 0 -14px;
        border-radius: 50%;
        border: 2px solid #c5a55a;
        background: #0e0b07;
        object-fit: cover;
        box-shadow: 0 2px 6px #000;
    }

    .bag-title {
        flex: 1;
        font-size: .85rem;
        color: #ffd100;
        text-shadow: 0 1px 2px #000;
    }

    .bag-close {
        width: 18px;
        height: 18px;
        padding: 0;
        line-height: 14px;
        font-size: 14px;
        color: #ffd100;
        background: #5a1a10;
        border: 1px solid #c5a55a;
        border-radius: 3px;
        cursor: pointer;
    }

    .bag-close:hover { background: #8a2a18; }

    .bag-grid {
        display: grid;
        grid-template-columns: repeat(4, 37px);
        gap: 3px;
    }

    .bag-slot, .bag-slot-pad {
        width: 37px;
        height: 37px;
    }

    .bag-slot {
        position: relative;
        background: #0c0a06;
        border: 1px solid var(--quality, #3a3020);
        border-radius: 3px;
        box-shadow: inset 0 0 6px #000;
        overflow: hidden;
    }

    .bag-slot.empty {
        background: radial-gradient(ellipse at center, #1c1810 0%, #070604 80%);
        border-color: #3a3020;
    }

    .bag-slot:hover { border-color: #ffd100; }

    .bag-slot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .stack-count {
        position: absolute;
        right: 2px;
        bottom: 0;
        font-size: .75rem;
        font-weight: 700;
        color: #fff;
        text-shadow: 1px 1px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000;
    }

    .bag-money {
        display: flex;
        justify-content: flex-end;
        margin-top: 6px;
        font-size: .85rem;
    }

    /* ----- Bag bar ----- */
    .bag-bar {
        display: flex;
        align-items: flex-end;
        gap: 4px;
    }

    .bar-slot {
        width: 32px;
        height: 32px;
        padding: 0;
        background: #0c0a06;
        border: 2px solid #4a3d22;
        border-radius: 4px;
        box-shadow: inset 0 0 6px #000;
        overflow: hidden;
    }

    .bar-slot.backpack {
        width: 40px;
        height: 40px;
    }

    button.bar-slot { cursor: pointer; }
    button.bar-slot:hover, .bar-slot.open { border-color: #ffd100; }

    .bar-slot img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .bar-slot.empty img {
        opacity: .45;
        filter: grayscale(.6);
    }

    /* ── Gesperrter Taschenplatz (Level nicht erreicht) ── */
    .bar-slot.bag-locked img {
        opacity: .25;
        filter: grayscale(.9) brightness(.6);
    }

    /* ── Slot-Anzahl im Bag-Frame-Header ── */
    .bag-slot-count {
        font-size: .75rem;
        color: #9a8a64;
        font-weight: normal;
        margin-left: 2px;
    }

    /* ── Equipped weapon slot ── */
    .equip-slot.equipped-weapon {
        border-color: var(--quality, #c5a55a);
        cursor: context-menu;
    }

    .equip-slot.equipped-weapon img {
        opacity: 1;
        filter: none;
    }

    .equip-slot.equipped-weapon:hover {
        border-color: #ffd100;
        box-shadow: 0 0 6px rgba(255,209,0,.4);
    }

    /* ── Weapon item in bag (drag hint) ── */
    .bag-slot.weapon-item {
        cursor: grab;
    }

    .bag-slot.weapon-item:hover {
        border-color: #c5a55a;
    }

    /* ── Rüstungsteil im Beutel (drag hint) ── */
    .bag-slot.armor-item {
        cursor: grab;
    }

