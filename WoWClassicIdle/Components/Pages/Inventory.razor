@page "/inventory"
@using Models
@implements IDisposable
@inject IdleGameEngine _engine

<PageTitle>Inventory</PageTitle>

@* Styles: wwwroot/css/inventory.css – Logik in Inventory.razor.cs *@
<div class="wow-page inventory-page">
    <h2 class="inv-title">Inventory</h2>
    <p class="wow-hint inv-hint">Your equipment, bags and character stats. @BagUnlockHint</p>
    @if (_useMessage is not null)
    {
        @* Feedback after right-clicking a usable consumable *@
        <div @key="_useMessage" class="wow-alert @(_useFailed ? "warning" : "info") inv-status">@_useMessage</div>
    }

    @* ── Header: character on the scene of its current zone ── *@
    <div class="al-header inv-header @(_engine.Faction == Faction.Alliance ? "alliance" : "horde") @(CombatZoneRegistry.IsNightTheme(HeaderTheme) ? "night" : "day")">
        <div class="al-scenery" aria-hidden="true">
            <div class="al-sky zone-theme-@HeaderTheme"></div>
            <div class="battle-mountains zone-theme-@HeaderTheme"></div>
            <div class="battle-hills zone-theme-@HeaderTheme"></div>
            <img class="al-header-crest" src="@IconUrls.RaceCrestUrl(_engine.Player.Race)" alt="" onerror="this.style.display='none'" />
        </div>
        <div class="al-portrait">
            <img class="al-race-portrait" src="@(_engine.Player.FormPortraitUrl ?? IconUrls.RaceIconUrl(_engine.Player.Race, _engine.Gender))" alt="@_engine.Player.Race" onerror="this.style.display='none'" />
            <img class="al-class-badge" src="@IconUrls.ClassIconUrl(_engine.Player.ActiveClass)" alt="@_engine.Player.ActiveClass" onerror="this.style.display='none'" />
        </div>
        <div class="al-header-info">
            <div class="al-name-line">
                <span class="al-race">@_engine.ActiveCharacterName</span>
                <span class="al-level">Lv. @_engine.Player.Level @_engine.Player.Race</span>
                <span class="al-class class-@(_engine.Player.ActiveClass.ToString().ToLowerInvariant())">@_engine.Player.ActiveClass</span>
                <span class="inv-faction">@_engine.Player.Faction</span>
            </div>
            @{
                var inventory = _engine.Player.Inventory;
                int usedSlots = inventory.TotalSlots - inventory.FreeSlots;
            }
            <div class="al-slot-meter" title="Used bag slots">
                <div class="al-slot-meter-fill" style="width: @(inventory.TotalSlots == 0 ? 0 : usedSlots * 100 / inventory.TotalSlots)%"></div>
                <span>@usedSlots / @inventory.TotalSlots bag slots used</span>
            </div>
        </div>
    </div>

    <div class="inv-layout">
        @* ── Charakter: Paperdoll + Werte ── *@
        @* Color scheme per race crest: wwwroot/css/inventory-crest.css *@
        <div class="al-panel inv-char race-@_engine.Player.Race.ToString().ToLowerInvariant()" style="--i: 0">
            <h4>Character</h4>
            <div class="paperdoll">
                <div class="slot-column">
                    @foreach (var slot in LeftSlots)
                    {
                        @PaperdollSlot(slot)
                    }
                </div>

                <div class="model-area @(_engine.Faction == Faction.Alliance ? "alliance" : "horde")">
                    @* Race crest instead of a 3D model; transition to the panel via glow + mask (inventory.css) *@
                    <img class="model-crest" src="@IconUrls.RaceCrestUrl(_engine.Player.Race)" alt="@_engine.Player.Race" onerror="this.style.display='none'" />
                </div>

                <div class="slot-column">
                    @foreach (var slot in RightSlots)
                    {
                        @PaperdollSlot(slot)
                    }
                </div>
            </div>

            <div class="weapon-row">
                @if (_engine.Player.EquippedWeapon is { } equipped)
                {
                    <WeaponTooltip Weapon="equipped" Hint="@UnequipHint">
                        <div @key="SlotRenderKey(WeaponSlotKey)" class="equip-slot equipped-weapon @SwapCss(WeaponSlotKey)"
                             style="--quality: @ItemQualityColors.Hex(equipped.Quality)"
                             @oncontextmenu="UnequipWeapon" @oncontextmenu:preventDefault
                             @ondragover:preventDefault @ondrop="DropOnWeaponSlot">
                            <img src="@equipped.IconUrl" alt="@equipped.Name" onerror="this.style.display='none'" />
                            @SwapFx(WeaponSlotKey)
                        </div>
                    </WeaponTooltip>
                }
                else
                {
                    <div @key="SlotRenderKey(WeaponSlotKey)" class="equip-slot @SwapCss(WeaponSlotKey)" title="@WeaponSlot.Name (drag weapon here)"
                         @ondragover:preventDefault @ondrop="DropOnWeaponSlot">
                        <img src="@SlotIconUrl(WeaponSlot.Icon)" alt="@WeaponSlot.Name" onerror="this.style.display='none'" />
                        @SwapFx(WeaponSlotKey)
                    </div>
                }
            </div>

            <div class="stats-area">
                <div class="wow-inset stat-box">
                    <StatTooltip StatName="Strength" Description="@StrengthTooltip(_engine.Player.MeleeScalingClass)" IsUseless="@IsStrengthUseless(_engine.Player.MeleeScalingClass)">
                        <div class="wow-stat-row"><span>Strength:</span><span>@Primary.Strength</span>@StatDelta("Strength")</div>
                    </StatTooltip>
                    <StatTooltip StatName="Agility" Description="@AgilityTooltip(_engine.Player.MeleeScalingClass)" IsUseless="@IsAgilityUseless(_engine.Player.MeleeScalingClass)">
                        <div class="wow-stat-row"><span>Agility:</span><span>@Primary.Agility</span>@StatDelta("Agility")</div>
                    </StatTooltip>
                    <StatTooltip StatName="Stamina" Description="@StaminaTooltip()">
                        <div class="wow-stat-row"><span>Stamina:</span><span>@Primary.Stamina</span>@StatDelta("Stamina")</div>
                    </StatTooltip>
                    <StatTooltip StatName="Intellect" Description="@IntellectTooltip(_engine.Player.ActiveClass)" IsUseless="@(!StatScaling.UsesMana(_engine.Player.ActiveClass))">
                        <div class="wow-stat-row"><span>Intellect:</span><span>@Primary.Intelligence</span>@StatDelta("Intellect")</div>
                    </StatTooltip>
                    <StatTooltip StatName="Spirit" Description="@SpiritTooltip(_engine.Player.ActiveClass)">
                        <div class="wow-stat-row"><span>Spirit:</span><span>@Primary.Spirit</span>@StatDelta("Spirit")</div>
                    </StatTooltip>
                </div>
                <div class="wow-inset stat-box">
                    <div class="wow-stat-row"><span>Health:</span><span>@_engine.Player.Stats.MaxHp</span>@StatDelta("Health")</div>
                    <div class="wow-stat-row"><span>@ResourceName:</span><span>@_engine.Player.Stats.MaxMana</span>@StatDelta("Mana")</div>
                    @if (StatScaling.UsesMana(_engine.Player.ActiveClass))
                    {
                        <div class="wow-stat-row"><span>Mana / 5s:</span><span>@_engine.Player.Stats.ManaRegenPer5</span>@StatDelta("ManaRegen")</div>
                    }
                    <div class="wow-stat-row" title="Passive health regeneration from Spirit">
                        <span>Health / 5s:</span><span>@_engine.Player.Stats.HpRegenPer5</span>@StatDelta("HpRegen")
                    </div>
                    <div class="wow-stat-row"><span>Attack Power:</span><span>@_engine.Player.Stats.AttackPower</span>@StatDelta("AttackPower")</div>
                    <div class="wow-stat-row" title="Critical hits double damage, healing and shields">
                        <span>Crit Chance:</span><span>@FormatPercent(_engine.Player.Stats.CritChance)</span>@StatDelta("Crit")
                    </div>
                    <div class="wow-stat-row" title="Speeds up auto-attacks and ability cooldowns">
                        <span>Attack Speed:</span><span>@FormatBonusPercent(_engine.Player.Stats.AttackSpeedBonus)</span>@StatDelta("AttackSpeed")
                    </div>
                </div>
            </div>
        </div>

        @* ── Taschen ── *@
        @* Background: map of the faction capital (Stormwind / Orgrimmar) *@
        <div class="al-panel inv-bags @(_merchantOpen ? "selling" : "")" style="--i: 1">
            <div class="inv-bags-map" aria-hidden="true" style="background-image: url('@IconUrls.CapitalMapUrl(_engine.Faction)')"></div>
            <h4>Bags</h4>
            <!-- Bag bar: Bag 4 … Bag 1, Backpack (right to left, like the original) -->
            <div class="bag-bar">
                @for (int i = Models.Inventory.BagSlotCount - 1; i >= 0; i--)
                {
                    var bagIndex = i;
                    var bag = _engine.Player.Inventory.Bags[bagIndex];
                    if (bag is null)
                    {
                        var unlockLevel = Models.Inventory.BagUnlockLevels[bagIndex];
                        var lockedText = _engine.Player.Level < unlockLevel
                            ? $"Unlocks at level {unlockLevel}."
                            : "Empty.";
                        <StatTooltip StatName="@($"Bag Slot {bagIndex + 1}")" Description="@lockedText">
                            <div class="bar-slot empty bag-locked">
                                <img src="@EmptyBagSlotIconUrl" alt="" onerror="this.style.display='none'" />
                            </div>
                        </StatTooltip>
                    }
                    else
                    {
                        var nextGrowth = Models.Inventory.NextBagGrowthLevel(_engine.Player.Level);
                        var bagTitle = bag.Source is null
                            ? $"{bag.Name} — {bag.FreeSlots}/{bag.SlotCount} free • Grows to {bag.SlotCount + 1} slots at level {nextGrowth}"
                            : $"{bag.Name} — {bag.FreeSlots}/{bag.SlotCount} free";
                        <button class="bar-slot @(OpenContainers.Contains(bagIndex) ? "open" : "")"
                                title="@bagTitle"
                                @onclick="() => ToggleContainer(bagIndex)">
                            <img src="@bag.IconUrl" alt="@bag.Name" onerror="this.style.display='none'" />
                        </button>
                    }
                }
                @{ var backpack = _engine.Player.Inventory.Backpack; }
                <button class="bar-slot backpack @(OpenContainers.Contains(BackpackIndex) ? "open" : "")"
                        title="Backpack (@_engine.Player.Inventory.FreeSlots/@_engine.Player.Inventory.TotalSlots free)"
                        @onclick="() => ToggleContainer(BackpackIndex)">
                    <img src="@backpack.IconUrl" alt="Backpack" onerror="this.style.display='none'" />
                </button>
            </div>

            @* Backpack always on the left, further bags to the right of it in a 2-column grid *@
            <div class="bags-area">
                @if (OpenContainers.Contains(BackpackIndex))
                {
                    @BagFrame(BackpackIndex)
                }
                @if (OpenContainers.Any(i => i != BackpackIndex))
                {
                    <div class="bags-side">
                        @foreach (var index in OpenContainers.Where(i => i != BackpackIndex).Order())
                        {
                            @BagFrame(index)
                        }
                    </div>
                }
            </div>
        </div>

        @* ── Merchant on the right: click first, then the trade window opens ── *@
        <aside class="inv-merchant-col @(_merchantOpen ? "trading" : "")" style="--i: 2">
            @if (_speech is not null)
            {
                @* Speech bubble: remounted per line (@key) → pop-in, stay briefly, fade out *@
                <div @key="_speechKey" class="inv-speech" role="status">
                    <span class="inv-speech-text">@_speech</span>
                </div>
            }
            @if (_merchantOpen)
            {
                <MerchantWindow OnClose="CloseMerchant" OnDrop="DropOnMerchant" OnBuy="BuyFromMerchant" OnBuyback="BuybackFromMerchant"
                                DragActive="_dragSource.HasValue"
                                Message="@_merchantMessage" MessageFailed="_merchantMessageFailed"
                                Fx="_merchantFx" FxKey="_fxKey" SpeechKey="_speechKey" />
            }
            else
            {
                <button class="inv-merchant-npc" title="Talk to @MerchantRegistry.Name"
                        @onclick="OpenMerchant" @oncontextmenu="OpenMerchant" @oncontextmenu:preventDefault>
                    <span @key="_speechKey" class="al-portrait inv-npc-portrait @(_speechKey > 0 ? "talking" : "")">
                        <img class="al-race-portrait" src="@MerchantRegistry.PortraitUrl" alt="@MerchantRegistry.Name" onerror="this.style.display='none'" />
                        <img class="al-class-badge" src="@MerchantRegistry.BadgeUrl" alt="" onerror="this.style.display='none'" />
                    </span>
                    <span class="inv-npc-name">@MerchantRegistry.Name</span>
                    <span class="inv-npc-title">&lt;@MerchantRegistry.Title&gt;</span>
                    <span class="inv-npc-greeting">@MerchantRegistry.Greeting</span>
                    <span class="inv-npc-cta">Click to trade</span>
                </button>
            }
        </aside>
    </div>
</div>

@* ═══ STAPEL TEILEN (Shift-Linksklick) ═══ *@
@if (_split is { } split && ContainerAt(split.bagIndex)?.Slots[split.slotIndex] is { } splitStack)
{
    <div class="split-backdrop" @onclick="CancelSplit"></div>
    <div class="split-dialog">
        <div class="split-title">
            <img src="@splitStack.Item.IconUrl" alt="" onerror="this.style.display='none'" />
            <span style="color: @ItemQualityColors.Hex(splitStack.Item.Quality)">@splitStack.Item.Name</span>
        </div>
        <div class="split-row">
            <button class="split-arrow" @onclick="() => ChangeSplit(-1)" disabled="@(_splitAmount <= 1)">◀</button>
            <input type="number" min="1" max="@(splitStack.Count - 1)" @bind="_splitAmount" @bind:event="oninput"
                   @onkeydown="OnSplitKey" />
            <button class="split-arrow" @onclick="() => ChangeSplit(1)" disabled="@(_splitAmount >= splitStack.Count - 1)">▶</button>
            <span class="split-of">/ @splitStack.Count</span>
        </div>
        @if (_splitError is not null)
        {
            <div class="split-error">@_splitError</div>
        }
        <div class="split-row">
            <button class="wow-btn small" @onclick="ConfirmSplit">Okay</button>
            <button class="wow-btn small" @onclick="CancelSplit">Cancel</button>
        </div>
    </div>
}

@code {
    // Paperdoll slot (armor): right-click unequips, dragging from the bag equips
    private RenderFragment PaperdollSlot(EquipSlot slot)
    {
        var gear = EquippedIn(slot);
        var slotKey = slot.Armor is { } armorSlot ? SlotKey(armorSlot) : null;
        return @<ArmorTooltip Armor="gear" Class="tt-contents" Hint="@(gear is not null ? UnequipHint : null)">
                   <div @key="SlotRenderKey(slotKey)" class="equip-slot @SlotCss(gear) @SwapCss(slotKey)"
                        title="@SlotHint(slot, gear)"
                        style="--quality: @SlotQuality(gear)"
                        @ondragover:preventDefault="@CanDropArmor(slot)"
                        @ondrop="() => DropOnArmorSlot(slot.Armor)"
                        @oncontextmenu="() => UnequipArmorSlot(slot.Armor)"
                        @oncontextmenu:preventDefault="@(gear is not null)">
                       <img src="@SlotImage(slot, gear)" alt="@slot.Name" onerror="this.style.display='none'" />
                       @SwapFx(slotKey)
                   </div>
               </ArmorTooltip>;
    }

    // Swap effect in the slot: light ring + old icon dissolves (only in the most recently changed slot)
    private RenderFragment SwapFx(string? slotKey) => __builder =>
    {
        if (!IsSwapping(slotKey)) return;
        <span class="swap-ring" aria-hidden="true"></span>
        @if (_swapOldIcon is not null)
        {
            <img class="swap-ghost" src="@_swapOldIcon" alt="" aria-hidden="true" />
        }
    };

    // Floating stat change (+/−) after a gear swap
    private RenderFragment StatDelta(string stat) => __builder =>
    {
        if (!_statDeltas.TryGetValue(stat, out var delta)) return;
        <span @key="_swapKey" class="stat-delta @(delta > 0 ? "up" : "down")">@FormatDelta(stat, delta)</span>
    };

    // Bag window with header, slot grid and (only for the backpack) money display
    private RenderFragment BagFrame(int containerIndex) => __builder =>
    {
        var bag = ContainerAt(containerIndex);
        if (bag is null) return;

        var frameNextGrowth = Models.Inventory.NextBagGrowthLevel(_engine.Player.Level);
        var framePortraitTitle = bag.Source is null
            ? $"{bag.SlotCount} slots • Grows to {bag.SlotCount + 1} slots at level {frameNextGrowth}"
            : $"{bag.SlotCount} slots";

        <div @key="containerIndex" class="bag-frame">
            <div class="bag-frame-header">
                <img class="bag-portrait" title="@framePortraitTitle" src="@bag.IconUrl" alt="" onerror="this.style.display='none'" />
                <span class="bag-title">
                    @bag.Name
                    <span class="bag-slot-count">(@bag.SlotCount)</span>
                </span>
                <button class="bag-close" title="Close" @onclick="() => ToggleContainer(containerIndex)">×</button>
            </div>

            <div class="bag-grid">
                @for (int pad = 0; pad < (4 - bag.SlotCount % 4) % 4; pad++)
                {
                    <div class="bag-slot-pad"></div>
                }
                @for (int s = 0; s < bag.Slots.Count; s++)
                {
                    @BagSlot(containerIndex, s, bag.Slots[s])
                }
            </div>

            @if (containerIndex == BackpackIndex)
            {
                <div class="bag-money">
                    <MoneyFrame Copper="_engine.Player.Copper" />
                </div>
            }
        </div>
    };

    // Bag slot: right-click sells when the merchant is open, otherwise equip/use
    private RenderFragment BagSlot(int containerIndex, int si, ItemStack? stack)
    {
        if (stack is null) return @<div class="bag-slot empty"></div>;

        var weaponItem = stack.Item as WeaponItem;
        var armorItem  = stack.Item as ArmorItem;
        bool classLocked = weaponItem?.RequiredClass is { } req && req != _engine.Player.ActiveClass;
        if (classLocked) return @<div class="bag-slot empty"></div>;

        bool levelLocked = !_engine.Player.MeetsItemRequirements(stack.Item);
        var slotCss = weaponItem is not null ? "bag-slot weapon-item"
                    : armorItem  is not null ? "bag-slot armor-item"
                    :                         "bag-slot sellable-item";
        if (levelLocked) slotCss += " level-locked";
        if (_merchantOpen) slotCss += " sell-mode";
        string? gearHint = _merchantOpen ? SellHint : levelLocked ? null : EquipHint;

        RenderFragment content = @<div class="@slotCss"
                                       title="@(stack.Item is WeaponItem or ArmorItem or TradeItem ? null : stack.Item.Name)"
                                       style="--quality: @ItemQualityColors.Hex(stack.Item.Quality)"
                                       draggable="true"
                                       @ondragstart="() => StartDrag(containerIndex, si)"
                                       @ondragend="ClearDrag"
                                       @onclick="e => OnSlotClick(e, containerIndex, si)"
                                       @oncontextmenu="() => OnSlotRightClick(containerIndex, si)"
                                       @oncontextmenu:preventDefault="@PreventContextMenu(stack.Item)">
                                      <img src="@stack.Item.IconUrl" alt="@stack.Item.Name" onerror="this.style.display='none'" />
                                      @if (stack.Count > 1)
                                      {
                                          <span class="stack-count">@stack.Count</span>
                                      }
                                  </div>;

        if (armorItem is not null)
            return @<ArmorTooltip Armor="armorItem" Class="tt-contents" Hint="@gearHint" RequirementsMet="@(!levelLocked)"
                                  Compare="@EquippedArmorFor(armorItem)">@content</ArmorTooltip>;
        if (stack.Item is TradeItem tradeItem)
            return @<TradeItemTooltip Item="tradeItem" Class="tt-contents" Count="stack.Count" Hint="@TradeHint(tradeItem)">@content</TradeItemTooltip>;
        return @<WeaponTooltip Weapon="weaponItem" Class="tt-contents" Hint="@gearHint" RequirementsMet="@(!levelLocked)"
                               Compare="@(weaponItem is not null ? _engine.Player.EquippedWeapon : null)">@content</WeaponTooltip>;
    }
}
