@page "/talents"
@using Models
@inject IdleGameEngine Engine
@implements IDisposable

@* Styles: wwwroot/css/talents.css – logic in Talents.razor.cs *@

<PageTitle>Talents</PageTitle>

<div class="wow-page talents-page">
    <h2>Talents</h2>

    @* ── Header: character on the scene of its current zone (styles from ability-loadout.css) ── *@
    <div class="al-header @(Engine.Faction == Faction.Alliance ? "alliance" : "horde") @(CombatZoneRegistry.IsNightTheme(HeaderTheme) ? "night" : "day")">
        <div class="al-scenery" aria-hidden="true">
            <div class="al-sky zone-theme-@HeaderTheme"></div>
            <div class="battle-mountains zone-theme-@HeaderTheme"></div>
            <div class="battle-hills zone-theme-@HeaderTheme"></div>
            <img class="al-header-crest" src="@IconUrls.RaceCrestUrl(Engine.Race)" alt="" onerror="this.style.display='none'" />
        </div>
        <div class="al-portrait">
            <img class="al-race-portrait" src="@(Engine.Player.FormPortraitUrl ?? IconUrls.RaceIconUrl(Engine.Race, Engine.Gender))" alt="@Engine.Race" onerror="this.style.display='none'" />
            <img class="al-class-badge" src="@IconUrls.ClassIconUrl(Engine.PlayerClass)" alt="@Engine.PlayerClass" onerror="this.style.display='none'" />
        </div>
        <div class="al-header-info">
            <div class="al-name-line">
                <span class="al-race">@Engine.ActiveCharacterName</span>
                <span class="al-level">Lv. @Engine.Player.Level @Engine.Race</span>
                <span class="al-class class-@Engine.PlayerClass.ToString().ToLowerInvariant()">@Engine.PlayerClass</span>
            </div>
        </div>
        <div class="talent-points-badge">
            <span class="pts-label">Unspent</span>
            <span class="pts-value @(AvailablePoints > 0 ? "pts-available" : "pts-zero")">@AvailablePoints</span>
        </div>
    </div>

    @if (Engine.Player.Level < 10)
    {
        <div class="wow-alert warning">Talent points are earned starting at level 10.</div>
    }

    <div class="trees-wrapper">
        @for (int ti = 0; ti < 3; ti++)
        {
            var treeIndex = ti;
            var invested  = State.TotalInvestedInTree(ActiveClass, treeIndex);
            var talents   = TalentRegistry.GetTalents(ActiveClass).Where(t => t.TreeIndex == treeIndex).ToList();

            @* Root-relative: url() in a custom property resolves against talents.css (/css/), not the page *@
            <div class="talent-tree" style="--tree-bg: url('/@TalentRegistry.GetTreeBackgroundUrl(ActiveClass, treeIndex)')">
                <div class="tree-header">
                    <span class="tree-name">@TreeNames[treeIndex]</span>
                    <span class="tree-points">@invested pts</span>
                </div>

                <div class="talent-grid">
                    @* ── Vertical tier rail: points needed per row ── *@
                    <div class="tier-track" aria-hidden="true">
                        <div class="tier-track-fill" style="height: @TrackFillPercent(invested)%"></div>
                    </div>
                    @for (int row = 1; row < TalentRegistry.RowCount; row++)
                    {
                        var tier = TierInfo(treeIndex, row);
                        <div class="tier-badge @tier.CssClass" style="grid-row: @(row + 1)" title="@tier.Title">@tier.Text</div>
                    }

                    @* ── Requirement arrows (always straight down in the same column) ── *@
                    @foreach (var (from, to) in Arrows(talents))
                    {
                        <div class="talent-arrow @(State.GetRanks(from.Id) > 0 ? "arrow-active" : "")"
                             style="grid-column: @(to.Column + 2); grid-row: @(from.Row + 1) / @(to.Row + 2)"
                             aria-hidden="true"></div>
                    }

                    @foreach (var talent in talents)
                    {
                        var ranks    = State.GetRanks(talent.Id);
                        var missing  = State.MissingRequirements(talent, Engine.Player.Level).ToList();
                        var canSpend = State.CanInvest(talent, AvailablePoints, Engine.Player.Level);

                        <div class="talent-cell" style="grid-column: @(talent.Column + 2); grid-row: @(talent.Row + 1)">
                            <TalentTooltip Talent="talent" Ranks="ranks" Missing="missing" CanLearn="canSpend">
                                <div class="talent-node @NodeClass(talent, ranks, missing.Count > 0, canSpend)"
                                     @onclick="() => OnTalentClick(talent)"
                                     @oncontextmenu="() => OnTalentRightClick(talent)" @oncontextmenu:preventDefault>
                                    <img src="@talent.IconUrl" alt="@talent.Name" class="talent-icon" onerror="this.style.display='none'" />
                                    <span class="talent-ranks">@ranks/@talent.MaxRanks</span>
                                </div>
                            </TalentTooltip>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="talent-actions">
        <button class="talent-reset-btn" disabled="@(TotalSpent == 0)" @onclick="OnReset">
            <img class="talent-reset-icon" src="https://wow.zamimg.com/images/wow/icons/medium/spell_holy_dispelmagic.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" />
            Reset Talents
        </button>
    </div>

    @if (_message is not null)
    {
        <div class="wow-alert @(_messagePositive ? "success" : "warning")">@_message</div>
    }
</div>
