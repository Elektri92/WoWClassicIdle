@page "/ability-loadout"
@using Models
@using Services
@inject IAbilityLoadoutService LoadoutService
@inject IdleGameEngine Engine
@implements IDisposable

<PageTitle>Ability Loadout</PageTitle>

@* Styles: wwwroot/css/ability-loadout.css – Logik in AbilityLoadout.razor.cs *@
<div class="wow-page narrow ability-loadout-page">
    <h2 class="al-title">Ability Loadout</h2>
    <p class="wow-hint al-hint">Click a spell to equip or remove it. Pick a specific rank on its rank track.</p>

    @* ── Kopf: Charakter auf der Szene seiner aktuellen Zone ── *@
    <div class="al-header @(Engine.Faction == Faction.Alliance ? "alliance" : "horde") @(CombatZoneRegistry.IsNightTheme(HeaderTheme) ? "night" : "day")">
        <div class="al-scenery" aria-hidden="true">
            <div class="al-sky zone-theme-@HeaderTheme"></div>
            <div class="battle-mountains zone-theme-@HeaderTheme"></div>
            <div class="battle-hills zone-theme-@HeaderTheme"></div>
            <img class="al-header-crest" src="@IconUrls.RaceCrestUrl(Engine.Race)" alt="" onerror="this.style.display='none'" />
        </div>
        <div class="al-portrait">
            <img class="al-race-portrait" src="@(Engine.Player.FormPortraitUrl ?? IconUrls.RaceIconUrl(Engine.Race, Engine.Gender))" alt="@Engine.Race" onerror="this.style.display='none'" />
            <img class="al-class-badge" src="@IconUrls.ClassIconUrl(Engine.PlayerClass)" alt="@Engine.PlayerClass" onerror="this.style.display='none'" />
        </div>
        <div class="al-header-info">
            <div class="al-name-line">
                <span class="al-race">@Engine.ActiveCharacterName</span>
                <span class="al-level">Lv. @Engine.Player.Level @Engine.Race</span>
                <span class="al-class class-@Engine.PlayerClass.ToString().ToLowerInvariant()">@Engine.PlayerClass</span>
            </div>
            <div class="al-slot-meter" title="Equipped slots">
                <div class="al-slot-meter-fill" style="width: @(CurrentLoadout.Count * 100 / ClassAbilityRegistry.MaxSlotsPerClass)%"></div>
                <span>@CurrentLoadout.Count / @ClassAbilityRegistry.MaxSlotsPerClass slots</span>
            </div>
        </div>
    </div>

    @if (CurrentPool.Count == 0)
    {
        <div class="wow-alert warning">No abilities available for this class.</div>
    }
    else
    {
        <div class="loadout-grid">

            @* ── Ausgerüstete Slots als Aktionsleiste, links und rechts von Greifen eingerahmt ── *@
            <div class="action-bar-wrap" style="--i: 0">
                <img class="al-gryphon left" src="images/gryphon-left.png" alt="" aria-hidden="true" />
                <img class="al-gryphon right" src="images/gryphon-right.png" alt="" aria-hidden="true" />
                <div class="action-bar">
                @for (int i = 0; i < ClassAbilityRegistry.MaxSlotsPerClass; i++)
                {
                    var slotIndex = i;
                    var equippedId = slotIndex < CurrentLoadout.EquippedAbilityIds.Count
                        ? CurrentLoadout.EquippedAbilityIds[slotIndex]
                        : null;
                    var equippedAbility = equippedId != null
                        ? CurrentPool.FirstOrDefault(a => a.Id == equippedId)
                        : null;
                    var upgrade = equippedAbility is null ? null : UpgradeFor(equippedAbility);

                    <AbilityTooltip @key="@($"{slotIndex}:{equippedAbility?.Id ?? "empty"}")"
                                    Ability="equippedAbility is null ? null : Engine.Player.GetEffectiveAbility(equippedAbility)"
                                    PlayerLevel="Engine.Player.Level" Class="tt-block">
                        <div class="slot @(equippedAbility != null ? "filled" : "empty")" style="--i: @slotIndex"
                             @onclick="() => OnSlotClicked(slotIndex)">
                            <span class="slot-number">@(slotIndex + 1)</span>
                            @if (equippedAbility != null)
                            {
                                <span class="slot-icon">
                                    <img src="@equippedAbility.IconUrl" alt="@equippedAbility.Name" />
                                    <span class="slot-remove" aria-hidden="true">✕</span>
                                </span>
                                <span class="slot-label">
                                    <span class="slot-name">@equippedAbility.Name</span>
                                    @if (_multiRankNames.Contains(equippedAbility.Name))
                                    {
                                        <span class="rank-badge">Rank @equippedAbility.Rank</span>
                                    }
                                </span>
                                @if (upgrade is not null)
                                {
                                    <button class="slot-upgrade" title="@($"Upgrade to Rank {upgrade.Rank}")"
                                            @onclick:stopPropagation="true" @onclick="() => OnRankClicked(upgrade)">
                                        ▲ R@(upgrade.Rank)
                                    </button>
                                }
                            }
                            else
                            {
                                <span class="slot-icon empty-icon" aria-hidden="true">+</span>
                                <span class="slot-placeholder">Empty slot</span>
                            }
                        </div>
                    </AbilityTooltip>
                }
                </div>
            </div>

            @* ── Zauberbuch: ein Eintrag je Zauber, Ränge auf einer Leiste ── *@
            @* Pergament-Look: wwwroot/css/spellbook.css *@
            <div class="al-panel pool-column spellbook" style="--i: 1">
                <h4 class="spellbook-title">Spellbook</h4>

                <div class="pool-filters">
                    <input class="pool-search" type="search" placeholder="Search…"
                           @bind="_search" @bind:event="oninput" />
                    <div class="pool-tabs">
                        @foreach (var cat in Enum.GetValues<AbilityCategory>())
                        {
                            var c = cat;
                            <button class="wow-tab @(_categoryFilter == c ? "active" : "")"
                                    @onclick="() => _categoryFilter = c">
                                @c
                            </button>
                        }
                    </div>
                </div>

                <div class="spellbook-parchment">
                @{
                    var known = FilteredKnown;
                    var comingUp = FilteredComingUp;
                    int poolIndex = 0;
                }
                <div class="spell-grid">
                @foreach (var group in known)
                {
                    var conflict = ConflictOf(group);
                    <SpellCard @key="group.Name" Group="group" Index="poolIndex++" Player="Engine.Player"
                               SlotNumber="SlotNumberOf(group.Equipped)"
                               Conflict="conflict" ConflictSlot="SlotNumberOf(conflict)"
                               OnToggle="() => OnSpellClicked(group)" OnRank="OnRankClicked" />
                }
                </div>

                @if (known.Count == 0 && string.IsNullOrEmpty(_search) && _categoryFilter == AbilityCategory.All)
                {
                    <div class="wow-alert warning" style="margin:8px 0 0;">No abilities available.</div>
                }
                else if (known.Count == 0)
                {
                    <div class="pool-empty">No abilities match this filter.</div>
                }

                @if (HiddenByFormCount > 0)
                {
                    <div class="pool-empty">
                        @HiddenByFormCount @(HiddenByFormCount == 1 ? "ability is" : "abilities are") hidden – not usable in @(ShapeshiftForms.Get(CurrentForm)?.Name ?? "your current form or stance").
                    </div>
                }

                @if (comingUp.Count > 0)
                {
                    <button class="pool-divider coming-up-toggle @(_comingUpExpanded ? "open" : "")" @onclick="() => _comingUpExpanded = !_comingUpExpanded">
                        <span>Coming Up (@comingUp.Count)</span>
                        <span class="toggle-arrow" aria-hidden="true">▼</span>
                    </button>
                    @if (_comingUpExpanded)
                    {
                        <div class="coming-up-list spell-grid">
                            @{ int lockedIndex = 0; }
                            @foreach (var group in comingUp)
                            {
                                <SpellCard @key="group.Name" Group="group" Index="lockedIndex++" Player="Engine.Player" />
                            }
                        </div>
                    }
                }
                </div>
            </div>
        </div>

        @if (_statusMessage != "")
        {
            <div @key="_statusVersion" class="wow-alert al-status @(_statusPositive ? "success" : "warning")">@_statusMessage</div>
        }
    }
</div>
