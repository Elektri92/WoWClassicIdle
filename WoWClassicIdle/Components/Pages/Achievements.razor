@page "/achievements"
@using Models
@using Services

<PageTitle>Achievements</PageTitle>

@* Stage: centers the window in the content area, subtle map background (achievements-stage.css) *@
<div class="ach-stage">
<div class="ach-stage-bg" aria-hidden="true">
    <div class="ach-stage-map"></div>
    <div class="ach-stage-glow"></div>
</div>
<div class="ach-window">

    <!-- ══ KOPFLEISTE: Filter · Punkte-Plakette · Suche ══ -->
    <div class="ach-header">
        <select class="ach-filter" @bind="_filter">
            @foreach (var f in Enum.GetValues<AchievementFilter>())
            {
                <option value="@f">@f</option>
            }
        </select>

        <div class="ach-plaque">
            <span class="ach-plaque-label">Achievement Points</span>
            <div class="ach-plaque-box">
                <span>@Num(_achievements.TotalPoints)</span>
                <span class="ach-mini-shield"></span>
            </div>
        </div>

        <div class="ach-search">
            <span class="ach-search-icon">⚲</span>
            <input type="text" placeholder="Search" @bind="_search" @bind:event="oninput" />
        </div>
    </div>

    <div class="ach-body">

        <!-- ── KATEGORIEN ── -->
        <nav class="ach-cats">
            <button class="ach-cat @(_category is null && !IsSearching ? "active" : "")" @onclick="ShowSummary">
                Summary
            </button>
            @foreach (var cat in Enum.GetValues<AchievementCategory>())
            {
                var c = cat;
                bool catActive = _category == c && _classFilter is null && !IsSearching;
                <button class="ach-cat @(catActive ? "active" : "")" @onclick="() => ShowCategory(c)">
                    @c
                </button>

                @if (c == AchievementCategory.Classes && _category == AchievementCategory.Classes && !IsSearching)
                {
                    @foreach (var cls in Enum.GetValues<CharacterClass>())
                    {
                        var k = cls;
                        <button class="ach-cat ach-subcat @(_classFilter == k ? "active" : "")" @onclick="() => ShowClass(k)">
                            @k
                        </button>
                    }
                }
            }
        </nav>

        <!-- ── INHALT ── -->
        <div class="ach-pane">
            @if (_category is null && !IsSearching)
            {
                var recent = GetRecentEarned();
                <div class="ach-section-title">Recent Achievements</div>
                @if (recent.Count > 0)
                {
                    <div class="ach-list">
                        @foreach (var (def, earned) in recent)
                        {
                            @AchievementRow(def, earned)
                        }
                    </div>
                }
                else
                {
                    <div class="ach-empty">No achievements earned yet. Start fighting!</div>
                }

                var total = CountFor(_ => true);
                <div class="ach-section-title">Progress Overview</div>
                <div class="ach-overview-total">
                    @ProgressBar("Achievements Earned", total.Earned, total.Total)
                </div>
                <div class="ach-overview-grid">
                    @foreach (var cat in Enum.GetValues<AchievementCategory>())
                    {
                        var c = cat;
                        var (earnedCnt, totalCnt) = CountFor(a => a.Category == c);
                        <div class="ach-overview-cell" @onclick="() => ShowCategory(c)">
                            @ProgressBar(c.ToString(), earnedCnt, totalCnt)
                        </div>
                    }
                </div>
            }
            else
            {
                var groups = GetVisibleGroups();
                @if (groups.Count == 0)
                {
                    <div class="ach-empty">@(IsSearching ? "No achievements match your search." : "No achievements to show.")</div>
                }
                <div class="ach-list">
                    @foreach (var group in groups)
                    {
                        @if (group.Key is CharacterClass cls)
                        {
                            <div class="ach-group-header">
                                <img src="@IconUrls.ClassIconUrl(cls)" alt="" onerror="this.style.display='none'" />
                                <span>@cls</span>
                                <span class="ach-group-count">@group.Count(a => _achievements.IsEarned(a.Id)) / @group.Count()</span>
                            </div>
                        }
                        @foreach (var def in group)
                        {
                            @AchievementRow(def, _achievements.GetEarned(def.Id))
                        }
                    }
                </div>
            }
        </div>
    </div>
</div>
</div>

@code {
    // A WoW-style achievement row: icon · title/description/progress · points shield + date
    private RenderFragment AchievementRow(AchievementDefinition def, EarnedAchievement? earned)
    {
        bool isEarned = earned is not null;
        var progress = isEarned ? null : _achievements.GetProgress(def.Id);
        return @<div class="ach-row @(isEarned ? "earned" : "locked")">
            <div class="ach-row-icon">
                <img src="@def.IconUrl" alt=""
                     onerror="this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 width=%2248%22 height=%2248%22><rect fill=%22%23444%22 width=%2248%22 height=%2248%22/></svg>'" />
            </div>
            <div class="ach-row-text">
                <div class="ach-row-title">@def.Title</div>
                <div class="ach-row-desc">@def.Description</div>
                @if (progress is not null)
                {
                    <div class="ach-progress">
                        <div class="ach-progress-fill" style="width: @Pct(progress.Percent)"></div>
                        <span class="ach-progress-text">@Num(progress.Current) / @Num(progress.Target)</span>
                    </div>
                }
            </div>
            <div class="ach-row-reward">
                <div class="ach-shield"><span>@def.Points</span></div>
                @if (earned is not null)
                {
                    <span class="ach-row-date" title="@earned.EarnedAt.ToLocalTime().ToString("dd MMM yyyy, HH:mm", System.Globalization.CultureInfo.InvariantCulture)">
                        @earned.EarnedAt.ToLocalTime().ToString("dd/MM/yy", System.Globalization.CultureInfo.InvariantCulture)
                    </span>
                }
            </div>
        </div>;
    }

    // Labeled progress bar for the overview
    private RenderFragment ProgressBar(string label, int earnedCnt, int totalCnt)
    {
        double pct = totalCnt > 0 ? earnedCnt * 100.0 / totalCnt : 0;
        return @<div class="ach-ov">
            <span class="ach-ov-label">@label</span>
            <div class="ach-progress">
                <div class="ach-progress-fill" style="width: @Pct(pct)"></div>
                <span class="ach-progress-text">@earnedCnt / @totalCnt</span>
            </div>
        </div>;
    }
}
