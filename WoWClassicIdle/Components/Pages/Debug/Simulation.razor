@code {
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;
    private static readonly CharacterClass[] AllClasses = Enum.GetValues<CharacterClass>();

    // ─── Einstellungen ───
    private int _levelFrom = 1;
    private int _levelTo = 6;
    private double _minutesPerRun = 60;
    private int _outlierPercent = 25;
    private double OutlierThreshold => _outlierPercent / 100.0;
    private readonly HashSet<CharacterClass> _selectedClasses = new(AllClasses);

    // ─── Modus ───
    private string _mode = "bench";

    // ─── Laufzustand ───
    private readonly List<SimulationResult> _results = new();
    private readonly object _resultsLock = new();
    private readonly List<LevelingResult> _levelingResults = new();
    private readonly object _levelingResultsLock = new();
    private readonly HashSet<(CharacterClass, int)> _lrExpanded = new();
    private string _currentRunLabel = "";
    private CancellationTokenSource? _cts;
    private bool _running;
    private int _totalRuns;
    private TimeSpan _elapsed;
    private DateTime _startedAt;
    private string? _error;

    // ─── AI-Export ───
    private string _aiSummary = "";
    private bool _copied;

    // ─── Ansicht ───
    private string _metricKey = "dps";
    private int _detailLevelFilter;
    private string _sortKey = "dps";
    private bool _sortDesc = true;
    private readonly HashSet<(CharacterClass, int)> _expanded = new();

    private bool CanStart => _selectedClasses.Count > 0 && _levelFrom >= 1 && _levelTo <= 60 && _levelFrom <= _levelTo;
    private double ProgressPercent => _totalRuns > 0 ? 100.0 * (_mode == "race" ? _levelingResults.Count : _results.Count) / _totalRuns : 0;

    // ─── Metriken ───
    private sealed record Metric(string Label, Func<SimulationResult, double> Value, Func<double, string> Format, bool HigherIsBetter);

    private static string F(double v, string fmt) => double.IsNaN(v) ? "–" : double.IsInfinity(v) ? "∞" : v.ToString(fmt, Inv);

    private static string FormatMinutes(double minutes)
    {
        if (double.IsNaN(minutes)) return "–";
        var t = TimeSpan.FromMinutes(minutes);
        return t.TotalHours >= 1 ? $"{(int)t.TotalHours}h {t.Minutes:00}m" : $"{t.Minutes}m {t.Seconds:00}s";
    }

    private static readonly Dictionary<string, Metric> Metrics = new()
    {
        ["dps"]     = new("DPS",          r => r.Dps,            v => F(v, "0.00"), true),
        ["autodps"] = new("Auto DPS",     r => r.AutoDps,        v => F(v, "0.00"), true),
        ["abildps"] = new("Ability DPS",  r => r.AbilityDps,     v => F(v, "0.00"), true),
        ["hps"]     = new("HPS",          r => r.Hps,            v => F(v, "0.00"), true),
        ["dtps"]    = new("DTPS",         r => r.Dtps,           v => F(v, "0.00"), false),
        ["kpm"]     = new("Kills/min",    r => r.KillsPerMin,    v => F(v, "0.00"), true),
        ["ttk"]     = new("Ø TTK",        r => r.AvgTtk,         v => double.IsNaN(v) ? "–" : $"{v.ToString("0.0", Inv)}s", false),
        ["dph"]     = new("Deaths/h",     r => r.DeathsPerHour,  v => F(v, "0.0"), false),
        ["xph"]     = new("XP/h",         r => r.XpPerHour,      v => F(v, "N0"), true),
        ["gph"]     = new("Money/h",      r => r.CopperPerHour,  v => Money.Format((long)v), true),
        ["ttl"]     = new("Time to level", r => r.MinutesToLevel, FormatMinutes, false),
    };

    private sealed record DetailColumn(string Key, string Label, Func<SimulationResult, IComparable> SortValue, Func<SimulationResult, string> Format);

    private static readonly DetailColumn[] DetailColumns =
    {
        new("class",    "Class",       r => r.Class.ToString(), r => r.Class.ToString()),
        new("level",    "Lv",          r => r.Level,            r => r.Level.ToString()),
        new("dps",      "DPS",         r => r.Dps,              r => F(r.Dps, "0.00")),
        new("autodps",  "Auto",        r => r.AutoDps,          r => F(r.AutoDps, "0.00")),
        new("abildps",  "Ability",     r => r.AbilityDps,       r => F(r.AbilityDps, "0.00")),
        new("dmg",      "Damage",      r => r.TotalDamage,      r => r.TotalDamage.ToString("N0", Inv)),
        new("hps",      "HPS",         r => r.Hps,              r => F(r.Hps, "0.00")),
        new("heal",     "Healing",     r => r.TotalHealing,     r => r.TotalHealing.ToString("N0", Inv)),
        new("dtps",     "DTPS",        r => r.Dtps,             r => F(r.Dtps, "0.00")),
        new("taken",    "Dmg taken",   r => r.DamageTaken,      r => r.DamageTaken.ToString("N0", Inv)),
        new("kills",    "Kills",       r => r.Kills,            r => r.Kills.ToString("N0", Inv)),
        new("kpm",      "Kills/min",   r => r.KillsPerMin,      r => F(r.KillsPerMin, "0.00")),
        new("ttk",      "Ø TTK",       r => double.IsNaN(r.AvgTtk) ? double.MaxValue : r.AvgTtk, r => double.IsNaN(r.AvgTtk) ? "–" : $"{r.AvgTtk.ToString("0.0", Inv)}s"),
        new("deaths",   "Deaths",      r => r.Deaths,           r => r.Deaths.ToString("N0", Inv)),
        new("kd",       "Kills/Death", r => r.KillsPerDeath,    r => F(r.KillsPerDeath, "0.0")),
        new("xph",      "XP/h",        r => r.XpPerHour,        r => F(r.XpPerHour, "N0")),
        new("gph",      "Money/h",     r => r.CopperPerHour,    r => Money.Format((long)r.CopperPerHour)),
        new("ttl",      "Time to lvl", r => double.IsNaN(r.MinutesToLevel) ? double.MaxValue : r.MinutesToLevel, r => FormatMinutes(r.MinutesToLevel)),
        new("spawnerr", "Spawn err.",  r => r.SpawnErrors,      r => r.SpawnErrors.ToString("N0", Inv)),
    };

    // ─── Ablauf ───
    private async Task StartAsync()
    {
        if (!CanStart) return;

        _error = null;
        lock (_resultsLock) _results.Clear();
        lock (_levelingResultsLock) _levelingResults.Clear();
        _expanded.Clear();

        var settings = new SimulationSettings(_levelFrom, _levelTo, _minutesPerRun,
            AllClasses.Where(_selectedClasses.Contains).ToList());

        _totalRuns = ClassSimulator.RunCount(settings);
        _running = true;
        _cts = new CancellationTokenSource();
        _startedAt = DateTime.UtcNow;
        StateHasChanged();

        try
        {
            await ClassSimulator.RunAllAsync(settings, result =>
            {
                lock (_resultsLock) _results.Add(result);
                _ = InvokeAsync(StateHasChanged);
            }, _cts.Token);
        }
        catch (OperationCanceledException)
        {
            _error = "Simulation cancelled.";
        }
        catch (Exception ex)
        {
            _error = $"Simulation failed: {ex.Message}";
        }
        finally
        {
            _elapsed = DateTime.UtcNow - _startedAt;
            _running = false;
            _cts?.Dispose();
            _cts = null;
            _aiSummary = BuildAiSummary(Snapshot());
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task StartLevelingAsync()
    {
        if (!CanStart) return;

        _error = null;
        lock (_resultsLock) _results.Clear();
        lock (_levelingResultsLock) _levelingResults.Clear();
        _lrExpanded.Clear();
        _currentRunLabel = "";

        var settings = new SimulationSettings(_levelFrom, _levelTo, _minutesPerRun,
            AllClasses.Where(_selectedClasses.Contains).ToList());

        _totalRuns = ClassSimulator.LevelingRunCount(settings);
        _running = true;
        _cts = new CancellationTokenSource();
        _startedAt = DateTime.UtcNow;
        StateHasChanged();

        try
        {
            await ClassSimulator.RunAllLevelingAsync(settings,
                onResult: result =>
                {
                    lock (_levelingResultsLock) _levelingResults.Add(result);
                    _ = InvokeAsync(StateHasChanged);
                },
                onStart: label =>
                {
                    _currentRunLabel = label;
                    _ = InvokeAsync(StateHasChanged);
                },
                ct: _cts.Token);
        }
        catch (OperationCanceledException)
        {
            _error = "Simulation cancelled.";
        }
        catch (Exception ex)
        {
            _error = $"Simulation failed: {ex.Message}";
        }
        finally
        {
            _elapsed = DateTime.UtcNow - _startedAt;
            _running = false;
            _currentRunLabel = "";
            _cts?.Dispose();
            _cts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task RunSimulationAsync() =>
        await (_mode == "race" ? StartLevelingAsync() : StartAsync());


    private void Cancel() => _cts?.Cancel();

    private List<SimulationResult> Snapshot()
    {
        lock (_resultsLock) return _results.ToList();
    }

    private void SelectAllClasses() => _selectedClasses.UnionWith(AllClasses);

    private void ToggleClass(CharacterClass cls, bool on)
    {
        if (on) _selectedClasses.Add(cls);
        else    _selectedClasses.Remove(cls);
    }

    private void ToggleExpanded(SimulationResult r)
    {
        if (!_expanded.Remove((r.Class, r.Level)))
            _expanded.Add((r.Class, r.Level));
    }

    private void SortBy(string key)
    {
        if (_sortKey == key) _sortDesc = !_sortDesc;
        else { _sortKey = key; _sortDesc = key is not ("class" or "level"); }
    }

    private IEnumerable<SimulationResult> SortedDetails(List<SimulationResult> results)
    {
        var col = DetailColumns.First(c => c.Key == _sortKey);
        var filtered = _detailLevelFilter > 0 ? results.Where(r => r.Level == _detailLevelFilter) : results;
        return _sortDesc ? filtered.OrderByDescending(col.SortValue) : filtered.OrderBy(col.SortValue);
    }

    // ─── Auswertung ───
    private static double MedianFor(List<SimulationResult> results, Metric metric, int level)
    {
        var values = results.Where(r => r.Level == level)
            .Select(metric.Value)
            .Where(v => !double.IsNaN(v) && !double.IsInfinity(v))
            .OrderBy(v => v)
            .ToList();

        if (values.Count == 0) return double.NaN;
        int mid = values.Count / 2;
        return values.Count % 2 == 1 ? values[mid] : (values[mid - 1] + values[mid]) / 2.0;
    }

    /// <summary>Abweichung vom Median, positiv = besser (berücksichtigt "niedriger ist besser").</summary>
    private static double Deviation(Metric metric, double value, double median)
    {
        if (double.IsNaN(value) || double.IsNaN(median) || double.IsInfinity(value)) return double.NaN;
        if (median == 0) return value == 0 ? 0 : double.NaN;
        double dev = (value - median) / median;
        return metric.HigherIsBetter ? dev : -dev;
    }

    private static string CellStyle(double dev)
    {
        if (double.IsNaN(dev)) return "";
        double a = Math.Min(1.0, Math.Abs(dev) / 0.6) * 0.55;
        string rgb = dev >= 0 ? "60, 170, 60" : "200, 50, 40";
        return $"background: rgba({rgb}, {a.ToString("0.###", Inv)});";
    }

    private sealed record Outlier(CharacterClass Class, string Metric, string Levels, double Deviation, bool Better);

    /// <summary>Fasst Ausreißer pro Klasse + Metrik über zusammenhängende Level zusammen.</summary>
    private IEnumerable<Outlier> FindOutliers(List<SimulationResult> results)
    {
        var keys   = new[] { "dps", "kpm", "dph" };
        var levels = results.Select(r => r.Level).Distinct().OrderBy(l => l).ToList();

        foreach (var key in keys)
        {
            var metric = Metrics[key];
            foreach (var cls in results.Select(r => r.Class).Distinct())
            {
                var hits = new List<(int Level, double Dev)>();
                foreach (var lv in levels)
                {
                    var r = results.FirstOrDefault(x => x.Class == cls && x.Level == lv);
                    if (r is null) continue;
                    double dev = Deviation(metric, metric.Value(r), MedianFor(results, metric, lv));
                    if (!double.IsNaN(dev) && Math.Abs(dev) >= OutlierThreshold)
                        hits.Add((lv, dev));
                }

                // Nach Richtung gruppieren, damit "zu stark" und "zu schwach" getrennt bleiben
                foreach (var group in hits.GroupBy(h => h.Dev > 0))
                {
                    var lvs = group.Select(h => h.Level).ToList();
                    yield return new Outlier(cls, metric.Label, FormatLevelList(lvs), group.Average(h => h.Dev), group.Key);
                }
            }
        }
    }

    private static string FormatLevelList(List<int> levels)
    {
        var parts = new List<string>();
        for (int i = 0; i < levels.Count; i++)
        {
            int start = levels[i];
            while (i + 1 < levels.Count && levels[i + 1] == levels[i] + 1) i++;
            parts.Add(start == levels[i] ? $"{start}" : $"{start}–{levels[i]}");
        }
        return string.Join(", ", parts);
    }

    private static string ClassCss(CharacterClass cls) => cls.ToString().ToLowerInvariant();

    // ─── AI-Export ───
    private async Task CopyAiSummaryAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _aiSummary);
            _copied = true;
            StateHasChanged();
            await Task.Delay(2000);
            _copied = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard-Zugriff verweigert – Text bleibt im Textarea sichtbar
        }
    }

    private string BuildAiSummary(List<SimulationResult> results)
    {
        if (results.Count == 0) return "";
        var sb      = new System.Text.StringBuilder();
        var levels  = results.Select(r => r.Level).Distinct().OrderBy(l => l).ToList();
        var classes = results.Select(r => r.Class).Distinct().OrderBy(c => c.ToString()).ToList();

        sb.AppendLine("## Simulation Results");
        sb.AppendLine($"Classes: {string.Join(", ", classes)}");
        sb.AppendLine($"Levels: {levels.First()}–{levels.Last()}  |  Game time/run: {_minutesPerRun} min  |  Outlier threshold: ±{_outlierPercent}%");
        sb.AppendLine();

        // ── Kennzahlen-Tabelle ──
        sb.AppendLine("### Key Metrics");
        sb.AppendLine("Class        | Lv | DPS   | Auto% | Abil% | Kills/m | Deaths/h | K/D   | XP/h     | Money/h  | ToNextLv");
        sb.AppendLine("-------------|----+-------+-------+-------+---------+----------+-------+----------+----------+---------");
        foreach (var r in results.OrderBy(r => r.Class.ToString()).ThenBy(r => r.Level))
        {
            double autoShare = r.Dps > 0 ? r.AutoDps / r.Dps : 0;
            double abilShare = r.Dps > 0 ? r.AbilityDps / r.Dps : 0;
            string kd        = double.IsInfinity(r.KillsPerDeath) ? "∞" : r.KillsPerDeath.ToString("0.0", Inv);
            string ttl       = double.IsNaN(r.MinutesToLevel) ? "–" : FormatMinutes(r.MinutesToLevel);
            sb.AppendLine(string.Format(Inv,
                "{0,-13}| {1,2} | {2,5:0.00} | {3,4:0%} | {4,4:0%} | {5,7:0.00} | {6,8:0.0} | {7,5} | {8,8:N0} | {9,-8} | {10}",
                r.Class, r.Level, r.Dps, autoShare, abilShare,
                r.KillsPerMin, r.DeathsPerHour, kd,
                (long)r.XpPerHour, Money.Format((long)r.CopperPerHour), ttl));
        }
        sb.AppendLine();

        // ── Outlier-Liste ──
        sb.AppendLine($"### Outliers (≥{_outlierPercent}% from level median — DPS / Kills/min / Deaths/h)");
        var outliers = FindOutliers(results).ToList();
        if (outliers.Count == 0)
            sb.AppendLine("None.");
        else
            foreach (var o in outliers)
                sb.AppendLine($"  {o.Deviation.ToString("+0%;-0%", Inv)}  {o.Class}  {o.Metric}  Lv {o.Levels}");
        sb.AppendLine();

        // ── Ability-Breakdown ──
        sb.AppendLine("### Ability Breakdown (share of total damage / healing per class per level)");
        foreach (var cls in classes)
        {
            foreach (var r in results.Where(x => x.Class == cls).OrderBy(x => x.Level))
            {
                sb.Append($"  {r.Class} Lv {r.Level}:");
                foreach (var b in r.Breakdown.OrderByDescending(b => b.Total))
                {
                    long kindTotal = b.Kind == CombatActionKind.Heal ? r.TotalHealing : r.TotalDamage;
                    if (kindTotal == 0) continue;
                    double share = (double)b.Total / kindTotal;
                    string tag   = b.Kind == CombatActionKind.Heal ? "heal" : "dmg";
                    sb.Append($"  [{b.Name} {share.ToString("0%", Inv)} {tag}]");
                }
                sb.AppendLine();
            }
        }

        return sb.ToString();
    }

    private List<LevelingResult> LevelingSnapshot()
    {
        lock (_levelingResultsLock) return _levelingResults.ToList();
    }

    private void ToggleLrExpanded(LevelingResult r)
    {
        var key = (r.Class, r.SpecIndex);
        if (!_lrExpanded.Remove(key)) _lrExpanded.Add(key);
    }

    /// <summary>Meilenstein-Level für die Timeline-Tabelle (max. ~12 Spalten).</summary>
    private static IReadOnlyList<int> GetMilestoneLevels(int from, int to)
    {
        int range = to - from;
        int step  = range <= 10 ? 1 : range <= 25 ? 2 : range <= 50 ? 5 : 10;
        var list  = new List<int>();
        for (int l = from + step; l < to; l += step)
            list.Add(l);
        list.Add(to);
        return list;
    }

    /// <summary>Abweichung vom Median der Leveling-Zeiten; negativ = schneller = besser (grün).</summary>
    private static double LevelTimingDeviation(List<LevelingResult> results, int level, double seconds)
    {
        var values = results
            .Select(r => r.LevelTimings.FirstOrDefault(t => t.Level == level)?.SimSecondsToReach)
            .Where(v => v.HasValue)
            .Select(v => v!.Value)
            .OrderBy(v => v)
            .ToList();

        if (values.Count == 0) return double.NaN;
        int mid = values.Count / 2;
        double median = values.Count % 2 == 1 ? values[mid] : (values[mid - 1] + values[mid]) / 2.0;
        if (median == 0) return 0;
        return -(seconds - median) / median;
    }

    private static string FormatGameTime(double seconds)
    {
        if (double.IsNaN(seconds) || double.IsInfinity(seconds)) return "–";
        var t = TimeSpan.FromSeconds(seconds);
        if (t.TotalDays >= 1)
            return $"{(int)t.TotalDays}d {t.Hours:00}h";
        if (t.TotalHours >= 1)
            return $"{(int)t.TotalHours}h {t.Minutes:00}m";
        return $"{t.Minutes}m {t.Seconds:00}s";
    }

    public void Dispose()
    {
        _cts?.Cancel();
    }
}
