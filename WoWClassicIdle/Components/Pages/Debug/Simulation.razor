@page "/debug/simulation"
@rendermode InteractiveServer
@using Models
@using DebugTools
@implements IDisposable
@inject IJSRuntime JS

<PageTitle>Class Simulation (Debug)</PageTitle>

<div class="wow-page wide">
    <h2>Class Simulation <span class="wow-badge">DEBUG</span></h2>
    <p class="wow-hint">
        Runs every selected class headless against the regular enemy spawns –
        same combat logic as the live game, without touching your character.
        Loadout and talents are selected automatically at each level.
    </p>

    <!-- ═══ MODUS ═══ -->
    <div class="wow-tabs mode-tabs">
        <button class="wow-tab @(_mode == "bench" ? "active" : "")" @onclick='() => _mode = "bench"' disabled="@_running">Level Benchmark</button>
        <button class="wow-tab @(_mode == "race" ? "active" : "")" @onclick='() => _mode = "race"' disabled="@_running">Leveling Race</button>
    </div>

    <!-- ═══ SETTINGS ═══ -->
    <div class="wow-card sim-settings">
        <div class="setting">
            <label>Level from</label>
            <input type="number" min="1" max="60" @bind="_levelFrom" disabled="@_running" />
        </div>
        <div class="setting">
            <label>Level to</label>
            <input type="number" min="1" max="60" @bind="_levelTo" disabled="@_running" />
        </div>
        <div class="setting">
            <label>@(_mode == "race" ? "Max game time per class (per spec)" : "Game time per run")</label>
            <select @bind="_minutesPerRun" disabled="@_running">
                <option value="10">10 min</option>
                <option value="30">30 min</option>
                <option value="60">1 h</option>
                <option value="180">3 h</option>
                <option value="600">10 h</option>
                <option value="36000">Until target (cap: 600 h)</option>
            </select>
        </div>
        <div class="setting">
            <label>Outlier threshold</label>
            <select @bind="_outlierPercent">
                <option value="15">±15 %</option>
                <option value="25">±25 %</option>
                <option value="35">±35 %</option>
                <option value="50">±50 %</option>
            </select>
        </div>

        <div class="setting class-picker">
            <label>
                Classes
                <button class="wow-link-btn" @onclick="SelectAllClasses" disabled="@_running">all</button>
                <button class="wow-link-btn" @onclick="() => _selectedClasses.Clear()" disabled="@_running">none</button>
            </label>
            <div class="class-toggles">
                @foreach (var cls in AllClasses)
                {
                    var c = cls;
                    <label class="class-toggle @(_selectedClasses.Contains(c) ? "on" : "")">
                        <input type="checkbox" checked="@_selectedClasses.Contains(c)" disabled="@_running"
                               @onchange="e => ToggleClass(c, (bool)e.Value!)" />
                        <span class="class-@ClassCss(c)">@c</span>
                    </label>
                }
            </div>
        </div>

        <div class="setting actions">
            @if (_running)
            {
                <button class="wow-btn" @onclick="Cancel">Cancel</button>
            }
            else
            {
                <button class="wow-btn primary" @onclick="RunSimulationAsync" disabled="@(!CanStart)">▶ Simulate</button>
            }
        </div>
    </div>

    @if (_error is not null)
    {
        <div class="wow-alert error">@_error</div>
    }

    @if (_running || _results.Count > 0 || _levelingResults.Count > 0)
    {
        int _progressCount = _mode == "race" ? _levelingResults.Count : _results.Count;
        string _progressUnit = _mode == "race" ? "specs" : "runs";
        var _wallTime = _running ? DateTime.UtcNow - _startedAt : _elapsed;
        <div class="wow-progress sim-progress">
            <div class="bar" style="width:@(ProgressPercent.ToString("0.#", Inv))%"></div>
            <span>@_progressCount / @_totalRuns @_progressUnit @(_running ? $"… {_wallTime.TotalSeconds:0.0}s" : $"· {_wallTime.TotalSeconds:0.0}s")</span>
        </div>
        @if (_running && !string.IsNullOrEmpty(_currentRunLabel))
        {
            <div class="current-run-label">▶ @_currentRunLabel</div>
        }
    }

    @if (_results.Count > 0)
    {
        var results = Snapshot();
        var levels  = results.Select(r => r.Level).Distinct().OrderBy(l => l).ToList();
        var classes = results.Select(r => r.Class).Distinct().ToList();
        var metric  = Metrics[_metricKey];

        @if (results.Any(r => r.SpawnErrors > 0))
        {
            <div class="wow-alert warning">
                ⚠ The enemy spawner failed @results.Sum(r => r.SpawnErrors).ToString("N0", Inv) times
                (no enemy template for the rolled level) – affected levels:
                @string.Join(", ", results.Where(r => r.SpawnErrors > 0).Select(r => r.Level).Distinct().OrderBy(l => l))
            </div>
        }

        <!-- ═══ MATRIX ═══ -->
        <div class="wow-card">
            <div class="wow-card-header">
                <h4>Overview</h4>
                <div class="wow-tabs">
                    @foreach (var (key, m) in Metrics)
                    {
                        var k = key;
                        <button class="wow-tab @(k == _metricKey ? "active" : "")" @onclick="() => _metricKey = k">@m.Label</button>
                    }
                </div>
            </div>
            <p class="wow-hint">
                Coloring = deviation from the median of all classes on the same level
                (green = better, red = worse). Cells beyond @_outlierPercent % are marked ◆.
            </p>

            <div class="table-wrap">
                <table class="sim-table matrix">
                    <thead>
                        <tr>
                            <th>Class</th>
                            @foreach (var lv in levels)
                            {
                                <th>Lv @lv</th>
                            }
                            <th>Ø Dev.</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var cls in classes)
                        {
                            var devs = new List<double>();
                            <tr>
                                <td class="class-@ClassCss(cls) cls-name">@cls</td>
                                @foreach (var lv in levels)
                                {
                                    var r = results.FirstOrDefault(x => x.Class == cls && x.Level == lv);
                                    if (r is null)
                                    {
                                        <td class="na">–</td>
                                        continue;
                                    }
                                    double v   = metric.Value(r);
                                    double dev = Deviation(metric, v, MedianFor(results, metric, lv));
                                    if (!double.IsNaN(dev)) devs.Add(dev);
                                    bool outlier = !double.IsNaN(dev) && Math.Abs(dev) >= OutlierThreshold;
                                    <td style="@CellStyle(dev)" title="@(double.IsNaN(dev) ? "" : $"{dev:+0%;-0%;0%} vs. level median")">
                                        @metric.Format(v)@(outlier ? " ◆" : "")
                                    </td>
                                }
                                @{ double avgDev = devs.Count > 0 ? devs.Average() : double.NaN; }
                                <td style="@CellStyle(avgDev)" class="avg-dev">@(double.IsNaN(avgDev) ? "–" : avgDev.ToString("+0%;-0%;0%", Inv))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td>Median</td>
                            @foreach (var lv in levels)
                            {
                                <td>@metric.Format(MedianFor(results, metric, lv))</td>
                            }
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <!-- ═══ OUTLIERS ═══ -->
        var outliers = FindOutliers(results).ToList();
        <div class="wow-card">
            <h4>Outliers (DPS · Kills/min · Deaths/h, ≥ @_outlierPercent %)</h4>
            <p class="wow-hint">+ = better than the level median, − = worse (for Deaths/h: + means fewer deaths).</p>
            @if (outliers.Count == 0)
            {
                <p class="wow-hint">Nobody steps out of line. 🎉</p>
            }
            else
            {
                <ul class="outlier-list">
                    @foreach (var o in outliers)
                    {
                        <li>
                            <span class="dev @(o.Better ? "good" : "bad")">@o.Deviation.ToString("+0%;-0%", Inv)</span>
                            <span class="class-@ClassCss(o.Class)">@o.Class</span>
                            <span class="wow-muted">@o.Metric · Lv @o.Levels</span>
                        </li>
                    }
                </ul>
            }
        </div>

        <!-- ═══ AI EXPORT ═══ -->
        <div class="wow-card">
            <div class="wow-card-header">
                <h4>AI Export</h4>
                <button class="wow-btn @(_copied ? "primary" : "")" @onclick="CopyAiSummaryAsync">
                    @(_copied ? "✓ Copied" : "Copy for AI")
                </button>
            </div>
            <p class="wow-hint">
                Structured summary of all metrics, outliers, and ability breakdowns —
                paste directly into an AI chat to get concrete balance suggestions.
            </p>
            <textarea class="ai-export-text" readonly>@_aiSummary</textarea>
        </div>

        <!-- ═══ DETAILS ═══ -->
        <div class="wow-card">
            <div class="wow-card-header">
                <h4>All runs</h4>
                <select @bind="_detailLevelFilter">
                    <option value="0">All levels</option>
                    @foreach (var lv in levels)
                    {
                        <option value="@lv">Level @lv</option>
                    }
                </select>
            </div>
            <p class="wow-hint">Click a column to sort, click a row for the ability breakdown.</p>

            <div class="table-wrap">
                <table class="sim-table details">
                    <thead>
                        <tr>
                            @foreach (var col in DetailColumns)
                            {
                                var c = col;
                                <th class="sortable" @onclick="() => SortBy(c.Key)">
                                    @c.Label@(c.Key == _sortKey ? (_sortDesc ? " ▼" : " ▲") : "")
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in SortedDetails(results))
                        {
                            var row = r;
                            bool open = _expanded.Contains((row.Class, row.Level));
                            <tr class="detail-row @(open ? "open" : "")" @onclick="() => ToggleExpanded(row)">
                                @foreach (var col in DetailColumns)
                                {
                                    if (col.Key == "class")
                                    {
                                        <td class="class-@ClassCss(row.Class) cls-name">@row.Class</td>
                                    }
                                    else
                                    {
                                        <td class="@(col.Key == "spawnerr" && row.SpawnErrors > 0 ? "warn" : "")">@col.Format(row)</td>
                                    }
                                }
                            </tr>
                            @if (open)
                            {
                                <tr class="breakdown-row">
                                    <td colspan="@DetailColumns.Length">
                                        <div class="breakdown">
                                            <div class="breakdown-stats">
                                                <span>HP <b>@row.Stats.MaxHp</b></span>
                                                <span>Resource <b>@row.Stats.MaxMana</b></span>
                                                <span>Mana/5 <b>@row.Stats.ManaRegenPer5</b></span>
                                                <span>AP <b>@row.Stats.AttackPower</b></span>
                                                <span>Weapon <b>@row.Stats.WeaponMinDamage–@row.Stats.WeaponMaxDamage @@ @row.Stats.Speed.ToString("0.0#", Inv)s</b></span>
                                                <span>Str/Agi/Sta/Int/Spi <b>@row.Stats.Primary.Strength/@row.Stats.Primary.Agility/@row.Stats.Primary.Stamina/@row.Stats.Primary.Intelligence/@row.Stats.Primary.Spirit</b></span>
                                                <span>Combat time <b>@FormatMinutes(row.CombatSeconds / 60)</b></span>
                                            </div>
                                            <table class="sim-table inner">
                                                <thead>
                                                    <tr><th>Source</th><th>Type</th><th>Total</th><th>Share</th><th>Hits</th><th>Avg</th><th>Max</th><th>Per sec</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var b in row.Breakdown)
                                                    {
                                                        long kindTotal = b.Kind == CombatActionKind.Heal ? row.TotalHealing : row.TotalDamage;
                                                        double share = kindTotal > 0 ? (double)b.Total / kindTotal : 0;
                                                        <tr>
                                                            <td class="src">
                                                                <AbilityTooltip Ability="ClassAbilityRegistry.FindByName(row.Class, b.Name)" PlayerLevel="row.Level">
                                                                    <span class="src-inner">
                                                                        @if (!string.IsNullOrEmpty(b.IconUrl))
                                                                        {
                                                                            <img src="@b.IconUrl" alt="" onerror="this.style.display='none'" />
                                                                        }
                                                                        @b.Name
                                                                    </span>
                                                                </AbilityTooltip>
                                                            </td>
                                                            <td class="@(b.Kind == CombatActionKind.Heal ? "heal" : "dmg")">@b.Kind</td>
                                                            <td>@b.Total.ToString("N0", Inv)</td>
                                                            <td>
                                                                <div class="share-bar @(b.Kind == CombatActionKind.Heal ? "heal" : "dmg")">
                                                                    <div style="width:@((share * 100).ToString("0.#", Inv))%"></div>
                                                                    <span>@share.ToString("0.0%", Inv)</span>
                                                                </div>
                                                            </td>
                                                            <td>@b.Count.ToString("N0", Inv)</td>
                                                            <td>@(b.Count > 0 ? ((double)b.Total / b.Count).ToString("0.0", Inv) : "–")</td>
                                                            <td>@b.Max</td>
                                                            <td>@(row.CombatSeconds > 0 ? (b.Total / row.CombatSeconds).ToString("0.00", Inv) : "–")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═══ GEAR SUMMARY (BENCH) ═══ -->
        var gearRows = results
            .GroupBy(r => r.Class)
            .Select(g => g.OrderByDescending(r => r.Level).First())
            .OrderBy(r => r.Class.ToString())
            .ToList();
        var allSlots = Enum.GetValues<ArmorSlot>();
        <div class="wow-card">
            <h4>Gear Summary <span class="wow-muted">(highest simulated level per class)</span></h4>
            <p class="wow-hint">Items auto-equipped during the run via the upgrade system. — = nothing dropped.</p>
            <div class="table-wrap">
                <table class="sim-table gear-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Lv</th>
                            <th>Weapon</th>
                            @foreach (var slot in allSlots)
                            {
                                <th>@ArmorSlots.Label(slot)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in gearRows)
                        {
                            <tr>
                                <td class="class-@ClassCss(r.Class) cls-name">@r.Class</td>
                                <td>@r.Level</td>
                                <td class="gear-cell">
                                    @if (r.EquippedWeapon is not null)
                                    {
                                        <WeaponTooltip Weapon="r.EquippedWeapon">
                                            <span class="gear-name quality-@r.EquippedWeapon.Quality.ToString().ToLowerInvariant()">
                                                @if (!string.IsNullOrEmpty(r.EquippedWeapon.Icon))
                                                {
                                                    <img src="@r.EquippedWeapon.Icon" alt="" class="gear-icon" onerror="this.style.display='none'" />
                                                }
                                                @r.EquippedWeapon.Name
                                            </span>
                                        </WeaponTooltip>
                                    }
                                    else { <span class="wow-muted">—</span> }
                                </td>
                                @foreach (var slot in allSlots)
                                {
                                    <td class="gear-cell">
                                        @if (r.EquippedArmor.TryGetValue(slot, out var armor))
                                        {
                                            <ArmorTooltip Armor="armor">
                                                <span class="gear-name quality-@armor.Quality.ToString().ToLowerInvariant()">
                                                    @if (!string.IsNullOrEmpty(armor.Icon))
                                                    {
                                                        <img src="@armor.Icon" alt="" class="gear-icon" onerror="this.style.display='none'" />
                                                    }
                                                    @armor.Name
                                                </span>
                                            </ArmorTooltip>
                                        }
                                        else { <span class="wow-muted">—</span> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

    <!-- ═══ LEVELING RACE ERGEBNISSE ═══ -->
    @if (_levelingResults.Count > 0)
    {
        var lrList    = LevelingSnapshot();
        var rankOrder = lrList.OrderBy(r => r.ReachedTarget ? r.SimSecondsToTarget : double.MaxValue).ToList();

        @if (lrList.Any(r => r.SpawnErrors > 0))
        {
            <div class="wow-alert warning">
                ⚠ Spawn errors: @lrList.Sum(r => r.SpawnErrors).ToString("N0", Inv) – some levels may be underrepresented.
            </div>
        }

        <!-- Standings -->
        <div class="wow-card">
            <h4>Race Standings: Level @(lrList[0].LevelFrom) → @(lrList[0].LevelTo)</h4>
            <p class="wow-hint">Sorted by simulated game time to reach the target level. Each class runs once per spec. DNF = did not finish within the cap.</p>
            <div class="table-wrap">
                <table class="sim-table race-standings">
                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Class</th>
                            <th>Spec</th>
                            <th>Result</th>
                            <th>Time (simulated)</th>
                            <th>Kills</th>
                            <th>Deaths</th>
                            <th>Money/h</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int ri = 0; ri < rankOrder.Count; ri++)
                        {
                            var r = rankOrder[ri];
                            int rank = ri + 1;
                            string medal = rank == 1 ? "🥇" : rank == 2 ? "🥈" : rank == 3 ? "🥉" : $"#{rank}";
                            <tr>
                                <td class="race-rank">@medal</td>
                                <td class="class-@ClassCss(r.Class) cls-name">@r.Class</td>
                                <td class="spec-name">@r.SpecName</td>
                                <td class="@(r.ReachedTarget ? "race-reached" : "race-dnf")">
                                    @(r.ReachedTarget ? $"✓ Level {r.LevelTo}" : $"DNF (reached Lv {r.FinalLevel})")
                                </td>
                                <td>@(r.ReachedTarget ? FormatGameTime(r.SimSecondsToTarget) : "–")</td>
                                <td>@r.TotalKills.ToString("N0", Inv)</td>
                                <td>@r.TotalDeaths.ToString("N0", Inv)</td>
                                <td>@Money.Format((long)r.CopperPerHour)</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Level Timeline -->
        @if (GetMilestoneLevels(lrList[0].LevelFrom, lrList[0].LevelTo) is { Count: > 0 } milestones)
        {
            <div class="wow-card">
                <h4>Level Timeline</h4>
                <p class="wow-hint">Simulated game time to reach each level. Green = faster than median, red = slower.</p>
                <div class="table-wrap">
                    <table class="sim-table timeline-table">
                        <thead>
                            <tr>
                                <th>Class</th>
                                <th>Spec</th>
                                @foreach (var lv in milestones)
                                {
                                    <th>Lv @lv</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in rankOrder)
                            {
                                <tr>
                                    <td class="class-@ClassCss(r.Class) cls-name">@r.Class</td>
                                    <td class="spec-name">@r.SpecName</td>
                                    @foreach (var lv in milestones)
                                    {
                                        var timing = r.LevelTimings.FirstOrDefault(t => t.Level == lv);
                                        if (timing is null)
                                        {
                                            <td class="na">–</td>
                                        }
                                        else
                                        {
                                            double dev = LevelTimingDeviation(lrList, lv, timing.SimSecondsToReach);
                                            <td style="@CellStyle(dev)" title="@FormatGameTime(timing.SimSecondsToReach)">@FormatGameTime(timing.SimSecondsToReach)</td>
                                        }
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }

        <!-- Ability-Breakdown -->
        <div class="wow-card">
            <div class="wow-card-header">
                <h4>Ability Breakdown (full run)</h4>
            </div>
            <p class="wow-hint">Click a row to expand the ability breakdown for the entire leveling run.</p>
            <div class="table-wrap">
                <table class="sim-table details">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Spec</th>
                            <th>Final Lv</th>
                            <th>DPS (overall)</th>
                            <th>Kills</th>
                            <th>Deaths</th>
                            <th>K/D</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rankOrder)
                        {
                            bool open = _lrExpanded.Contains((r.Class, r.SpecIndex));
                            <tr class="detail-row @(open ? "open" : "")" @onclick="() => ToggleLrExpanded(r)">
                                <td class="class-@ClassCss(r.Class) cls-name">@r.Class</td>
                                <td class="spec-name">@r.SpecName</td>
                                <td>@r.FinalLevel</td>
                                <td>@F(r.Dps, "0.00")</td>
                                <td>@r.TotalKills.ToString("N0", Inv)</td>
                                <td>@r.TotalDeaths.ToString("N0", Inv)</td>
                                <td>@(r.TotalDeaths > 0 ? ((double)r.TotalKills / r.TotalDeaths).ToString("0.0", Inv) : "∞")</td>
                            </tr>
                            @if (open)
                            {
                                <tr class="breakdown-row">
                                    <td colspan="7">
                                        <div class="breakdown">
                                            <table class="sim-table inner">
                                                <thead>
                                                    <tr><th>Source</th><th>Type</th><th>Total</th><th>Share</th><th>Hits</th><th>Avg</th><th>Max</th></tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var b in r.FinalBreakdown.OrderByDescending(b => b.Total))
                                                    {
                                                        long kindTotal = b.Kind == CombatActionKind.Heal ? r.TotalHealing : r.TotalDamage;
                                                        double share = kindTotal > 0 ? (double)b.Total / kindTotal : 0;
                                                        <tr>
                                                            <td class="src">
                                                                <AbilityTooltip Ability="ClassAbilityRegistry.FindByName(r.Class, b.Name)" PlayerLevel="r.FinalLevel">
                                                                    <span class="src-inner">
                                                                        @if (!string.IsNullOrEmpty(b.IconUrl))
                                                                        {
                                                                            <img src="@b.IconUrl" alt="" onerror="this.style.display='none'" />
                                                                        }
                                                                        @b.Name
                                                                    </span>
                                                                </AbilityTooltip>
                                                            </td>
                                                            <td class="@(b.Kind == CombatActionKind.Heal ? "heal" : "dmg")">@b.Kind</td>
                                                            <td>@b.Total.ToString("N0", Inv)</td>
                                                            <td>
                                                                <div class="share-bar @(b.Kind == CombatActionKind.Heal ? "heal" : "dmg")">
                                                                    <div style="width:@((share * 100).ToString("0.#", Inv))%"></div>
                                                                    <span>@share.ToString("0.0%", Inv)</span>
                                                                </div>
                                                            </td>
                                                            <td>@b.Count.ToString("N0", Inv)</td>
                                                            <td>@(b.Count > 0 ? ((double)b.Total / b.Count).ToString("0.0", Inv) : "–")</td>
                                                            <td>@b.Max</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═══ GEAR SUMMARY (RACE) ═══ -->
        var raceSlots = Enum.GetValues<ArmorSlot>();
        <div class="wow-card">
            <h4>Gear Summary <span class="wow-muted">(end of leveling run)</span></h4>
            <p class="wow-hint">Items auto-equipped during the leveling run via the upgrade system. — = nothing dropped.</p>
            <div class="table-wrap">
                <table class="sim-table gear-table">
                    <thead>
                        <tr>
                            <th>Class</th>
                            <th>Final Lv</th>
                            <th>Weapon</th>
                            @foreach (var slot in raceSlots)
                            {
                                <th>@ArmorSlots.Label(slot)</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in rankOrder)
                        {
                            <tr>
                                <td class="class-@ClassCss(r.Class) cls-name">@r.Class</td>
                                <td>@r.FinalLevel</td>
                                <td class="gear-cell">
                                    @if (r.FinalWeapon is not null)
                                    {
                                        <WeaponTooltip Weapon="r.FinalWeapon">
                                            <span class="gear-name quality-@r.FinalWeapon.Quality.ToString().ToLowerInvariant()">
                                                @if (!string.IsNullOrEmpty(r.FinalWeapon.Icon))
                                                {
                                                    <img src="@r.FinalWeapon.Icon" alt="" class="gear-icon" onerror="this.style.display='none'" />
                                                }
                                                @r.FinalWeapon.Name
                                            </span>
                                        </WeaponTooltip>
                                    }
                                    else { <span class="wow-muted">—</span> }
                                </td>
                                @foreach (var slot in raceSlots)
                                {
                                    <td class="gear-cell">
                                        @if (r.FinalArmor.TryGetValue(slot, out var armor))
                                        {
                                            <ArmorTooltip Armor="armor">
                                                <span class="gear-name quality-@armor.Quality.ToString().ToLowerInvariant()">
                                                    @if (!string.IsNullOrEmpty(armor.Icon))
                                                    {
                                                        <img src="@armor.Icon" alt="" class="gear-icon" onerror="this.style.display='none'" />
                                                    }
                                                    @armor.Name
                                                </span>
                                            </ArmorTooltip>
                                        }
                                        else { <span class="wow-muted">—</span> }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }

}
</div>

