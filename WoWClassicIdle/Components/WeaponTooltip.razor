@using Models

@* Wraps content and shows a WoW-style weapon tooltip on hover.
   With Compare, the equipped weapon and a panel with the stat differences are shown next to it.
   Positioning via js/tooltip.js (position: fixed). *@
@if (Weapon is null)
{
    @ChildContent
}
else
{
    <span class="tt-host @Class" onmouseenter="wowTooltip.show(this)" onmouseleave="wowTooltip.hide(this)">
        @ChildContent
        @if (Compare is null)
        {
            <span class="wow-tooltip" role="tooltip">
                @Body(Weapon, RequirementsMet, Hint)
            </span>
        }
        else
        {
            var deltas = ItemComparison.Compare(Weapon, Compare);
            <span class="wow-tooltip tt-group" role="tooltip">
                <span class="tt-panel">
                    @Body(Weapon, RequirementsMet, Hint)
                </span>
                <span class="tt-panel">
                    <span class="tt-equipped-label">Currently Equipped</span>
                    @Body(Compare, true, null)
                </span>
                <span class="tt-panel">
                    @if (deltas.Count == 0)
                    {
                        <span class="tt-delta">No changes</span>
                    }
                    @foreach (var delta in deltas)
                    {
                        <span class="tt-delta @(delta.IsGain ? "tt-delta-gain" : "tt-delta-loss")">@delta.Text</span>
                    }
                </span>
            </span>
        }
    </span>
}

@code {
    [Parameter] public WeaponItem? Weapon { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Hint { get; set; }

    /// <summary>Whether the character meets the level requirement (row turns red if not).</summary>
    [Parameter] public bool RequirementsMet { get; set; } = true;

    /// <summary>Currently equipped weapon – shown next to it for comparison.</summary>
    [Parameter] public WeaponItem? Compare { get; set; }

    // Tooltip content of a weapon (for main and comparison panel)
    private static RenderFragment Body(WeaponItem weapon, bool requirementsMet, string? hint) => @<text>
        <span class="tt-name" style="color: @ItemQualityColors.Hex(weapon.Quality)">@weapon.Name</span>
        <span class="tt-subtype">@weapon.Type</span>
        <span class="tt-line">
            <span>@weapon.MinDamage – @weapon.MaxDamage Damage</span>
            <span>Speed @weapon.Speed.ToString("0.00")</span>
        </span>
        <span class="tt-dps">(@ItemComparison.Dps(weapon).ToString("0.00") damage per second)</span>
        <span class="tt-quality">@weapon.Quality</span>
        @if (weapon.RequiredLevel > 1)
        {
            <span class="tt-req-level @(requirementsMet ? "" : "tt-req-blocked")">Requires level @weapon.RequiredLevel</span>
        }
        @if (weapon.Bonuses is { } bonuses)
        {
            @foreach (var line in bonuses.DescribeBonuses())
            {
                <span class="tt-stat">@line</span>
            }
        }
        @if (weapon.RequiredClass is { } cls)
        {
            <span class="tt-req-class">Classes: @cls</span>
        }
        @if (!string.IsNullOrEmpty(hint))
        {
            <span class="tt-hint">@hint</span>
        }
    </text>;
}
