@using Models
@inject IdleGameEngine Engine
@inject Services.ISaveGameService SaveGame
@inject Services.UpdateService UpdateSvc
@inject NavigationManager Nav
@implements IDisposable

<div class="nav-wrapper">
    <div class="top-row navbar navbar-dark">
        <a class="navbar-brand" href="">
            <img src="images/wow_idle_game_logo.png" alt="WoW Classic Idle" class="wow-logo" />
            <span class="alpha-badge">ALPHA</span>
        </a>
    </div>

        <input type="checkbox" title="Navigation menu" class="navbar-toggler"/>

        <div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
            <nav class="nav flex-column">
                <div class="nav-section-label">Adventure</div>
                <div class="nav-item">
                    <NavLink class="nav-link" href="character">
                        <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_head_human_01.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Character
                    </NavLink>
                </div>

                @if (Engine.CharacterRoster.Count > 0)
                {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="idle">
                            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_sword_04.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Idle Fighter
                        </NavLink>
                    </div>

                    <div class="nav-item">
                        <NavLink class="nav-link" href="ability-loadout">
                            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_book_09.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Ability Loadout
                        </NavLink>
                    </div>

                    @if (_playerLevelAtLeastTen)
                    {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="talents">
                            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/ability_rogue_slicedice.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Talents
                        </NavLink>
                    </div>
                    }

                    <div class="nav-section-label">Collection</div>
                    <div class="nav-item">
                        <NavLink class="nav-link" href="inventory">
                            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_bag_08.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Inventory
                        </NavLink>
                    </div>

                    @if (_professionsUnlocked)
                    {
                    <div class="nav-item">
                        <NavLink class="nav-link" href="professions">
                            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/trade_blacksmithing.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Professions
                        </NavLink>
                    </div>
                    }

                    <div class="nav-item">
                        <NavLink class="nav-link" href="achievements">
                            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/achievement_general.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Achievements
                        </NavLink>
                    </div>
                }

            </nav>
        </div>

    <TravelIndicator />

    @if (BuildInfo.IsDebug)
    {
        <div class="nav-debug-area">
            <span class="nav-debug-label">DEBUG</span>
            <div class="nav-item">
                <NavLink class="nav-link" href="debug/simulation">
                    <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_gear_01.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Simulation
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="debug/abilities">
                    <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_book_09.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Abilities
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="debug/talents">
                    <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/ability_marksmanship.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Talents
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="debug/loot-tables">
                    <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_chest_cloth_05.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Loot Tables
                </NavLink>
            </div>
            <div class="nav-item">
                <NavLink class="nav-link" href="debug/enemy-spawns">
                    <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/ability_hunter_pet_wolf.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Enemy Spawns
                </NavLink>
            </div>
        </div>
    }

    <div class="nav-item">
        <NavLink class="nav-link" href="changelog">
            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_scroll_03.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" /> Changelog
        </NavLink>
    </div>

    <div class="nav-version">v@(Services.UpdateService.AppVersion)</div>

    <div class="nav-footer">
        <button class="nav-footer-btn @(_saveMessage is not null ? "saved" : "")" @onclick="OnSave">
            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_note_06.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" />
            <span>@(_saveMessage ?? "Save")</span>
        </button>
        <button class="nav-footer-btn danger @(_confirmDelete ? "confirm" : "")" @onclick="OnDeleteSave"
                title="@(_confirmDelete ? "Click again to delete your save" : "Delete save")">
            <img class="nav-icon" src="https://wow.zamimg.com/images/wow/icons/medium/inv_misc_bone_humanskull_01.jpg" alt="" aria-hidden="true" onerror="this.style.visibility='hidden'" />
            <span>@(_confirmDelete ? "Confirm?" : "Delete")</span>
        </button>
    </div>
</div>

@code {
    private string? _saveMessage;
    private System.Threading.CancellationTokenSource? _saveMsgCts;
    private bool _confirmDelete;
    private System.Threading.CancellationTokenSource? _deleteConfirmCts;
    private bool _playerLevelAtLeastTen;
    private bool _professionsUnlocked;

    protected override void OnInitialized()
    {
        Engine.RosterChanged += OnRosterChanged;
        Engine.TickUpdated += OnTickUpdated;
        _playerLevelAtLeastTen = Engine.HasActiveCharacter && Engine.Player.Level >= 10;
        _professionsUnlocked   = Engine.ProfessionsUnlockedOnAccount;
    }

    private async Task OnSave()
    {
        SaveGame.Save();
        _saveMsgCts?.Cancel();
        _saveMsgCts = new System.Threading.CancellationTokenSource();
        _saveMessage = "Saved!";
        StateHasChanged();
        try
        {
            await Task.Delay(2000, _saveMsgCts.Token);
        }
        catch (TaskCanceledException) { }
        _saveMessage = null;
        StateHasChanged();
    }

    // Two-step delete: first click asks, second click within 3 s deletes
    private async Task OnDeleteSave()
    {
        _deleteConfirmCts?.Cancel();
        if (_confirmDelete)
        {
            _confirmDelete = false;
            SaveGame.DeleteSave();
            Nav.NavigateTo("/character");
            return;
        }

        _confirmDelete = true;
        _deleteConfirmCts = new System.Threading.CancellationTokenSource();
        StateHasChanged();
        try
        {
            await Task.Delay(3000, _deleteConfirmCts.Token);
        }
        catch (TaskCanceledException) { return; }
        _confirmDelete = false;
        StateHasChanged();
    }

    private void OnRosterChanged()
    {
        _playerLevelAtLeastTen = Engine.HasActiveCharacter && Engine.Player.Level >= 10;
        _professionsUnlocked   = Engine.ProfessionsUnlockedOnAccount;
        InvokeAsync(StateHasChanged);
    }

    private void OnTickUpdated()
    {
        bool levelOk = Engine.HasActiveCharacter && Engine.Player.Level >= 10;
        bool professionsOk = Engine.ProfessionsUnlockedOnAccount;
        if (levelOk != _playerLevelAtLeastTen || professionsOk != _professionsUnlocked)
        {
            _playerLevelAtLeastTen = levelOk;
            _professionsUnlocked   = professionsOk;
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        Engine.RosterChanged -= OnRosterChanged;
        Engine.TickUpdated -= OnTickUpdated;
        _saveMsgCts?.Cancel();
        _deleteConfirmCts?.Cancel();
    }
}
        