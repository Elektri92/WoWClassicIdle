@using Models

@* Wraps arbitrary content and shows a WoW-style ability tooltip on hover.
   Positioned via js/tooltip.js (position: fixed) so overflow containers don't clip it. *@
@if (Ability is null)
{
    @ChildContent
}
else
{
    var cost = AbilityText.CostText(Ability);
    var note = AbilityText.AutoCastNote(Ability);
    bool levelTooLow = PlayerLevel is { } lvl && lvl < Ability.LevelRequired;

    <span class="tt-host @Class" onmouseenter="wowTooltip.show(this)" onmouseleave="wowTooltip.hide(this)">
        @ChildContent
        <span class="wow-tooltip" role="tooltip">
            <span class="tt-line">
                <span class="tt-name">@Ability.Name</span>
                @if (Ability.Rank > 0)
                {
                    <span class="tt-rank">Rank @Ability.Rank</span>
                }
            </span>
            <span class="tt-line">
                <span>@cost</span>
                <span>@AbilityText.TimingText(Ability)</span>
            </span>
            <span class="tt-line @(levelTooLow ? "tt-req-missing" : "")">Requires Level @Ability.LevelRequired</span>
            <span class="tt-desc">@AbilityText.Description(Ability)</span>
            @if (note != "")
            {
                <span class="tt-note">@note</span>
            }
            @if (BuffRemaining is { } remaining)
            {
                <span class="tt-remaining">@Math.Ceiling(remaining).ToString("0") sec remaining</span>
            }
        </span>
    </span>
}

@code {
    [Parameter] public Ability? Ability { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    /// <summary>Player level – if it is too low, "Requires Level" is shown in red.</summary>
    [Parameter] public int? PlayerLevel { get; set; }

    /// <summary>Remaining duration, if the tooltip belongs to an active buff.</summary>
    [Parameter] public double? BuffRemaining { get; set; }

    /// <summary>Extra CSS class for the wrapper (e.g. "tt-block" for rows).</summary>
    [Parameter] public string? Class { get; set; }
}
