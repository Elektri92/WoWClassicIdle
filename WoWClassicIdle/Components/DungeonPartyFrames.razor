@using Models

@* NPC party under the own character: role, spell with cooldown and a highlight on every cast (css/dungeons.css) *@
<div class="dungeon-party">
    @if (SelfRole is { } self)
    {
        <WowTooltip Class="dp-you-host" Title="Your role" Body="SelfTooltip(self)">
            <span class="dp-you">You: <span class="dp-role role-@self.ToString().ToLowerInvariant()">@DungeonPartyRegistry.RoleLabel(self)</span></span>
        </WowTooltip>
    }
    @foreach (var state in Party)
    {
        var member = state.Member;
        <WowTooltip Title="@member.Name" Body="MemberTooltip(member, state.MaxHpAt(Level))">
            <div class="dp-member @(state.MitigationRemaining > 0 ? "shielding" : "")" data-npc="@member.Name">
                <span class="dp-portrait">
                    <img src="@IconUrls.RaceIconUrl(member.Race, member.Gender)" alt="" onerror="this.style.visibility='hidden'" />
                    <img class="dp-class" src="@IconUrls.ClassIconUrl(member.Class)" alt="" onerror="this.style.visibility='hidden'" />
                </span>
                <span class="dp-member-text">
                    <span class="dp-member-name">@member.Name</span>
                    <span class="dp-role role-@member.Role.ToString().ToLowerInvariant()"><img class="role-icon" src="@DungeonPartyRegistry.RoleIconUrl(member.Role)" alt="" /> @DungeonPartyRegistry.RoleLabel(member.Role)</span>
                </span>
                <span class="dp-spell @(state.CastFlash > 0 ? "casting" : "")">
                    <img src="@member.Spell.IconUrl" alt="@member.Spell.Name" onerror="this.style.visibility='hidden'" />
                    <span class="dp-spell-cd" style="background: conic-gradient(rgba(0,0,0,.65) @CooldownPct(state)%, transparent 0)"></span>
                </span>
            </div>
        </WowTooltip>
    }
</div>

@code {
    [Parameter, EditorRequired] public IReadOnlyList<DungeonPartyMemberState> Party { get; set; } = null!;
    [Parameter] public DungeonRole? SelfRole { get; set; }
    [Parameter] public int Level { get; set; }

    private static RenderFragment SelfTooltip(DungeonRole role) => @<text>
        <span class="zt-good">@DungeonPartyRegistry.SelfRoleEffect(role)</span>
    </text>;

    private static string CooldownPct(DungeonPartyMemberState state) =>
        (Math.Clamp(state.Cooldown / state.Member.Spell.Interval, 0, 1) * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture);

    private static RenderFragment MemberTooltip(DungeonPartyMember member, int health) => @<text>
        <span class="zt-sub">@member.Race @member.Class · @DungeonPartyRegistry.RoleLabel(member.Role)</span>
        <span class="zt-section">@member.Spell.Name</span>
        <span class="zt-good">@member.Spell.Description</span>
        <span class="zt-sub">Adds @health health to the group</span>
    </text>;
}
