<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <!-- App version – fallback for Debug builds. Publish sets the version via CI (-p:Version=X.Y.Z). -->
        <Version>0.0.1</Version>
    </PropertyGroup>

    <!-- Ship debug tools (class simulation) only in the Debug build -->
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <Compile Remove="Components\Debug\**" />
      <Content Remove="Components\Pages\Debug\**" />
      <RazorComponent Remove="Components\Pages\Debug\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Components\Services\" />
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>

    <!-- Otherwise appsettings end up loose next to the binary. But the ContentRoot is the bundle's extraction directory –
         without bundling, appsettings.Production.json (Urls/Logging) is missing there and Kestrel falls back to port 5000. -->
    <ItemGroup>
      <Content Update="appsettings*.json" ExcludeFromSingleFile="false" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- The SDK copies static web assets loose next to the binary, bypassing the single-file bundle. The auto-update
         only replaces the binary – without bundling existing installations would never get new CSS/images.
         Therefore compute them before bundling, include them in the bundle and prevent the loose copying. -->
    <Target Name="BundleWwwrootIntoSingleFile"
            BeforeTargets="_ComputeFilesToBundle"
            DependsOnTargets="$(CopyStaticWebAssetsToPublishDirectoryDependsOn);_SplitPublishStaticWebAssetsByCopyOptions"
            Condition="'$(PublishSingleFile)' == 'true'">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(_PublishStaticWebAssetsTargetPath)"
                               RelativePath="%(_PublishStaticWebAssetsTargetPath.TargetPath)"
                               CopyToPublishDirectory="PreserveNewest"
                               ExcludeFromSingleFile="false" />
        <_PublishStaticWebAssetsCopyAlways Remove="@(_PublishStaticWebAssetsCopyAlways)" />
        <_PublishStaticWebAssetsPreserveNewest Remove="@(_PublishStaticWebAssetsPreserveNewest)" />
      </ItemGroup>
    </Target>


</Project>
