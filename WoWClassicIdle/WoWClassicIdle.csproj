<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <!-- App-Version – wird vom UpdateService mit der Remote-Version verglichen -->
        <Version>1.0.0</Version>
        <AssemblyVersion>1.0.0.0</AssemblyVersion>
    </PropertyGroup>

    <!-- Debug-Tools (Klassen-Simulation) nur im Debug-Build ausliefern -->
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <Compile Remove="Components\Debug\**" />
      <Content Remove="Components\Pages\Debug\**" />
      <RazorComponent Remove="Components\Pages\Debug\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Components\Services\" />
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>

    <!-- Nach Linux-Publish: Binary umbenennen und Launcher-Skript (Properties/linux-launcher.sh) kopieren -->
    <Target Name="CreateLinuxWrapper" AfterTargets="Publish" Condition="$(RuntimeIdentifier.StartsWith('linux-'))">
      <Move SourceFiles="$(PublishDir)WoWClassicIdle" DestinationFiles="$(PublishDir)WoWClassicIdle.bin" />
      <Copy SourceFiles="$(MSBuildProjectDirectory)/Properties/linux-launcher.sh" DestinationFiles="$(PublishDir)WoWClassicIdle" />
      <Exec Command="chmod +x &quot;$(PublishDir)WoWClassicIdle&quot;" />
    </Target>

</Project>
