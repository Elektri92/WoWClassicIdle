<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <!-- App-Version – Fallback für Debug-Builds. Publish setzt Version via CI (-p:Version=X.Y.Z). -->
        <Version>0.0.1</Version>
    </PropertyGroup>

    <!-- Debug-Tools (Klassen-Simulation) nur im Debug-Build ausliefern -->
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <Compile Remove="Components\Debug\**" />
      <Content Remove="Components\Pages\Debug\**" />
      <RazorComponent Remove="Components\Pages\Debug\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Components\Services\" />
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>

    <!-- appsettings landen sonst lose neben der Binary. ContentRoot ist aber das Entpackverzeichnis des Bundles –
         ohne Bündelung fehlt dort appsettings.Production.json (Urls/Logging) und Kestrel fällt auf Port 5000 zurück. -->
    <ItemGroup>
      <Content Update="appsettings*.json" ExcludeFromSingleFile="false" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>

    <!-- Static Web Assets kopiert das SDK lose neben die Binary, am Single-File-Bundle vorbei. Das Auto-Update
         ersetzt nur die Binary – ohne Bündelung bekämen bestehende Installationen nie neue CSS/Bilder.
         Daher vor dem Bundling berechnen, ins Bundle aufnehmen und das lose Kopieren unterbinden. -->
    <Target Name="BundleWwwrootIntoSingleFile"
            BeforeTargets="_ComputeFilesToBundle"
            DependsOnTargets="$(CopyStaticWebAssetsToPublishDirectoryDependsOn);_SplitPublishStaticWebAssetsByCopyOptions"
            Condition="'$(PublishSingleFile)' == 'true'">
      <ItemGroup>
        <ResolvedFileToPublish Include="@(_PublishStaticWebAssetsTargetPath)"
                               RelativePath="%(_PublishStaticWebAssetsTargetPath.TargetPath)"
                               CopyToPublishDirectory="PreserveNewest"
                               ExcludeFromSingleFile="false" />
        <_PublishStaticWebAssetsCopyAlways Remove="@(_PublishStaticWebAssetsCopyAlways)" />
        <_PublishStaticWebAssetsPreserveNewest Remove="@(_PublishStaticWebAssetsPreserveNewest)" />
      </ItemGroup>
    </Target>


</Project>
