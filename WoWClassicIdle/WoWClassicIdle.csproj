<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
        <AllowMissingPrunePackageData>true</AllowMissingPrunePackageData>
        <!-- App-Version – Fallback für Debug-Builds. Publish setzt Version via CI (-p:Version=X.Y.Z). -->
        <Version>0.0.1</Version>
    </PropertyGroup>

    <!-- Debug-Tools (Klassen-Simulation) nur im Debug-Build ausliefern -->
    <ItemGroup Condition="'$(Configuration)' != 'Debug'">
      <Compile Remove="Components\Debug\**" />
      <Content Remove="Components\Pages\Debug\**" />
      <RazorComponent Remove="Components\Pages\Debug\**" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include="Components\Services\" />
      <Folder Include="wwwroot\css\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Photino.NET" Version="4.0.16" />
    </ItemGroup>


</Project>
